{
  "name": "planwell-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "verify": "pnpm build && pnpm test && pnpm verify:calculators && pnpm verify:n8n",
    "verify:quick": "pnpm exec astro check && pnpm test",
    "verify:calculators": "node scripts/verify-calculators.mjs",
    "verify:mailchimp": "node scripts/verify-mailchimp-send.mjs",
    "verify:n8n": "node scripts/verify-n8n-health.mjs",
    "verify:webhook": "node scripts/verify-webhook-roundtrip.mjs",
    "verify:zoom": "node scripts/verify-zoom-webinar.mjs",
    "audit:perf": "lighthouse http://localhost:4321 --output json --output-path .verify/lighthouse.json --chrome-flags=--headless --quiet",
    "audit:a11y": "axe http://localhost:4321 --save .verify/axe.json --exit",
    "audit:links": "linkinator http://localhost:4321 --recurse --skip 'mailto:|tel:'"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^9.0.4",
    "@portabletext/react": "^6.0.0",
    "@sanity/client": "^7.13.2",
    "@vercel/analytics": "^2.0.1",
    "astro": "^5.16.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.0",
    "fast-check": "^4.8.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
