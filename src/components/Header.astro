---
import { Image } from 'astro:assets';
import logo from '../assets/images/planwell-logo.png';

interface NavLink {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}

const navLinks: NavLink[] = [
  {
    label: 'About',
    href: '/about',
    children: [
      { label: 'About PlanWell', href: '/about' },
      { label: 'Our Credentials', href: '/about/our-credentials' },
      { label: 'Financial Blueprint', href: '/about/financial-blueprint' },
    ]
  },
  { label: 'Services', href: '/services' },
  { label: 'Webinars', href: '/webinars' },
  { label: 'Learning Center', href: '/blog' },
  { label: 'Calculators', href: '/calculators' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="nav__logo">
        <Image src={logo} alt="PlanWell Financial Planning" width={560} height={320} format="webp" quality={90} loading="eager" />
      </a>

      <button class="nav__toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span class="nav__toggle-bar"></span>
        <span class="nav__toggle-bar"></span>
        <span class="nav__toggle-bar"></span>
      </button>

      <div class="nav__menu">
        <ul class="nav__links">
          {navLinks.map(link => (
            <li class={link.children ? 'nav__item--has-dropdown' : ''}>
              {link.children ? (
                <>
                  <button
                    class={`nav__link nav__link--dropdown ${currentPath.startsWith('/about') ? 'nav__link--active' : ''}`}
                    aria-expanded="false"
                    aria-haspopup="true"
                  >
                    {link.label}
                    <svg class="nav__dropdown-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </button>
                  <ul class="nav__dropdown">
                    {link.children.map(child => (
                      <li>
                        <a
                          href={child.href}
                          class={`nav__dropdown-link ${currentPath === child.href ? 'nav__dropdown-link--active' : ''}`}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  href={link.href}
                  class={`nav__link ${currentPath === link.href ? 'nav__link--active' : ''}`}
                >
                  {link.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: var(--color-white);
    box-shadow: var(--shadow-sm);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    gap: var(--space-4);
  }

  .nav__logo {
    flex-shrink: 0;
    margin-left: -20px;
  }

  .nav__logo img {
    height: 300px !important;
    max-width: none !important;
    width: auto !important;
    margin: -100px 0;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
  }

  .nav__toggle-bar {
    width: 24px;
    height: 2px;
    background-color: var(--color-navy);
    transition: all var(--transition-fast);
  }

  .nav__menu {
    display: flex;
    align-items: center;
  }

  .nav__links {
    display: flex;
    list-style: none;
    gap: var(--space-4);
    align-items: center;
  }

  .nav__links > li {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav__link {
    font-weight: var(--font-medium);
    color: var(--color-gray-700);
    padding: var(--space-2) 0;
    position: relative;
    transition: color var(--transition-fast);
    white-space: nowrap;
    font-size: var(--text-sm);
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .nav__link--dropdown {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-gold);
    transition: width var(--transition-base);
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--color-navy);
  }

  .nav__link:hover::after,
  .nav__link--active::after {
    width: 100%;
  }

  /* Dropdown Icon */
  .nav__dropdown-icon {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav__item--has-dropdown:hover .nav__dropdown-icon,
  .nav__item--has-dropdown.is-open .nav__dropdown-icon {
    transform: rotate(180deg);
  }

  /* Dropdown Menu */
  .nav__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 200px;
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-gray-200);
    padding: var(--space-2) 0;
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-fast);
    z-index: var(--z-dropdown);
    list-style: none;
    margin-top: var(--space-2);
  }

  .nav__item--has-dropdown:hover .nav__dropdown {
    opacity: 1;
    visibility: visible;
  }

  .nav__dropdown-link {
    display: block;
    padding: var(--space-3) var(--space-5);
    color: var(--color-gray-700);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .nav__dropdown-link:hover {
    background-color: var(--color-gray-100);
    color: var(--color-navy);
  }

  .nav__dropdown-link--active {
    color: var(--color-navy);
    background-color: var(--color-gray-100);
  }

  /* Large Desktop - more spacing */
  @media (min-width: 1280px) {
    .nav__links {
      gap: var(--space-6);
    }
    .nav__link {
      font-size: var(--text-base);
    }
    .nav__logo img {
      height: 340px !important;
      margin: -110px 0;
    }
  }

  /* Tablet - reduce logo size */
  @media (max-width: 1024px) {
    .nav__logo img {
      height: 220px !important;
      margin: -70px 0;
    }
  }

  /* Mobile - critical size reduction */
  @media (max-width: 640px) {
    .nav__logo {
      margin-left: -10px; /* Reduce negative margin by half */
    }

    .nav__logo img {
      height: 170px !important;
      max-width: 320px !important;
      margin: -50px 0;
    }
  }

  /* Extra small mobile - ensure no overflow */
  @media (max-width: 375px) {
    .nav__logo {
      margin-left: 0; /* Remove negative margin entirely */
    }

    .nav__logo img {
      height: 150px !important;
      max-width: 270px !important;
      margin: -38px 0;
    }
  }

  /* Mobile Menu */
  @media (max-width: 1024px) {
    .nav__toggle {
      display: flex;
    }

    .nav__menu {
      position: fixed;
      top: 80px;
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      justify-content: flex-start;
      padding: var(--space-8);
      background-color: var(--color-white);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all var(--transition-base);
      overflow-y: auto;
    }

    .nav__menu.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav__links {
      flex-direction: column;
      width: 100%;
      gap: var(--space-2);
    }

    .nav__links > li {
      position: static;
    }

    .nav__link {
      display: block;
      padding: var(--space-3) 0;
      font-size: var(--text-lg);
      width: 100%;
      text-align: left;
    }

    .nav__link--dropdown {
      display: flex;
      justify-content: space-between;
    }

    /* Mobile Dropdown */
    .nav__dropdown {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      background: var(--color-gray-100);
      border-radius: var(--radius-md);
      margin-top: var(--space-2);
      padding: var(--space-2);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition-base);
    }

    .nav__item--has-dropdown.is-open .nav__dropdown {
      max-height: 300px;
      opacity: 1;
      visibility: visible;
    }

    /* Don't show dropdown on hover for mobile */
    .nav__item--has-dropdown:hover .nav__dropdown {
      opacity: 0;
      visibility: hidden;
      max-height: 0;
    }

    .nav__item--has-dropdown.is-open:hover .nav__dropdown {
      opacity: 1;
      visibility: visible;
      max-height: 300px;
    }

    .nav__dropdown-link {
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-base);
      border-radius: var(--radius-sm);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav__toggle');
  const menu = document.querySelector('.nav__menu');
  const dropdownItems = document.querySelectorAll('.nav__item--has-dropdown');

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Dropdown toggle for mobile
  dropdownItems.forEach(item => {
    const dropdownBtn = item.querySelector('.nav__link--dropdown');

    dropdownBtn?.addEventListener('click', (e) => {
      // Only handle click toggle on mobile
      if (window.innerWidth <= 1024) {
        e.preventDefault();

        // Close other dropdowns
        dropdownItems.forEach(otherItem => {
          if (otherItem !== item) {
            otherItem.classList.remove('is-open');
            const otherBtn = otherItem.querySelector('.nav__link--dropdown');
            otherBtn?.setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle current dropdown
        const isOpen = item.classList.toggle('is-open');
        dropdownBtn.setAttribute('aria-expanded', String(isOpen));
      }
    });
  });

  // Close menu when clicking a regular link (not dropdown button)
  document.querySelectorAll('.nav__link:not(.nav__link--dropdown), .nav__dropdown-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      dropdownItems.forEach(item => {
        item.classList.remove('is-open');
        const btn = item.querySelector('.nav__link--dropdown');
        btn?.setAttribute('aria-expanded', 'false');
      });
    });
  });

  // Close dropdown when clicking outside (desktop)
  document.addEventListener('click', (e) => {
    if (window.innerWidth > 1024) {
      dropdownItems.forEach(item => {
        if (!item.contains(e.target as Node)) {
          item.classList.remove('is-open');
        }
      });
    }
  });
</script>
