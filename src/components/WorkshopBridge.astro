---
/**
 * WorkshopBridge
 *
 * Small navy card rendered directly under a calculator result (or the main
 * content of a reference page) that bridges "I have one number" to "get the
 * whole FERS picture" at the free workshop. One component, one slug prop, so
 * every placement reports the same GA4 event shape: calc_cta_click {calculator}.
 */
import { getNextWebinar, formatWebinarDate } from '../data/webinars';

interface Props {
  /** Short calculator identifier, e.g. tsp, fers, supplement, high3, sickleave, holidays */
  slug: string;
}

const { slug } = Astro.props;
const next = getNextWebinar();
const nextDate = next ? formatWebinarDate(next) : null;
const href = `/webinar?src=calc-${slug}`;
---

<aside class="workshop-bridge" data-workshop-bridge={slug} aria-labelledby={`workshop-bridge-title-${slug}`}>
  <div class="workshop-bridge__text">
    <h3 class="workshop-bridge__title" id={`workshop-bridge-title-${slug}`}>Want your full FERS number, not just this piece?</h3>
    <p class="workshop-bridge__body">
      Our free three-hour FERS Retirement Workshop walks through pension, TSP, survivor benefit and FEHB timing live, with time for your questions.
      {nextDate && <> Next date: <strong>{nextDate}</strong></>}
    </p>
  </div>
  <a href={href} class="workshop-bridge__btn" data-workshop-bridge-cta data-calculator={slug}>
    Save my seat
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </a>
</aside>

<style>
  .workshop-bridge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 2rem;
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    background: #000d3e;
    color: #ffffff;
    border-radius: 12px;
    border-left: 5px solid #d1a437;
    box-shadow: 0 10px 30px rgba(0, 13, 62, 0.18);
  }

  .workshop-bridge__text {
    flex: 1 1 320px;
    min-width: 0;
  }

  .workshop-bridge__title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    margin: 0 0 0.5rem;
  }

  .workshop-bridge__body {
    font-size: 1rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }

  .workshop-bridge__body strong {
    color: #e6c25e;
    font-weight: 600;
  }

  .workshop-bridge__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex: 0 0 auto;
    background: #d1a437;
    color: #000d3e;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.875rem 1.5rem;
    min-height: 48px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .workshop-bridge__btn:hover {
    background: #e6c25e;
    transform: translateY(-1px);
  }

  .workshop-bridge__btn:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .workshop-bridge {
      flex-direction: column;
      align-items: stretch;
    }
    .workshop-bridge__btn {
      width: 100%;
    }
  }

  @media print {
    .workshop-bridge { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-workshop-bridge-cta]').forEach((el) => {
    el.addEventListener('click', () => {
      const calculator = el.getAttribute('data-calculator') || 'unknown';
      const w = window as unknown as { gtag?: (...args: unknown[]) => void };
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'calc_cta_click', { calculator });
      }
    });
  });
</script>
