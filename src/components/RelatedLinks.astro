---
interface LinkItem {
  href: string;
  title: string;
  description?: string;
}

interface Props {
  heading?: string;
  links: LinkItem[];
  variant?: 'grid' | 'list';
}

const { heading = 'Related Resources', links, variant = 'grid' } = Astro.props;
---

<section class="section">
  <div class="container">
    <h2 class="heading-lg text-center mb-8">{heading}</h2>
    <div class={`related-${variant}`}>
      {links.map((link) => (
        <a href={link.href} class="related-card">
          <h3 class="related-card__title">{link.title}</h3>
          {link.description && <p class="related-card__desc">{link.description}</p>}
          <span class="related-card__arrow">Read more</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); max-width: 1100px; margin: 0 auto; }
  .related-list { display: flex; flex-direction: column; gap: var(--space-4); max-width: 800px; margin: 0 auto; }
  .related-card { display: block; background: var(--color-gray-100); padding: var(--space-6); border-radius: var(--radius-lg); text-decoration: none; transition: all var(--transition-base); border: 1px solid transparent; }
  .related-card:hover { border-color: var(--color-gold); background: var(--color-white); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .related-card__title { color: var(--color-navy); font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .related-card__desc { color: var(--color-gray-600); font-size: var(--text-sm); margin-bottom: var(--space-4); line-height: 1.6; }
  .related-card__arrow { color: var(--color-gold); font-weight: var(--font-semibold); font-size: var(--text-sm); }
  .related-card__arrow::after { content: ' \2192'; }
  @media (max-width: 1024px) { .related-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .related-grid { grid-template-columns: 1fr; } }
</style>
