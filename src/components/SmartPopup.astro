---
// Smart Popup - Context-aware, exit-intent triggered
// Replaces the fixed-timer NewsletterPopup with intelligent triggering
//
// Trigger hierarchy:
//   1. Exit-intent (desktop: mouse leaves viewport top)
//   2. Scroll depth 60%+ (mobile fallback)
//   3. Post-calculator interaction (calculator pages)
//
// Frequency: 1 dismissal = suppressed 14 days
// Suppression: Won't show if user already converted (webinar reg or newsletter)
//
// Variants:
//   A (default): Webinar registration — homepage, services, about, locations
//   B: Calculator follow-up — after using a calculator
//   C: Content-specific — blog posts matched by category

interface Props {
  variant?: 'webinar' | 'calculator' | 'blog';
  blogCategory?: string;
  webinarDate?: string;
}

const { variant = 'webinar', blogCategory = '', webinarDate = '' } = Astro.props;

// Determine headline and copy based on variant
const variants = {
  webinar: {
    icon: 'calendar',
    headline: 'Your FERS Questions — Answered Free',
    description: `Join our next 3-hour retirement workshop${webinarDate ? ` on ${webinarDate}` : ''}. 10,000+ federal employees have attended. Zero cost. Zero pressure.`,
    cta: 'Save My Seat',
    privacy: "We'll send your Zoom link and a reminder. That's it.",
    source: 'smart_popup_webinar',
    action: '/webinar'
  },
  calculator: {
    icon: 'chart',
    headline: 'Want the Full Picture?',
    description: 'Online calculators give you estimates. Our 22-page personalized benefits report gives you exact numbers for YOUR situation. Free after our workshop.',
    cta: 'Register for Free Workshop',
    privacy: 'Join 10,000+ feds who got their exact retirement numbers.',
    source: 'smart_popup_calculator',
    action: '/webinar'
  },
  blog: {
    icon: 'download',
    headline: getBlogHeadline(blogCategory),
    description: getBlogDescription(blogCategory),
    cta: getBlogCTA(blogCategory),
    privacy: 'One email with your download. Unsubscribe anytime.',
    source: `smart_popup_blog_${blogCategory || 'default'}`,
    action: ''
  }
};

function getBlogHeadline(cat: string): string {
  const map: Record<string, string> = {
    'tsp': 'Your TSP Allocation — Simplified',
    'fers': 'Are You Eligible to Retire?',
    'health': "FEHB + Medicare: Don't Overpay",
    'tax': 'Federal Retirement Tax Savings',
    'pay': 'Maximize Your Federal Pay & Benefits',
  };
  return map[cat] || 'Your FERS Questions — Answered Free';
}

function getBlogDescription(cat: string): string {
  const map: Record<string, string> = {
    'tsp': 'Get our 1-page TSP fund allocation guide based on your years to retirement. Used by 3,000+ federal employees.',
    'fers': 'Quick-check your FERS retirement eligibility. MRA+30, 60/20, and 62/5 — all in one printable sheet.',
    'health': 'Our coordination checklist shows you exactly what to do at 65. The wrong timing costs federal retirees $2,000+/year.',
    'tax': 'Our worksheet maps out Roth conversion windows, bracket management, and withdrawal sequencing for federal retirees.',
    'pay': 'Understand how your GS pay, locality adjustments, and step increases affect your retirement calculations.',
  };
  return map[cat] || `Join our next 3-hour retirement workshop. 10,000+ federal employees have attended. Zero cost. Zero pressure.`;
}

function getBlogCTA(cat: string): string {
  const map: Record<string, string> = {
    'tsp': 'Send Me the Guide',
    'fers': 'Get the Eligibility Checker',
    'health': 'Get the Checklist',
    'tax': 'Get the Worksheet',
    'pay': 'Get the Pay Guide',
  };
  return map[cat] || 'Save My Seat';
}

const current = variants[variant] || variants.webinar;
const isWebinarVariant = variant === 'webinar' || variant === 'calculator' || (!blogCategory);
---

<div id="smart-popup" class="smart-popup" style="display: none;" data-variant={variant} data-source={current.source}>
  <div class="smart-popup__overlay"></div>
  <div class="smart-popup__modal">
    <button class="smart-popup__close" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <div class="smart-popup__content" id="popup-content">
      <!-- Gold accent bar -->
      <div class="smart-popup__accent"></div>

      {current.icon === 'calendar' && (
        <div class="smart-popup__icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
      )}
      {current.icon === 'chart' && (
        <div class="smart-popup__icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
      )}
      {current.icon === 'download' && (
        <div class="smart-popup__icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </div>
      )}

      <h2 class="smart-popup__title">{current.headline}</h2>
      <p class="smart-popup__description">{current.description}</p>

      {isWebinarVariant ? (
        <!-- Webinar variant: link directly to registration -->
        <a href="/webinar" class="smart-popup__cta" id="popup-cta">
          {current.cta}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      ) : (
        <!-- Blog variant: email capture for lead magnet -->
        <form class="smart-popup__form" id="popup-form">
          <div class="smart-popup__input-row">
            <input
              type="email"
              name="email"
              placeholder="Your email address"
              class="smart-popup__input"
              required
              autocomplete="email"
            />
            <button type="submit" class="smart-popup__submit">
              {current.cta}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </form>
      )}

      <p class="smart-popup__privacy">{current.privacy}</p>
    </div>

    <!-- Success State -->
    <div class="smart-popup__success" id="popup-success" style="display: none;">
      <div class="smart-popup__accent"></div>
      <div class="smart-popup__success-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>
        </svg>
      </div>
      <h2 class="smart-popup__title">Check Your Email!</h2>
      <p class="smart-popup__description">
        We've sent your download. Check your inbox (and spam folder) in the next few minutes.
      </p>
      <button class="smart-popup__cta" id="popup-success-close">Got It</button>
    </div>
  </div>
</div>

<style>
  .smart-popup {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 9999;
    animation: spFadeIn 0.25s ease;
  }

  @keyframes spFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .smart-popup__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 13, 62, 0.5);
    backdrop-filter: blur(3px);
  }

  .smart-popup__modal {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
    max-width: 440px;
    width: calc(100% - 2rem);
    overflow: hidden;
    animation: spSlideUp 0.3s ease;
  }

  @keyframes spSlideUp {
    from { opacity: 0; transform: translate(-50%, -46%); }
    to { opacity: 1; transform: translate(-50%, -50%); }
  }

  .smart-popup__accent {
    height: 4px;
    background: linear-gradient(90deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
  }

  .smart-popup__close {
    position: absolute;
    top: 0.75rem; right: 0.75rem;
    background: none;
    border: none;
    color: var(--color-gray-400);
    cursor: pointer;
    padding: 0.375rem;
    display: flex;
    border-radius: var(--radius-sm);
    transition: all 0.15s;
    z-index: 1;
  }
  .smart-popup__close:hover {
    background: var(--color-gray-100);
    color: var(--color-gray-700);
  }

  .smart-popup__content,
  .smart-popup__success {
    padding: 2rem 2rem 1.5rem;
    text-align: center;
  }

  .smart-popup__icon {
    width: 56px; height: 56px;
    margin: 0 auto 1rem;
    background: var(--color-navy);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold);
  }

  .smart-popup__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .smart-popup__description {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 360px;
    margin-left: auto;
    margin-right: auto;
  }

  /* CTA button (webinar/calculator variant) */
  a.smart-popup__cta,
  button.smart-popup__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    font-family: inherit;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
    color: var(--color-navy);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    width: 100%;
  }
  a.smart-popup__cta:hover,
  button.smart-popup__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(209, 164, 55, 0.35);
  }

  /* Form (blog variant) */
  .smart-popup__form {
    width: 100%;
  }
  .smart-popup__input-row {
    display: flex;
    gap: 0.5rem;
  }
  .smart-popup__input {
    flex: 1;
    padding: 0.875rem 1rem;
    font-size: var(--text-sm);
    font-family: inherit;
    border: 2px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    transition: border-color 0.15s;
    min-width: 0;
  }
  .smart-popup__input:focus {
    outline: none;
    border-color: var(--color-navy);
  }
  .smart-popup__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.875rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    font-family: inherit;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
    color: var(--color-navy);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .smart-popup__submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(209, 164, 55, 0.3);
  }

  .smart-popup__privacy {
    font-size: 0.75rem;
    color: var(--color-gray-400);
    margin-top: 0.75rem;
  }

  /* Success */
  .smart-popup__success-icon {
    width: 64px; height: 64px;
    margin: 0 auto 1rem;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-navy);
  }

  /* Mobile */
  @media (max-width: 640px) {
    .smart-popup__content,
    .smart-popup__success { padding: 1.5rem 1.25rem 1.25rem; }
    .smart-popup__title { font-size: var(--text-lg); }
    .smart-popup__input-row { flex-direction: column; }
    .smart-popup__icon { width: 48px; height: 48px; }
    .smart-popup__icon svg { width: 24px; height: 24px; }
  }
</style>

<script define:vars={{ source: current.source }}>
  // ====== SMART POPUP ENGINE ======
  const STORAGE_KEY = 'smart_popup_dismissed';
  const CONVERTED_KEY = 'planwell_converted';
  const COOLDOWN_DAYS = 14;
  const SCROLL_THRESHOLD = 0.6; // 60% scroll
  const API_ENDPOINT = 'https://pleasant-vision-production.up.railway.app/api/newsletter';

  let popupShown = false;
  let exitIntentFired = false;

  // ---- State Checks ----
  function isDismissed() {
    try {
      const dismissed = localStorage.getItem(STORAGE_KEY);
      if (!dismissed) return false;
      const dismissedDate = new Date(dismissed);
      const daysSince = (Date.now() - dismissedDate.getTime()) / (1000 * 60 * 60 * 24);
      return daysSince < COOLDOWN_DAYS;
    } catch { return false; }
  }

  function hasConverted() {
    try { return localStorage.getItem(CONVERTED_KEY) === 'true'; } catch { return false; }
  }

  function isSuppressionPage() {
    const path = window.location.pathname;
    return ['/webinar', '/book-call', '/privacy', '/terms'].some(p => path.startsWith(p));
  }

  function shouldShow() {
    return !popupShown && !isDismissed() && !hasConverted() && !isSuppressionPage();
  }

  // ---- Show / Hide ----
  function showPopup() {
    if (!shouldShow()) return;
    const popup = document.getElementById('smart-popup');
    if (!popup) return;
    popup.style.display = 'block';
    document.body.style.overflow = 'hidden';
    popupShown = true;

    if (typeof gtag === 'function') {
      gtag('event', 'popup_shown', {
        event_category: 'engagement',
        event_label: source
      });
    }
  }

  function hidePopup() {
    const popup = document.getElementById('smart-popup');
    if (!popup) return;
    popup.style.display = 'none';
    document.body.style.overflow = '';
    try { localStorage.setItem(STORAGE_KEY, new Date().toISOString()); } catch {}
  }

  function showSuccess() {
    const content = document.getElementById('popup-content');
    const success = document.getElementById('popup-success');
    if (content && success) {
      content.style.display = 'none';
      success.style.display = 'block';
    }
    try { localStorage.setItem(CONVERTED_KEY, 'true'); } catch {}
  }

  // ---- Triggers ----

  // Exit intent (desktop): mouse leaves top of viewport
  function initExitIntent() {
    let triggered = false;
    document.addEventListener('mouseout', (e) => {
      if (triggered || popupShown) return;
      if (e.clientY <= 0 && e.relatedTarget === null) {
        triggered = true;
        showPopup();
      }
    });
  }

  // Scroll depth (mobile fallback)
  function initScrollTrigger() {
    let triggered = false;
    window.addEventListener('scroll', () => {
      if (triggered || popupShown) return;
      const scrollPercent = window.scrollY / (document.body.scrollHeight - window.innerHeight);
      if (scrollPercent >= SCROLL_THRESHOLD) {
        triggered = true;
        // Small delay so it doesn't feel jarring mid-scroll
        setTimeout(() => showPopup(), 500);
      }
    }, { passive: true });
  }

  // ---- Form Handler (blog variant) ----
  async function handleSubmit(e) {
    e.preventDefault();
    const form = e.target;
    const email = new FormData(form).get('email');

    try {
      await fetch(API_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          source: source,
          timestamp: new Date().toISOString()
        })
      });
    } catch (err) {
      console.error('Popup submit error:', err);
    }

    if (typeof gtag === 'function') {
      gtag('event', 'popup_conversion', {
        event_category: 'conversion',
        event_label: source
      });
    }

    showSuccess();
  }

  // ---- CTA Click Handler (webinar variant) ----
  function handleCTAClick() {
    try { localStorage.setItem(CONVERTED_KEY, 'true'); } catch {}
    if (typeof gtag === 'function') {
      gtag('event', 'popup_conversion', {
        event_category: 'conversion',
        event_label: source
      });
    }
  }

  // ---- Init ----
  function init() {
    if (!shouldShow()) return;

    // Close handlers
    document.querySelector('.smart-popup__close')?.addEventListener('click', hidePopup);
    document.querySelector('.smart-popup__overlay')?.addEventListener('click', hidePopup);
    document.getElementById('popup-success-close')?.addEventListener('click', hidePopup);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hidePopup(); });

    // Form handler (blog variant)
    document.getElementById('popup-form')?.addEventListener('submit', handleSubmit);

    // CTA click handler (webinar variant)
    document.getElementById('popup-cta')?.addEventListener('click', handleCTAClick);

    // External trigger button (for "Get Our Newsletter" button on homepage)
    document.getElementById('newsletter-trigger')?.addEventListener('click', () => {
      popupShown = false; // Allow re-show from manual trigger
      showPopup();
    });

    // Start triggers
    initExitIntent();
    initScrollTrigger();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
