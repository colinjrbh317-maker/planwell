  </style>

  <script is:inline>
    // Configuration - Webinar registration webhook (Zoom auto-registration via Railway)
    const WEBINAR_WEBHOOK_URL = 'https://pleasant-vision-production.up.railway.app/api/webinar';

    // Attribution source. On the plain /webinar path this is unchanged (default
    // behavior preserved). On /webinar/li (the LinkedIn-attributed mirror, served
    // via Astro.rewrite so the page content is identical) we suffix the source so
    // LinkedIn-driven registrations are tagged distinctly in Mailchimp and can be
    // counted separately. An optional ?v=A..D marks the A/B/C/D message variant,
    // giving per-variant registration attribution (e.g. fers_webinar_optin_li_a).
    let _attrSuffix = '';
    if (window.location.pathname.replace(/\/+$/, '').endsWith('/webinar/li')) {
      const _v = (new URLSearchParams(window.location.search).get('v') || '')
        .toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 8);
      _attrSuffix = '_li' + (_v ? '_' + _v : '');
    }
    const REG_SOURCE = 'webinar_registration' + _attrSuffix;
    const OPTIN_SOURCE = 'fers_webinar_optin' + _attrSuffix;

    // Get webinar data from data attributes
    const webinarDataEl = document.getElementById('webinar-data');
    const webinarData = webinarDataEl ? {
      id: webinarDataEl.dataset.id,
      date: webinarDataEl.dataset.date,
      title: webinarDataEl.dataset.title,
      startTime: webinarDataEl.dataset.startTime,
      endTime: webinarDataEl.dataset.endTime,
      timezone: webinarDataEl.dataset.timezone
    } : {};
    
    let currentStep = 0;
    const totalSteps = 4; // intro + 3 questions (fullName, email, phone)
    const formData = {};

    // Prefill email from URL params (e.g., ?email=user@example.com)
    const urlParams = new URLSearchParams(window.location.search);
    const prefillEmail = urlParams.get('email');
    if (prefillEmail) {
      formData.email = prefillEmail;
      // Set the email input value once it's rendered
      setTimeout(() => {
        const emailInput = document.getElementById('email');
        if (emailInput) emailInput.value = prefillEmail;
      }, 100);
    }
    
    function updateProgress() {
      const progress = (currentStep / totalSteps) * 100;
      document.getElementById('progress-fill').style.width = progress + '%';
    }
    
    function showStep(stepNum) {
      document.querySelectorAll('.step').forEach(step => {
        step.classList.remove('step--active');
      });
      const targetStep = document.querySelector('[data-step="' + stepNum + '"]');
      if (targetStep) {
        targetStep.classList.add('step--active');
        // Focus input if exists
        const input = targetStep.querySelector('input');
        if (input) setTimeout(() => input.focus(), 100);
      }
      updateProgress();
    }
    
    async function submitToWebhook(data, retries = 2) {
      const payload = {
        ...data,
        webinar_id: webinarData.id,
        webinar_date: webinarData.date,
        webinar_type: 'fers',
        submitted_at: new Date().toISOString(),
        source: REG_SOURCE
      };

      for (let attempt = 0; attempt <= retries; attempt++) {
        try {
          const response = await fetch(WEBINAR_WEBHOOK_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (response.ok) {
            const result = await response.json();
            console.log('Webinar registration submitted:', result);
            if (result.zoom_registered) {
              return { success: true, zoomRegistered: true };
            }
            // Webhook responded but Zoom registration failed
            console.warn('Webhook OK but Zoom registration failed:', result);
            return { success: true, zoomRegistered: false };
          }
          console.warn(`Webhook attempt ${attempt + 1} failed: ${response.status}`);
        } catch (error) {
          console.warn(`Webhook attempt ${attempt + 1} error:`, error.message);
        }
      }
      // All retries exhausted
      console.error('All webhook attempts failed');
      return { success: false, zoomRegistered: false };
    }
    
    function nextStep() {
      // Validate current step if it has input
      const currentStepEl = document.querySelector('[data-step="' + currentStep + '"]');
      const input = currentStepEl?.querySelector('input');
      // Phone field (step 4) is optional — allow empty
      const isOptional = input && input.name === 'phone';
      if (input && !input.value.trim() && !isOptional) {
        input.focus();
        input.style.borderColor = '#dc3545';
        return;
      }
      if (input) {
        formData[input.name] = input.value;
        input.style.borderColor = '';
      }
      
      currentStep++;
      showStep(currentStep);
      
      // If we're on the success step, submit the form
      if (currentStep === totalSteps) {
        // Split fullName into firstName/lastName for backend compatibility
        const nameParts = (formData.fullName || '').trim().split(/\s+/);
        const submitData = {
          firstName: nameParts[0] || '',
          lastName: nameParts.slice(1).join(' ') || '',
          email: formData.email || '',
          phone: formData.phone || ''
        };
        console.log('Webinar registration submitted:', submitData);
        submitToWebhook(submitData).then(function(result) {
          if (!result.success) {
            // Show a subtle warning on the success screen
            var warn = document.createElement('p');
            warn.style.cssText = 'color: #ffa500; font-size: 0.9rem; margin-top: 1rem;';
            warn.textContent = 'Note: There was a connection issue. You may not have received a confirmation email. Please check your inbox, and if you don\'t see one within a few minutes, try registering again.';
            var successContent = document.querySelector('.step-content--success');
            if (successContent) successContent.appendChild(warn);
          }
        });

        // GA4 + FB conversion events
        if (typeof gtag === 'function') {
          gtag('event', 'webinar_registration', {
            event_category: 'conversion',
            event_label: 'fers_webinar',
            webinar_type: 'fers'
          });
        }
        if (typeof fbq === 'function') {
          fbq('track', 'CompleteRegistration', { content_name: 'FERS Webinar' });
        }

        // Newsletter opt-in (checked by default; fires unless the user unchecks the box)
        const newsletterCheckbox = document.getElementById('newsletter-optin');
        if (newsletterCheckbox && newsletterCheckbox.checked && formData.email) {
          if (typeof gtag === 'function') {
            gtag('event', 'newsletter_signup', {
              event_category: 'conversion',
              event_label: 'fers_webinar_newsletter'
            });
          }
          fetch('https://pleasant-vision-production.up.railway.app/api/newsletter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: formData.fullName || '',
              email: formData.email,
              source: OPTIN_SOURCE,
              timestamp: new Date().toISOString()
            })
          }).catch(function(err) { console.error('Newsletter signup error:', err); });
        }
      }
    }
    
    function prevStep() {
      if (currentStep > 0) {
        currentStep--;
        showStep(currentStep);
      }
    }
    
    function handleEnter(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        nextStep();
      }
    }
    
    function downloadCalendar() {
      if (!webinarData.date) return;
      
      var date = new Date(webinarData.date);
      var endDate = new Date(date.getTime() + 3 * 60 * 60 * 1000);
      
      function formatICSDate(d) {
        return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
      }
      
      var lines = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//PlanWell//Webinar//EN',
        'BEGIN:VEVENT',
        'UID:' + String(webinarData.id) + '@planwellfp.com',
        'DTSTAMP:' + formatICSDate(new Date()),
        'DTSTART:' + formatICSDate(date),
        'DTEND:' + formatICSDate(endDate),
        'SUMMARY:' + String(webinarData.title) + ' - PlanWell Financial Planning',
        'DESCRIPTION:Free 3-hour FERS retirement workshop.',
        'LOCATION:Online (Zoom link will be emailed)',
        'STATUS:CONFIRMED',
        'END:VEVENT',
        'END:VCALENDAR'
      ];
      var icsContent = lines.join('\r\n');
      
      var blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
      var link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'fers-workshop-' + String(webinarData.id) + '.ics';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
    
    // Initialize
    updateProgress();
  </script>
