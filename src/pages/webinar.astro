---
import { getNextWebinar, formatWebinarDate, getDaysUntil, generateICS } from '../data/webinars';

// Render per-request so the "next webinar" computation always uses the
// current date. Otherwise Astro builds this page once at deploy time;
// once that build's "next webinar" passes, the page silently goes stale
// until the next deploy. Surfaced 2026-05-25: live page was still
// rendering the May 22 webinar three days after it had passed because
// no rebuild had triggered. Switching to SSR closes the staleness window.
export const prerender = false;

// Get the next upcoming webinar (evaluated per-request)
const nextWebinar = getNextWebinar();
const webinarDate = nextWebinar ? formatWebinarDate(nextWebinar) : 'Coming Soon';
const daysUntil = nextWebinar ? getDaysUntil(nextWebinar) : 0;
const webinarTime = nextWebinar ? `${nextWebinar.startTime} – ${nextWebinar.endTime} ${nextWebinar.timezone}` : '';
const webinarId = nextWebinar?.id || '';

// Form fields: full name, email, phone (optional)
const steps = [
  { id: 1, question: "What's your full name?", field: "fullName", type: "text", placeholder: "Full name" },
  { id: 2, question: "Where should we send the details?", field: "email", type: "email", placeholder: "your.email@example.com" },
  { id: 3, question: "Phone number?", field: "phone", type: "tel", placeholder: "(optional)", required: false },
];

// Evergreen, keyword-dense title and description (session date appears in body copy, not title)
const pageTitle = "Free FERS Retirement Workshop for Federal Employees | PlanWell";
const pageDescription = "Join our free 3-hour FERS retirement workshop led by a CFP. Learn your pension, TSP strategy, FEHB, Medicare, and survivor benefits. Next session: " + webinarDate + ".";
const pageUrl = "https://planwellfp.com/webinar";

// Event JSON-LD schema for rich results eligibility
const eventSchema = nextWebinar ? {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Free FERS Retirement Workshop",
  "description": "Three-hour live workshop for federal employees covering FERS pension, TSP, FEHB, Medicare, and survivor benefits. Led by Certified Financial Planners who are Chartered Federal Employee Benefits Consultants.",
  "startDate": nextWebinar.date.toISOString(),
  "endDate": new Date(nextWebinar.date.getTime() + 3 * 60 * 60 * 1000).toISOString(),
  "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "VirtualLocation",
    "url": pageUrl,
    "name": "Online via Zoom"
  },
  "image": ["https://planwellfp.com/og-default.png"],
  "organizer": {
    "@type": "Organization",
    "name": "PlanWell Financial Planning",
    "url": "https://planwellfp.com"
  },
  "performer": [
    { "@type": "Person", "name": "David Fei", "jobTitle": "CFP, ChFEBC, AIF" },
    { "@type": "Person", "name": "Brennan Rhule", "jobTitle": "CFP, ChFEBC, AIF" }
  ],
  "offers": {
    "@type": "Offer",
    "name": "Free Workshop Registration",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "validFrom": new Date().toISOString(),
    "url": pageUrl
  },
  "inLanguage": "en-US",
  "isAccessibleForFree": true,
  "audience": {
    "@type": "Audience",
    "audienceType": "Federal Employees"
  }
} : null;

// FAQPage JSON-LD schema for PAA and AI Overview capture
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is the FERS retirement workshop really free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The workshop is completely free, with no payment, no credit card, and no sales pitch during the session. Our goal is to educate federal employees on FERS, TSP, and federal benefits so you can make better retirement decisions."
      }
    },
    {
      "@type": "Question",
      "name": "Who leads the FERS workshop?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "David Fei, CFP and Chartered Federal Employee Benefits Consultant, leads the instruction. Brennan Rhule, CFP and ChFEBC, handles live Q&A during the session. Both are co-founders of PlanWell Financial Planning and specialize exclusively in federal retirement."
      }
    },
    {
      "@type": "Question",
      "name": "Is the workshop recorded so I can watch later?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, we do not record the workshop. The value of the live format is the real-time Q&A where your specific federal retirement questions get answered. If you miss a session, we run a new workshop every three weeks and you can register for the next one."
      }
    },
    {
      "@type": "Question",
      "name": "What will I learn at the workshop?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You will learn how to calculate your exact FERS pension, choose the right survivor benefit election, coordinate FEHB with Medicare without gaps, build a tax-efficient TSP withdrawal strategy, and identify optimization opportunities that federal HR typically does not cover."
      }
    },
    {
      "@type": "Question",
      "name": "Who is the workshop for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Any federal employee under FERS, regardless of agency or years of service. Whether you are five years away or five months away from retirement, the session covers the foundational decisions every federal employee needs to get right."
      }
    },
    {
      "@type": "Question",
      "name": "Will I be pressured to become a client afterward?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. After the workshop you will receive planning worksheets and the option to schedule a one-on-one consultation if you want one. There is no obligation and no pressure. Many attendees use the education alone to plan their retirement without ever becoming clients."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={pageUrl} />

  <!-- Event schema for Google rich results -->
  {eventSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  )}

  <!-- FAQ schema for People Also Ask and AI Overview capture -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:site_name" content="PlanWell Financial Planning" />
  <meta property="og:image" content="https://planwellfp.com/og-default.png" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content="https://planwellfp.com/og-default.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MRSSJQ5B');
  </script>
  <!-- Google Analytics 4 -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9GCLL7ZVM8');
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9GCLL7ZVM8"></script>
  <!-- Facebook Pixel -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1247069313769384');
    fbq('track', 'PageView');
  </script>
</head>
<body>
  <div class="funnel">
    <!-- Header removed: logo band was consuming ~20% above the fold.
         Offer now starts immediately. -->

    <!-- Progress Bar -->
    <div class="progress-bar">
      <div class="progress-fill" id="progress-fill"></div>
    </div>
    
    <!-- Content Area -->
    <main class="funnel-content">
      <!-- Intro Step -->
      <div class="step step--active" data-step="0">
        <div class="step-content">
          <!-- Urgency Badge -->
          <div class="urgency-badge">
            <svg class="urgency-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            <span>
              {daysUntil <= 1 ? 'Tomorrow!' : 'In ' + daysUntil + ' days'}
              <span class="urgency-spots">• Free online workshop</span>
            </span>
          </div>
          
          <h1 class="step-eyebrow-h1">Free FERS Retirement Workshop for Federal Employees</h1>
          <p class="step-session-date">
            Next live session: <strong>{webinarDate}</strong>
            <span class="step-session-date__time">{webinarTime}</span>
          </p>
          <p class="step-description">
            Join our 3-hour virtual workshop led by a team of Chartered Federal Employee Benefits Consultants.
            We cover your FERS pension, TSP strategy, FEHB, Medicare, and survivor benefits,
            then answer your questions live.
          </p>
          <ul class="step-benefits">
            <li>
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
              <span>Complete FERS breakdown</span>
            </li>
            <li>
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
              <span>Live Q&A with ChFEBC experts</span>
            </li>
            <li>
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
              <span>100% free, no obligation</span>
            </li>
          </ul>

          <button type="button" class="btn-next btn-next--large btn-cta-primary" onclick="nextStep()">
            Reserve My Free Seat
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <p class="step-trust">Free. No sales pitch. Just education.</p>

          <div class="presenter-info">
            <div class="presenter-info__item">
              <img src="/images/authors/david-fei.jpg" alt="David Fei" class="presenter-info__photo" loading="lazy" />
              <div class="presenter-info__text">
                <span class="presenter-info__name"><strong>David Fei</strong>, CFP®, ChFEBC℠, AIF®</span>
                <span class="presenter-info__role">Lead Instructor</span>
              </div>
            </div>
            <div class="presenter-info__item">
              <img src="/images/authors/brennan-rhule.jpg" alt="Brennan Rhule" class="presenter-info__photo" loading="lazy" />
              <div class="presenter-info__text">
                <span class="presenter-info__name"><strong>Brennan Rhule</strong>, CFP®, ChFEBC℠, AIF®</span>
                <span class="presenter-info__role">Live Q&amp;A in chat</span>
              </div>
            </div>
          </div>

          <!-- Learning Goals -->
          <div class="learning-goals">
            <h3 class="section-subheading">By the end of this workshop, you'll be able to:</h3>
            <ul class="goals-list">
              <li>Calculate your exact FERS pension down to the dollar</li>
              <li>Choose the right survivor benefit election for your family</li>
              <li>Coordinate FEHB and Medicare without gaps or overpaying</li>
              <li>Create a tax-efficient TSP withdrawal strategy</li>
              <li>Identify optimization opportunities HR never mentions</li>
            </ul>
          </div>

          <!-- Topic Breakdown -->
          <div class="topic-breakdown">
            <h3 class="section-subheading">What You'll Learn <span class="duration">(3 hours)</span></h3>

            <div class="module-grid">
              <div class="module-card">
                <div class="module-number">1</div>
                <h4>FERS Pension Fundamentals</h4>
                <ul>
                  <li>Calculating your exact pension amount</li>
                  <li>Understanding the High-3 salary calculation</li>
                  <li>MRA, eligibility rules, and special provisions</li>
                  <li>Deferred vs immediate retirement</li>
                </ul>
              </div>

              <div class="module-card">
                <div class="module-number">2</div>
                <h4>TSP Strategy & Withdrawals</h4>
                <ul>
                  <li>Traditional vs Roth TSP contributions</li>
                  <li>Fund allocation strategies (C, S, I, F, G)</li>
                  <li>Withdrawal options and tax implications</li>
                  <li>Required Minimum Distributions (RMDs)</li>
                </ul>
              </div>

              <div class="module-card">
                <div class="module-number">3</div>
                <h4>Healthcare in Retirement</h4>
                <ul>
                  <li>FEHB coverage continuation rules</li>
                  <li>Medicare Parts A, B, D coordination</li>
                  <li>When to enroll and avoid penalties</li>
                  <li>IRMAA and income-driven premiums</li>
                </ul>
              </div>

              <div class="module-card">
                <div class="module-number">4</div>
                <h4>Survivor Benefits & Estate Planning</h4>
                <ul>
                  <li>Survivor Benefit Plan (SBP) cost vs value</li>
                  <li>Full vs partial vs zero election</li>
                  <li>Life insurance (FEGLI) in retirement</li>
                  <li>Beneficiary designations</li>
                </ul>
              </div>

              <div class="module-card module-card--qa">
                <div class="module-number">5</div>
                <h4>Live Q&A <span class="duration-inline">(30 minutes)</span></h4>
                <ul>
                  <li>Your specific questions answered</li>
                  <li>Real scenarios from federal employees</li>
                  <li>Planning strategies from CFP® advisors</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- How This Works -->
          <div class="how-it-works">
            <h3 class="section-subheading">What to Expect</h3>

            <div class="expectation-grid">
              <div class="expectation-phase">
                <div class="phase-label">Before the Workshop</div>
                <ul>
                  <li>You'll receive a Zoom link via email</li>
                  <li>No preparation needed, just come with questions</li>
                  <li>Works on computer, tablet, or phone</li>
                </ul>
              </div>

              <div class="expectation-phase">
                <div class="phase-label">During the Session</div>
                <ul>
                  <li>Live presentation with screen sharing</li>
                  <li>Real examples and case studies</li>
                  <li>Brennan is on live chat throughout for Q&A</li>
                  <li>If your work laptop blocks Zoom, join from your personal phone or tablet</li>
                  <li>This session is not recorded, the value is the live Q&A</li>
                </ul>
              </div>

              <div class="expectation-phase">
                <div class="phase-label">After the Workshop</div>
                <ul>
                  <li>Access to downloadable planning worksheets</li>
                  <li>Optional: Schedule 1-on-1 consultation</li>
                  <li>No pressure, no sales pitch, just education</li>
                </ul>
              </div>
            </div>
          </div>

          <button type="button" class="btn-next btn-next--large" onclick="nextStep()">
            Reserve My Free Seat
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <p class="step-trust">Free. No sales pitch. Just education.</p>
        </div>
      </div>
      
      <!-- Dynamic Form Steps -->
      {steps.map((step, index) => (
        <div class="step" data-step={index + 1}>
          <div class="step-content">
            <span class="step-counter">Step {index + 1} of {steps.length}</span>
            <h2 class="step-question">{step.question}</h2>

            <div class="input-wrapper">
              <input
                type={step.type}
                id={step.field}
                name={step.field}
                class="funnel-input"
                placeholder={step.placeholder}
                required={step.required !== false}
                onkeydown="handleEnter(event)"
                autocomplete={step.field === 'email' ? 'email' : step.field === 'fullName' ? 'name' : step.field === 'phone' ? 'tel' : 'off'}
              />
              {index === steps.length - 1 && (
                <label class="newsletter-optin">
                  <input type="checkbox" id="newsletter-optin" checked />
                  <span>Sign me up for the PlanWell newsletter</span>
                </label>
              )}
              <button type="button" class="btn-next" onclick="nextStep()">
                {index === steps.length - 1 ? 'Complete Registration' : 'Continue'}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </div>

            <button type="button" class="btn-back" onclick="prevStep()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Back
            </button>
          </div>
        </div>
      ))}
      
      <!-- Success Step -->
      <div class="step" data-step={steps.length + 1}>
        <div class="step-content step-content--success">
          <div class="success-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <path d="M22 4L12 14.01l-3-3"/>
            </svg>
          </div>
          <h2 class="step-title">You're Registered!</h2>
          <p class="step-description success-date">
            See you on <strong>{webinarDate}</strong> at <strong>{webinarTime}</strong>
          </p>
          <p class="step-description">
            Check your inbox for the Zoom link and details. 
            We'll send a reminder before the session.
          </p>
          
          <!-- Calendar Download -->
          <div class="calendar-actions">
            <button type="button" class="btn-calendar" onclick="downloadCalendar()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              Add to Calendar
            </button>
          </div>
          
        </div>
      </div>
    </main>
  </div>

  <!-- Hidden data for JavaScript -->
  <div 
    id="webinar-data" 
    style="display:none"
    data-id={webinarId}
    data-date={nextWebinar?.date.toISOString()}
    data-title={nextWebinar?.title}
    data-start-time={nextWebinar?.startTime}
    data-end-time={nextWebinar?.endTime}
    data-timezone={nextWebinar?.timezone}
  ></div>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #000d3e;
      min-height: 100vh;
      color: #fff;
    }
    
    .funnel {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    
    .progress-bar {
      height: 4px;
      background: rgba(255,255,255,0.1);
    }
    
    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #d1a437 0%, #e6c25e 100%);
      transition: width 0.4s ease;
    }
    
    .funnel-content {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 1.5rem 2rem 2rem;
    }
    
    .step {
      display: none;
      width: 100%;
      max-width: 600px;
      animation: fadeIn 0.4s ease;
    }
    
    .step--active {
      display: block;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .step-content {
      text-align: center;
    }
    
    /* Urgency Badge */
    .urgency-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(201, 165, 92, 0.15);
      border: 1px solid rgba(201, 165, 92, 0.4);
      color: #e6c25e;
      padding: 0.5rem 1rem;
      border-radius: 2rem;
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.8; }
    }
    
    .urgency-icon {
      width: 16px;
      height: 16px;
    }
    
    .urgency-spots {
      color: rgba(255,255,255,0.7);
      font-weight: 500;
    }
    
    .step-eyebrow {
      display: inline-block;
      font-size: 0.875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #d1a437;
      margin-bottom: 0.5rem;
    }

    .step-eyebrow-h1 {
      display: block;
      font-family: 'Outfit', sans-serif;
      font-size: clamp(1.875rem, 4.5vw, 2.75rem);
      font-weight: 700;
      line-height: 1.2;
      color: #ffffff;
      margin: 1rem auto 0.75rem;
      letter-spacing: -0.01em;
      max-width: 680px;
    }

    .step-session-date {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: center;
      gap: 0.5rem 0.75rem;
      font-size: 1rem;
      font-weight: 500;
      color: rgba(255,255,255,0.8);
      margin: 0 0 1.5rem 0;
    }

    .step-session-date strong {
      color: #e6c25e;
      font-weight: 600;
    }

    .step-session-date__time {
      font-size: 0.9375rem;
      color: rgba(255,255,255,0.55);
      font-weight: 400;
      position: relative;
      padding-left: 0.875rem;
    }

    .step-session-date__time::before {
      content: "•";
      position: absolute;
      left: 0;
      color: rgba(255,255,255,0.35);
    }

    @media (max-width: 480px) {
      .step-session-date__time {
        padding-left: 0;
      }
      .step-session-date__time::before {
        display: none;
      }
    }

    .step-counter {
      display: block;
      font-size: 0.875rem;
      color: rgba(255,255,255,0.5);
      margin-bottom: 0.5rem;
    }

    .step-title {
      font-family: 'Outfit', sans-serif;
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: 0.5rem;
    }
    
    .step-time {
      display: block;
      font-size: clamp(1.25rem, 3vw, 1.5rem);
      font-weight: 500;
      color: rgba(255,255,255,0.7);
      margin-top: 0.25rem;
    }
    
    .step-question {
      font-family: 'Outfit', sans-serif;
