---
// planwellfp.com/li-tracking — LinkedIn webinar campaign scoreboard.
// SSR, reads registration counts straight from Mailchimp (the fers_webinar_optin_li_*
// tags the /webinar/li page writes), so it works from anywhere with no local
// dependency. Counts only, no PII. Noindexed — private ops page, not marketing.
export const prerender = false;

const KEY = process.env.MAILCHIMP_API_KEY || '';
const LIST = process.env.MAILCHIMP_LIST_ID || '';
const DC = (KEY.split('-').pop()) || 'us21';
const PREFIX = 'fers_webinar_optin_li';
const VARIANTS = ['A', 'B', 'C', 'D'];

let total = 0;
const byVariant: Record<string, number> = { A: 0, B: 0, C: 0, D: 0 };
let error = '';
const updated = new Date();

if (KEY && LIST) {
  try {
    let offset = 0;
    const count = 1000;
    while (true) {
      const url = `https://${DC}.api.mailchimp.com/3.0/lists/${LIST}/members?count=${count}&offset=${offset}&fields=total_items,members.tags`;
      const res = await fetch(url, {
        headers: { Authorization: 'Basic ' + Buffer.from('anystring:' + KEY).toString('base64') },
      });
      if (!res.ok) { error = 'mailchimp ' + res.status; break; }
      const data = await res.json();
      const members = data.members || [];
      if (!members.length) break;
      for (const m of members) {
        const li = (m.tags || []).map((t: any) => t.name).filter((n: string) => n && n.startsWith(PREFIX));
        if (!li.length) continue;
        total++;
        for (const t of li) {
          const suf = t.slice(PREFIX.length).replace(/^_/, '').toUpperCase();
          if (byVariant[suf] !== undefined) byVariant[suf]++;
        }
      }
      offset += count;
      if (offset >= (data.total_items || 0)) break;
    }
  } catch (e) {
    error = String(e);
  }
} else {
  error = 'mailchimp env not configured';
}

const fmt = updated.toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta http-equiv="refresh" content="60" />
  <title>LinkedIn Webinar Tracking · PlanWell</title>
  <style>
    :root{--bg:#0b1020;--card:#151b30;--line:#26304f;--txt:#e8ecf6;--mut:#8b96b5;--accent:#4f8cff;--good:#34d399}
    *{box-sizing:border-box}
    body{margin:0;font:15px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--txt)}
    .wrap{max-width:560px;margin:0 auto;padding:26px 18px}
    h1{font-size:18px;font-weight:700;margin:0 0 2px}
    h1 span{color:var(--accent)}
    .sub{color:var(--mut);font-size:12px;margin-bottom:20px}
    .hero{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;text-align:center;margin-bottom:16px}
    .hero .k{color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.6px}
    .hero .v{font-size:52px;font-weight:800;color:var(--good);margin-top:4px;line-height:1}
    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
    .card .k{color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.6px}
    .card .v{font-size:30px;font-weight:700;margin-top:4px}
    .card .var{display:inline-block;background:#15294a;color:#7fb0ff;border-radius:6px;padding:1px 8px;font-size:12px;font-weight:600}
    .foot{color:var(--mut);font-size:12px;margin-top:20px;text-align:center}
    .err{background:#3a1717;border:1px solid #5b2222;color:#f8a5a5;border-radius:10px;padding:10px 14px;font-size:13px;margin-bottom:16px}
  </style>
</head>
<body>
  <div class="wrap">
    <h1>PlanWell <span>LinkedIn</span> Webinar</h1>
    <div class="sub">Registrations attributed to the LinkedIn A/B/C/D campaign · updated {fmt} ET</div>
    {error && <div class="err">Couldn't reach Mailchimp ({error}). Retrying on next refresh.</div>}
    <div class="hero">
      <div class="k">Total registrations</div>
      <div class="v">{total}</div>
    </div>
    <div class="grid">
      {VARIANTS.map((v) => (
        <div class="card">
          <div class="k"><span class="var">Variant {v}</span></div>
          <div class="v">{byVariant[v] || 0}</div>
        </div>
      ))}
    </div>
    <div class="foot">Auto-refreshes every 60s. Counts registrations tagged from planwellfp.com/webinar/li.<br />Private page — don't share.</div>
  </div>
</body>
</html>
