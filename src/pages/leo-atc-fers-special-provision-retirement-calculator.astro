---
import BaseLayout from '../layouts/BaseLayout.astro';
import LEOCalculatorSEOContent from '../components/calculators/LEOCalculatorSEOContent.astro';
import CalculatorDisclosure from '../components/calculators/CalculatorDisclosure.astro';
import CalculatorWebinarCTA from '../components/calculators/CalculatorWebinarCTA.astro';
import SmartPopup from '../components/SmartPopup.astro';
---

<BaseLayout
  title="FERS Special Provision Retirement Calculator | LEO, ATC, Firefighter"
  description="Free retirement calculator for federal Law Enforcement Officers, Air Traffic Controllers, and Firefighters under FERS special provision. Calculate your enhanced pension, supplement, and mandatory retirement age."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Special Provision Tools</span>
      <h1 class="heading-xl">FERS Special Provision Calculator</h1>
      <p class="lead max-w-3xl">
        Estimate your enhanced FERS annuity for Law Enforcement, Air Traffic Control, and Firefighter service.
      </p>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container">
      <div class="calculator">
        <div class="calculator__header">
          <h2 class="heading-md">Calculate Your Enhanced Benefit</h2>
          <p>Special Category employees receive 1.7% for the first 20 years, and 1.0% for all years thereafter.</p>
        </div>

        <div class="calculator__grid">
          <div class="calculator__form">
            <div class="form-group">
              <label class="form-label" for="sp-high3">High-3 Average Salary ($)</label>
              <div class="input-wrapper">
                <span class="input-prefix">$</span>
                <input type="number" id="sp-high3" class="form-input" placeholder="e.g., 120000" value="120000" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="sp-start-date">Retirement Service Computation Date (RSCD)</label>
              <input type="date" id="sp-start-date" class="form-input" />
              <span class="form-hint">When you began your covered special provision service.</span>
            </div>

            <div class="form-group">
              <label class="form-label" for="sp-retirement-date">Planned Retirement Date</label>
              <input type="date" id="sp-retirement-date" class="form-input" />
              <span class="form-hint">The date you plan to retire.</span>
            </div>

            <div class="calculated-values">
              <div class="calculated-item">
                <span class="calculated-label">Years of Service:</span>
                <span class="calculated-value" id="sp-calc-years">--</span>
              </div>
            </div>

            <button type="button" class="btn btn--primary btn--lg" style="width: 100%;" onclick="calculateSpecialProvision()">
              Calculate Special Provision Pension
            </button>
          </div>

          <div class="calculator__result" id="sp-result">
            <div class="result-card">
              <span class="result-label">Estimated Annual Pension</span>
              <span class="result-value" id="sp-annual">$46,800</span>
            </div>
            <div class="result-card">
              <span class="result-label">Estimated Monthly Pension</span>
              <span class="result-value" id="sp-monthly">$3,900</span>
            </div>
            <div class="result-card result-card--highlight">
              <span class="result-label">Replacement Rate</span>
              <span class="result-value" id="sp-replacement">39.0%</span>
            </div>
          </div>
        </div>

        <div class="calculator__note">
          <h3 class="font-bold text-navy mb-2">How It's Calculated</h3>
          <ul class="list-disc pl-5 mb-4 space-y-2">
            <li><strong>First 20 Years:</strong> Calculated at <strong>1.7%</strong> per year (34% total).</li>
            <li><strong>Years 20+:</strong> Calculated at <strong>1.0%</strong> per year.</li>
          </ul>
          <p class="text-sm">Example: A LEO with 25 years works out to: (20 x 1.7%) + (5 x 1.0%) = 39% of High-3.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--navy text-center">
    <div class="container">
      <div data-animate="fade-in-up">
        <h2 class="heading-lg">Complex Rules? We Can Help.</h2>
        <p class="lead" style="color: var(--color-gray-300); max-width: 36rem; margin: 0 auto var(--space-8);">
          Special Provision retirement has unique rules for FERS Supplement, Social Security, and TSP withdrawals.
          Don't leave money on the table.
        </p>
        <div class="flex justify-center gap-4" style="flex-wrap: wrap;">
          <a href="/webinar" class="btn btn--white btn--lg">Get a Special Provision Audit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Post-result webinar CTA -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <CalculatorWebinarCTA calculatorName="leo" source="calc_leo" />
    </div>
  </section>

  <!-- SEO-Optimized Content -->
  <LEOCalculatorSEOContent />
  <CalculatorDisclosure />
  <SmartPopup variant="calculator" />
</BaseLayout>

<style>
  /* Sharing same styles as other calculators for consistency */
  .page-hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
    padding: var(--space-20) 0 var(--space-16);
    text-align: center;
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .page-hero .lead {
    color: var(--color-gray-300);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gold);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .calculator {
    max-width: 1000px;
    margin: 0 auto;
  }

  .calculator__header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .calculator__header p {
    color: var(--color-gray-600);
    margin-top: var(--space-2);
    font-size: var(--text-lg);
  }

  .calculator__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    background: var(--color-white);
    padding: var(--space-10);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
  }

  .form-group {
    margin-bottom: var(--space-6);
  }

  .input-wrapper {
    position: relative;
  }

  .input-prefix {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-gray-500);
    font-weight: var(--font-medium);
  }

  .form-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    padding-left: var(--space-4);
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    transition: border-color var(--transition-fast);
  }

  .input-wrapper .form-input {
    padding-left: var(--space-8);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-navy);
    box-shadow: 0 0 0 3px rgba(10, 37, 64, 0.1);
  }

  .form-hint {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    margin-top: var(--space-2);
  }

  .calculator__result {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--color-gray-50);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-200);
  }

  .result-card {
    background: var(--color-white);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    box-shadow: var(--shadow-sm);
  }

  .result-card--highlight {
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
    color: var(--color-navy-dark);
  }

  .result-label {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    font-weight: var(--font-medium);
  }

  .result-card--highlight .result-label {
    color: var(--color-navy-dark);
    opacity: 0.8;
  }

  .result-value {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
  }

  .result-card--highlight .result-value {
    color: var(--color-navy-dark);
  }

  .calculator__note {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background: rgba(46, 139, 87, 0.1); /* Slight green tint for variety or stick to gold */
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-accent); /* Using generic accent or hardcoded green */
    border-color: #2e8b57;
  }

  .calculator__note h3 {
    color: var(--color-navy);
  }

  .calculator__note p, .calculator__note li {
    font-size: var(--text-sm);
    color: var(--color-gray-700);
    line-height: 1.6;
  }

  .calculated-values {
    background: var(--color-gray-100);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    display: flex;
    gap: var(--space-6);
  }

  .calculated-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .calculated-label {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    font-weight: var(--font-medium);
  }

  .calculated-value {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-navy);
  }

  @media (max-width: 768px) {
    .calculator__grid {
      grid-template-columns: 1fr;
      padding: var(--space-6);
    }

    .calculated-values {
      flex-direction: column;
      gap: var(--space-3);
    }
  }
</style>

<script is:inline>
  function formatCurrency(num) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0
    }).format(num);
  }

  function calculateYearsOfService(startDate, endDate) {
    const diffTime = endDate.getTime() - startDate.getTime();
    const diffDays = diffTime / (1000 * 60 * 60 * 24);
    const years = diffDays / 365.25;
    return Math.round(years * 2) / 2; // Round to nearest 0.5
  }

  function updateCalculatedYears() {
    const startDateInput = document.getElementById('sp-start-date').value;
    const retirementDateInput = document.getElementById('sp-retirement-date').value;

    if (startDateInput && retirementDateInput) {
      const startDate = new Date(startDateInput);
      const retirementDate = new Date(retirementDateInput);
      const years = calculateYearsOfService(startDate, retirementDate);
      document.getElementById('sp-calc-years').textContent = years + ' years';
      return years;
    } else {
      document.getElementById('sp-calc-years').textContent = '--';
      return null;
    }
  }

  function calculateSpecialProvision() {
    const high3 = parseFloat(document.getElementById('sp-high3').value) || 0;
    const years = updateCalculatedYears();

    if (years === null) {
      document.getElementById('sp-annual').textContent = '--';
      document.getElementById('sp-monthly').textContent = '--';
      document.getElementById('sp-replacement').textContent = '--';
      return;
    }

    // Gate: minimum 20 years of special provision service required
    if (years < 20) {
      document.getElementById('sp-annual').textContent = '- -';
      document.getElementById('sp-monthly').textContent = '- -';
      document.getElementById('sp-replacement').textContent = '- -';
      return;
    }

    let replacementFactor = 0;

    if (years <= 20) {
      // Exactly 20 years: 1.7% for all years
      replacementFactor = years * 0.017;
    } else {
      // 20 years @ 1.7% + remaining @ 1.0%
      replacementFactor = (20 * 0.017) + ((years - 20) * 0.01);
    }

    const annualPension = high3 * replacementFactor;
    const monthlyPension = annualPension / 12;

    document.getElementById('sp-annual').textContent = formatCurrency(annualPension);
    document.getElementById('sp-monthly').textContent = formatCurrency(monthlyPension);
    document.getElementById('sp-replacement').textContent = (replacementFactor * 100).toFixed(1) + '%';
  }

  // Set default dates and add event listeners
  document.addEventListener('DOMContentLoaded', function() {
    const today = new Date();

    // Set default start date (25 years ago)
    const defaultStartDate = new Date(today.getFullYear() - 25, today.getMonth(), today.getDate());
    document.getElementById('sp-start-date').value = defaultStartDate.toISOString().split('T')[0];

    // Set default retirement date (today)
    document.getElementById('sp-retirement-date').value = today.toISOString().split('T')[0];

    // Add event listeners for real-time updates
    document.getElementById('sp-start-date').addEventListener('change', calculateSpecialProvision);
    document.getElementById('sp-retirement-date').addEventListener('change', calculateSpecialProvision);
    document.getElementById('sp-high3').addEventListener('input', calculateSpecialProvision);

    // Run initial calculation
    calculateSpecialProvision();
  });
</script>
