---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WebinarCTA from '../../components/WebinarCTA.astro';
import { decisionGuides } from '../../data/decision-guides';
---

<BaseLayout
  title="FERS Retirement Decision Guides | PlanWell"
  description="Step-by-step decision guides for federal employees: MRA+10 vs MRA+30, VERA and VSIP, survivor benefits, FEHB to Medicare, and more. Real numbers, real scenarios."
  canonical="/guides"
>
  <section class="hub-hero">
    <div class="container">
      <span class="eyebrow">Decision Guides</span>
      <h1 class="heading-xl">FERS Retirement Decision Guides</h1>
      <p class="lead">Federal retirement is full of irrevocable choices. These guides give you the framework, the math, and the scenarios you need to make each one confidently.</p>
      <WebinarCTA variant="hero" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">All decision guides</h2>
      <div class="guide-grid">
        {decisionGuides.map((g) => (
          <a href={`/guides/${g.slug}`} class="guide-tile">
            <span class="guide-tile__eyebrow">{g.heroEyebrow}</span>
            <h3 class="guide-tile__name">{g.title}</h3>
            <p class="guide-tile__desc">{g.tldr.slice(0, 160)}{g.tldr.length > 160 ? '...' : ''}</p>
            <span class="guide-tile__cta">Read guide</span>
          </a>
        ))}
      </div>
      <p class="text-center mt-8 hub-note">
        Have a retirement question not covered here? <a href="/federal-retirement-webinars" class="hub-note__link">Attend a free workshop</a> and get answers from our CFP and ChFEBC advisors.
      </p>
    </div>
  </section>

  <WebinarCTA variant="banner" heading="Free 3-hour FERS retirement workshop" subheading="Walk through every major retirement decision with experts who work exclusively with federal employees." />
</BaseLayout>

<style>
  .hub-hero {
    padding: var(--space-16) 0;
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
  }
  .hub-hero h1 { color: var(--color-white); margin-bottom: var(--space-4); }
  .hub-hero .lead { color: var(--color-gray-300); margin-bottom: var(--space-8); max-width: 820px; }
  .hub-hero .eyebrow { color: var(--color-gold); }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .guide-tile {
    display: block;
    background: var(--color-gray-100);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
    border: 1px solid transparent;
  }
  .guide-tile:hover {
    border-color: var(--color-gold);
    background: var(--color-white);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .guide-tile__eyebrow {
    display: block;
    color: var(--color-gold);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
    font-weight: var(--font-semibold);
  }
  .guide-tile__name {
    color: var(--color-navy);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
    line-height: 1.4;
  }
  .guide-tile__desc {
    color: var(--color-gray-700);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  .guide-tile__cta {
    color: var(--color-gold);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
  }
  .guide-tile__cta::after { content: ' \2192'; }

  .hub-note {
    color: var(--color-gray-600);
    font-size: var(--text-sm);
  }
  .hub-note__link {
    color: var(--color-gold);
    text-decoration: underline;
  }

  @media (max-width: 1024px) { .guide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .guide-grid { grid-template-columns: 1fr; } }
</style>
