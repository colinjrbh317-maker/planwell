---
import BaseLayout from '../layouts/BaseLayout.astro';

// Placeholder testimonials — replace with real client reviews as they come in
const testimonials = [
  {
    name: "Workshop Attendee",
    role: "Federal Employee, GS-13",
    agency: "Department of Defense",
    quote: "The FERS workshop was incredibly thorough. David explained things about my pension that my HR office never could. I finally understand my survivor benefit options and feel confident about my retirement timeline.",
    rating: 5,
    service: "Free FERS Workshop",
    date: "2025-12"
  },
  {
    name: "Benefits Report Client",
    role: "Federal Employee, GS-14",
    agency: "Department of Homeland Security",
    quote: "The 22-page benefits report was a game-changer. Seeing my exact pension calculation with different retirement dates helped me realize I could retire two years earlier than I thought. The TSP withdrawal strategy alone was worth it.",
    rating: 5,
    service: "Federal Benefits Report",
    date: "2025-11"
  },
  {
    name: "Financial Planning Client",
    role: "Retired Federal Employee",
    agency: "Department of Veterans Affairs",
    quote: "Working with Brennan on my retirement plan gave me complete peace of mind. He coordinated my FEHB with Medicare, optimized my TSP withdrawals for tax efficiency, and helped me understand exactly how much I can spend in retirement.",
    rating: 5,
    service: "Comprehensive Financial Planning",
    date: "2025-10"
  },
];

// AggregateRating schema
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "FinancialService",
  "@id": "https://planwellfp.com/#organization",
  "name": "PlanWell Financial Planning",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": String(testimonials.length),
    "reviewCount": String(testimonials.length)
  },
  "review": testimonials.map(t => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": t.name
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": String(t.rating),
      "bestRating": "5"
    },
    "reviewBody": t.quote,
    "datePublished": t.date
  }))
};
---

<BaseLayout
  title="Client Testimonials - Federal Employee Reviews"
  description="Read what federal employees say about PlanWell's FERS workshops, benefits reports, and retirement planning services. Real reviews from real federal workers."
>
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Client Stories</span>
      <h1 class="heading-xl">What Federal Employees Say</h1>
      <p class="lead max-w-3xl">
        Real feedback from federal employees who attended our workshops, received benefits reports, and worked with our financial planners.
      </p>
    </div>
  </section>

  <!-- Testimonials Grid -->
  <section class="section">
    <div class="container">
      <div class="testimonials-grid">
        {testimonials.map((t) => (
          <div class="testimonial-card">
            <div class="testimonial-card__rating">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="star" viewBox="0 0 20 20" fill="currentColor" width="20" height="20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="testimonial-card__quote">
              "{t.quote}"
            </blockquote>
            <div class="testimonial-card__author">
              <div class="testimonial-card__badge">{t.service}</div>
              <p class="testimonial-card__name">{t.name}</p>
              <p class="testimonial-card__role">{t.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section testimonials-cta">
    <div class="container">
      <div class="cta-box">
        <h2>Ready to Experience the PlanWell Difference?</h2>
        <p>Join thousands of federal employees who have taken control of their retirement planning.</p>
        <div class="cta-box__actions">
          <a href="/webinar" class="btn btn--primary">Attend Free Workshop</a>
          <a href="/book-call" class="btn btn--secondary">Schedule a Call</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Review Submission CTA -->
  <section class="section">
    <div class="container" style="text-align: center;">
      <h3>Are You a PlanWell Client?</h3>
      <p style="color: var(--color-gray-600); max-width: 500px; margin: 0 auto var(--space-6);">
        We'd love to hear about your experience. Your feedback helps other federal employees find the guidance they need.
      </p>
      <a href="mailto:david.fei@planwellfp.com?subject=PlanWell%20Testimonial" class="btn btn--secondary">
        Share Your Experience
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-8);
    max-width: 1100px;
    margin: 0 auto;
  }

  .testimonial-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .testimonial-card__rating {
    display: flex;
    gap: 2px;
    margin-bottom: var(--space-4);
  }

  .star {
    color: #f59e0b;
  }

  .testimonial-card__quote {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-gray-700);
    margin-bottom: var(--space-6);
    flex-grow: 1;
    border: none;
    padding: 0;
    font-style: normal;
  }

  .testimonial-card__author {
    border-top: 1px solid var(--color-gray-100);
    padding-top: var(--space-4);
  }

  .testimonial-card__badge {
    display: inline-block;
    background: var(--color-navy);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .testimonial-card__name {
    font-weight: var(--font-semibold);
    color: var(--color-navy);
    font-size: var(--text-base);
  }

  .testimonial-card__role {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
  }

  .cta-box {
    background: linear-gradient(135deg, var(--color-navy) 0%, #1e3a5f 100%);
    color: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-12);
    text-align: center;
  }

  .cta-box h2 {
    color: var(--color-white);
    margin-bottom: var(--space-3);
  }

  .cta-box p {
    opacity: 0.9;
    font-size: var(--text-lg);
    margin-bottom: var(--space-6);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-box__actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .cta-box {
      padding: var(--space-8);
    }
  }
</style>
