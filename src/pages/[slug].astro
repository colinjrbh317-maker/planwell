---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { readdirSync } from 'fs';
import { join } from 'path';

// Build cover image lookup from static files (slug → path)
const coverFiles = readdirSync(join(process.cwd(), 'public/images/blog/covers'));
const coverImageMap = new Map<string, string>();
for (const file of coverFiles) {
  const slug = file.replace(/\.(jpg|jpeg|png|webp)$/i, '');
  coverImageMap.set(slug, `/images/blog/covers/${file}`);
}

// Fetch all posts with full content for static path generation
export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`
    *[_type == "post"] | order(publishedAt desc) {
      _id,
      title,
      "slug": slug.current,
      publishedAt,
      body,
      htmlBody,
      excerpt,
      readTime,
      author->{
        name,
        "slug": slug.current,
        credentials,
        title,
        bioShort,
        bioFull,
        email,
        phone,
        image { asset->{url} }
      },
      category->{
        title,
        "slug": slug.current
      },
      mainImage { asset->{url} }
    }
  `);

  return posts.map(post => {
    const related = posts
      .filter(p => p.category?.title === post.category?.title && p.slug !== post.slug)
      .slice(0, 3);
    return {
      params: { slug: post.slug },
      props: { article: post, relatedArticles: related },
    };
  });
}

const { article, relatedArticles } = Astro.props;
const author = article.author;
const authorImageUrl = author?.image?.asset?.url || `/images/authors/${author?.slug || 'planwell-team'}.jpg`;

// Format ISO date for display (e.g. "February 20, 2026")
function formatDate(isoDate: string): string {
  if (!isoDate) return '';
  try {
    return new Date(isoDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  } catch { return ''; }
}

// Simple Portable Text to HTML converter for new Studio posts
function portableTextToHtml(blocks: any[]): string {
  if (!blocks || !Array.isArray(blocks)) return '';
  let html = '';
  let listOpen = false;
  let listType = '';

  for (const block of blocks) {
    if (block._type === 'block') {
      if (block.listItem) {
        const newListType = block.listItem === 'number' ? 'ol' : 'ul';
        if (!listOpen || listType !== newListType) {
          if (listOpen) html += `</${listType}>`;
          html += `<${newListType}>`;
          listOpen = true;
          listType = newListType;
        }
        html += `<li>${renderChildren(block)}</li>`;
        continue;
      }
      if (listOpen) { html += `</${listType}>`; listOpen = false; }
      const text = renderChildren(block);
      switch (block.style) {
        case 'h1': html += `<h1>${text}</h1>`; break;
        case 'h2': html += `<h2>${text}</h2>`; break;
        case 'h3': html += `<h3>${text}</h3>`; break;
        case 'h4': html += `<h4>${text}</h4>`; break;
        case 'blockquote': html += `<blockquote>${text}</blockquote>`; break;
        default: html += `<p>${text}</p>`;
      }
    } else if (block._type === 'image') {
      if (listOpen) { html += `</${listType}>`; listOpen = false; }
      html += `<img src="${block.asset?.url || ''}" alt="${block.alt || ''}" />`;
    }
  }
  if (listOpen) html += `</${listType}>`;
  return html;
}

function renderChildren(block: any): string {
  if (!block.children) return '';
  return block.children.map((child: any) => {
    let text = (child.text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    if (child.marks) {
      for (const mark of child.marks) {
        if (mark === 'strong') text = `<strong>${text}</strong>`;
        else if (mark === 'em') text = `<em>${text}</em>`;
        else if (mark === 'underline') text = `<u>${text}</u>`;
        else if (mark === 'code') text = `<code>${text}</code>`;
        else {
          const def = block.markDefs?.find((d: any) => d._key === mark);
          if (def?._type === 'link') text = `<a href="${def.href}">${text}</a>`;
        }
      }
    }
    return text;
  }).join('');
}

// Get article content - prefer htmlBody (legacy), fall back to Portable Text body
const articleContent = article.htmlBody || portableTextToHtml(article.body) || '';

const isTSPArticle = article.title?.toLowerCase().includes('tsp') ||
                      article.slug?.toLowerCase().includes('tsp') ||
                      article.title?.toLowerCase().includes('thrift savings');

const displayDate = formatDate(article.publishedAt);
const cleanExcerpt = article.excerpt || articleContent.replace(/<[^>]*>/g, '').slice(0, 155) + '...';
const articleUrl = `https://planwellfp.com/${article.slug}`;
const articleImage = article.mainImage?.asset?.url || coverImageMap.get(article.slug) || '/images/blog/default-cover.jpg';
const fullArticleImage = articleImage.startsWith('http') ? articleImage : `https://planwellfp.com${articleImage}`;

// Article Schema for rich snippets
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": cleanExcerpt,
  "image": fullArticleImage,
  "datePublished": article.publishedAt || new Date().toISOString(),
  "dateModified": article.publishedAt || new Date().toISOString(),
  "author": {
    "@type": "Person",
    "name": author?.name || "PlanWell Team",
    "jobTitle": author?.title || "Financial Planning Team",
    "url": "https://planwellfp.com/about",
    ...(author?.credentials && { "hasCredential": author.credentials.split(', ') })
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://planwellfp.com/#organization",
    "name": "PlanWell Financial Planning",
    "logo": { "@type": "ImageObject", "url": "https://planwellfp.com/images/planwell-logo.png" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": articleUrl },
  "articleSection": article.category?.title || '',
  "wordCount": articleContent.replace(/<[^>]*>/g, '').split(/\s+/).length || 1000,
  "keywords": [
    article.category?.title || '',
    "federal retirement",
    "FERS",
    ...(isTSPArticle ? ["TSP", "Thrift Savings Plan"] : []),
    "federal employee benefits"
  ].join(", ")
};

// BreadcrumbList Schema for navigation
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://planwellfp.com" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://planwellfp.com/blog" },
    { "@type": "ListItem", "position": 3, "name": article.category?.title || 'Blog', "item": `https://planwellfp.com/blog/topic/${(article.category?.slug || '').toLowerCase()}` },
    { "@type": "ListItem", "position": 4, "name": article.title, "item": articleUrl }
  ]
};
---

<BaseLayout
  title={`${article.title} | PlanWell Blog`}
  description={cleanExcerpt}
  ogImage={fullArticleImage}
  ogType="article"
  articleDate={article.publishedAt || ''}
  articleAuthor={author?.name || "PlanWell Team"}
  articleSection={article.category?.title || ''}
>
  <!-- Schema.org structured data for rich snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="article">
    <!-- Article Header -->
    <header class="article__header">
      <div class="container">
        <a href="/blog" class="article__back">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Back to Blog
        </a>

        <h1 class="article__title">{article.title}</h1>

        <div class="article__meta">
          {author && (
            <div class="article__author">
              <img
                src={authorImageUrl}
                alt={author.name}
                class="article__author-image"
                onerror="this.onerror=null; this.src='/images/authors/planwell-logo.png';"
              />
              <div class="article__author-info">
                <span class="article__author-name">
                  {author.name}{author.credentials ? `, ${author.credentials}` : ''}
                </span>
                <span class="article__date">
                  {displayDate} · {article.readTime}
                </span>
              </div>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div class="article__body">
      <div class="container">
        <div class="article__layout">
          <!-- Main Content -->
          <div class="article__main">
            <div class="article__content" set:html={articleContent} />

            <!-- Mid-Article CTA -->
            {isTSPArticle ? (
              <aside class="article__mid-cta article__mid-cta--tsp">
                <h4>Want personalized TSP guidance?</h4>
                <p>Get clarity on your TSP investments, fund allocation, and withdrawal strategies in our free TSP training.</p>
                <a href="/webinar/tsp" class="btn btn--primary">Join Free TSP Workshop</a>
              </aside>
            ) : (
              <aside class="article__mid-cta">
                <h4>Want personalized guidance?</h4>
                <p>Get your specific retirement questions answered in our free FERS workshop.</p>
                <a href="https://planwell.vercel.app/webinars" class="btn btn--primary">Join Free Workshop</a>
              </aside>
            )}
          </div>

          <!-- Sticky Sidebar -->
          <aside class="article__sidebar">
            <div class="sidebar-sticky">
              <!-- Author Card -->
              {author && (
                <div class="sidebar-author">
                  <img
                    src={authorImageUrl}
                    alt={author.name}
                    class="sidebar-author__image"
                    onerror="this.onerror=null; this.src='/images/authors/planwell-logo.png';"
                  />
                  <div class="sidebar-author__info">
                    <p class="sidebar-author__label">Written by</p>
                    <h4 class="sidebar-author__name">{author.name}</h4>
                    {author.credentials && (
                      <p class="sidebar-author__credentials">{author.credentials}</p>
                    )}
                    <p class="sidebar-author__bio">{author.bioShort}</p>
                  </div>
                </div>
              )}

              {isTSPArticle ? (
                <div class="sidebar-cta sidebar-cta--tsp">
                  <h4>Free TSP Workshop</h4>
                  <p>Get clarity on your Thrift Savings Plan investments and withdrawal strategies.</p>
                  <ul class="sidebar-cta__benefits">
                    <li>Traditional vs Roth TSP</li>
                    <li>Fund allocation strategies</li>
                    <li>Withdrawal planning</li>
                  </ul>
                  <a href="/webinar/tsp" class="btn btn--primary btn--block">Join Free TSP Training</a>
                </div>
              ) : (
                <div class="sidebar-cta">
                  <h4>Free FERS Workshop</h4>
                  <p>Get your federal retirement questions answered by certified planners.</p>
                  <ul class="sidebar-cta__benefits">
                    <li>3-hour comprehensive overview</li>
                    <li>Live Q&A session</li>
                    <li>Personalized answers</li>
                  </ul>
                  <a href="https://planwell.vercel.app/webinars" class="btn btn--primary btn--block">Reserve Your Seat</a>
                </div>
              )}

              <div class="sidebar-book">
                <p>Prefer 1-on-1?</p>
                <a href="/book-call" class="btn btn--secondary btn--block btn--sm">Schedule a Call</a>
              </div>
            </div>
          </aside>
        </div>

        <!-- Author Bio -->
        {author && (
          <div class="author-bio">
            <img
              src={authorImageUrl}
              alt={author.name}
              class="author-bio__image"
              onerror="this.onerror=null; this.src='/images/authors/planwell-logo.png';"
            />
            <div class="author-bio__content">
              <h3 class="author-bio__name">About {author.name}</h3>
              <p class="author-bio__credentials">{author.title}{author.credentials ? ` · ${author.credentials}` : ''}</p>
              <p class="author-bio__text">{author.bioFull}</p>
              {author.personalNote && (
                <p class="author-bio__personal">{author.personalNote}</p>
              )}
              {author.email && (
                <div class="author-bio__contact">
                  <a href={`mailto:${author.email}`} class="author-bio__link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    {author.email}
                  </a>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <nav class="related-articles">
            <h3>Related Articles</h3>
            <div class="related-grid">
              {relatedArticles.map(related => (
                  <a href={`/${related.slug}`} class="related-card">
                    <img
                      src={related.mainImage?.asset?.url || coverImageMap.get(related.slug) || '/images/blog/default-cover.jpg'}
                      alt={related.title}
                      class="related-card__image"
                    />
                    <div class="related-card__content">
                      <h4 class="related-card__title">{related.title}</h4>
                      <div class="related-card__meta">
                        <span>{related.author?.name || 'PlanWell Team'}</span>
                      </div>
                    </div>
                  </a>
              ))}
            </div>
          </nav>
        )}

      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Header */
  .article__header {
    background: var(--color-white);
    padding: var(--space-8) 0;
  }

  .article__header .container {
    max-width: 900px;
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-gray-500);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
    transition: color var(--transition-fast);
  }

  .article__back:hover {
    color: var(--color-navy);
  }

  .article__category {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .article__title {
    font-size: var(--text-4xl);
    line-height: 1.2;
    margin-bottom: var(--space-6);
    color: var(--color-navy);
  }

  .article__author {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .article__author-image {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .article__author-name {
    display: block;
    font-weight: var(--font-semibold);
    color: var(--color-navy);
  }

  .article__date {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    margin-top: var(--space-1);
  }

  /* Article Body */
  .article__body {
    padding: var(--space-12) 0;
    background: var(--color-gray-50);
  }

  /* Main Content */
  .article__main {
    background: var(--color-white);
    padding: var(--space-10);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    min-width: 0;
    overflow: hidden;
  }

  .article__content {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-gray-700);
    overflow-wrap: break-word;
    word-wrap: break-word;
    max-width: 100%;
  }

  .article__content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .article__content :global(h1) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    font-size: var(--text-2xl);
    color: var(--color-navy);
    line-height: 1.3;
  }

  .article__content :global(h2) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    font-size: var(--text-2xl);
    color: var(--color-navy);
  }

  .article__content :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
    color: var(--color-navy);
  }

  .article__content :global(p) {
    margin-bottom: var(--space-5);
  }

  .article__content :global(ul),
  .article__content :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }

  .article__content :global(li) {
    margin-bottom: var(--space-2);
  }

  .article__content :global(strong) {
    color: var(--color-navy);
    font-weight: var(--font-semibold);
  }

  .article__content :global(a) {
    color: var(--color-gold);
    text-decoration: underline;
  }

  .article__content :global(a:hover) {
    color: var(--color-navy);
  }

  .article__content :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-5);
    font-size: var(--text-base);
  }

  .article__content :global(th),
  .article__content :global(td) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-gray-200);
    white-space: nowrap;
  }

  .article__content :global(th) {
    background: var(--color-navy);
    color: var(--color-white);
    font-weight: var(--font-semibold);
  }

  .article__content :global(tr:nth-child(even)) {
    background: var(--color-gray-50);
  }

  /* Fix WordPress Elementor SVG icons (render as black circles without Elementor CSS) */
  .article__content :global(.e-font-icon-svg) {
    display: none;
  }

  .article__content :global(.elementor-icon-list-icon) {
    display: none;
  }

  .article__content :global(.elementor-icon-list-item) {
    display: list-item;
    list-style-type: disc;
    margin-left: var(--space-6);
  }

  .article__content :global(.elementor-icon-list-text) {
    display: inline;
  }

  .article__content :global(.elementor-icon-list-items) {
    list-style: none;
    padding: 0;
  }

  /* Layout with Sidebar */
  .article__layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Mid-Article CTA */
  .article__mid-cta {
    background: linear-gradient(135deg, var(--color-navy) 0%, #1e3a5f 100%);
    color: var(--color-white);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    margin-top: var(--space-10);
    text-align: center;
  }

  .article__mid-cta h4 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .article__mid-cta p {
    opacity: 0.9;
    margin-bottom: var(--space-4);
  }

  /* Sticky Sidebar */
  .article__sidebar {
    align-self: start;
  }

  .sidebar-sticky {
    position: sticky;
    top: 100px;
  }

  .sidebar-cta {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
    margin-bottom: var(--space-4);
  }

  .sidebar-cta h4 {
    color: var(--color-navy);
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .sidebar-cta > p {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    margin-bottom: var(--space-4);
  }

  .sidebar-cta__benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
  }

  .sidebar-cta__benefits li {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    padding-left: var(--space-5);
    position: relative;
    margin-bottom: var(--space-2);
  }

  .sidebar-cta__benefits li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-weight: bold;
  }

  .sidebar-book {
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-align: center;
  }

  .sidebar-book p {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    margin-bottom: var(--space-2);
  }

  /* Sidebar Author Card */
  .sidebar-author {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
    box-shadow: var(--shadow-md);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .sidebar-author__image {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: var(--space-3);
    border: 3px solid var(--color-gold);
  }

  /* Fix for Ben Derge's headshot - zoom in to fill circle */
  .sidebar-author__image[alt="Ben Derge"] {
    object-position: center 20%;
    object-fit: cover;
    scale: 1.4;
  }

  .sidebar-author {
    overflow: hidden;
  }

  .sidebar-author__label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-500);
    margin-bottom: var(--space-1);
  }

  .sidebar-author__name {
    font-size: var(--text-base);
    color: var(--color-navy);
    margin-bottom: var(--space-1);
  }

  .sidebar-author__credentials {
    font-size: var(--text-xs);
    color: var(--color-gold);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-2);
  }

  .sidebar-author__bio {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.5;
  }

  /* Author Bio */
  .author-bio {
    display: flex;
    gap: var(--space-6);
    padding: var(--space-8);
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-10);
  }

  .author-bio__image {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-bio__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }

  .author-bio__credentials {
    font-size: var(--text-sm);
    color: var(--color-gold);
    margin-bottom: var(--space-4);
  }

  .author-bio__text {
    color: var(--color-gray-600);
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }

  .author-bio__personal {
    font-style: italic;
    color: var(--color-gray-500);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .author-bio__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

