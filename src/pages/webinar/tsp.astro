        height: 80px;
        width: auto;
        object-fit: contain;
      }

      .funnel-content {
        padding: 1rem;
      }

      .module-grid {
        grid-template-columns: 1fr;
      }

      .module-card--qa {
        grid-column: span 1;
      }

      .expectation-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .section-subheading {
        font-size: 1.25rem;
      }
    }
  </style>

  <script is:inline>
    // Configuration - Webinar registration webhook (Zoom auto-registration via Railway)
    const WEBINAR_WEBHOOK_URL = 'https://pleasant-vision-production.up.railway.app/api/webinar';
    
    // Get webinar data from data attributes
    const webinarDataEl = document.getElementById('webinar-data');
    const webinarData = webinarDataEl ? {
      id: webinarDataEl.dataset.id,
      date: webinarDataEl.dataset.date,
      title: webinarDataEl.dataset.title,
      startTime: webinarDataEl.dataset.startTime,
      endTime: webinarDataEl.dataset.endTime,
      timezone: webinarDataEl.dataset.timezone
    } : {};
    
    let currentStep = 0;
    const totalSteps = 4; // intro + 3 questions
    const formData = {};

    // Prefill email from URL params (e.g., ?email=user@example.com)
    const urlParams = new URLSearchParams(window.location.search);
    const prefillEmail = urlParams.get('email');
    if (prefillEmail) {
      formData.email = prefillEmail;
      setTimeout(() => {
        const emailInput = document.getElementById('email');
        if (emailInput) emailInput.value = prefillEmail;
      }, 100);
    }
    
    function updateProgress() {
      const progress = (currentStep / totalSteps) * 100;
      document.getElementById('progress-fill').style.width = progress + '%';
    }
    
    function showStep(stepNum) {
      document.querySelectorAll('.step').forEach(step => {
        step.classList.remove('step--active');
      });
      const targetStep = document.querySelector('[data-step="' + stepNum + '"]');
      if (targetStep) {
        targetStep.classList.add('step--active');
        // Focus input if exists
        const input = targetStep.querySelector('input');
        if (input) setTimeout(() => input.focus(), 100);
      }
      updateProgress();
    }
    
    async function submitToWebhook(data) {
      try {
        const response = await fetch(WEBINAR_WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...data,
            webinar_id: webinarData.id,
            webinar_date: webinarData.date,
            submitted_at: new Date().toISOString(),
            source: 'webinar_registration'
          })
        });

        if (response.ok) {
          const result = await response.json();
          console.log('Webinar registration submitted:', result);
        }
        return true;
      } catch (error) {
        console.error('Webhook submission error:', error);
        return false;
      }
    }
    
    function nextStep() {
      // Validate current step if it has input
      const currentStepEl = document.querySelector('[data-step="' + currentStep + '"]');
      const input = currentStepEl?.querySelector('input');
      // Phone field (step 3) is optional — allow empty
      const isOptional = input && input.name === 'phone';
      if (input && !input.value.trim() && !isOptional) {
        input.focus();
        input.style.borderColor = '#dc3545';
        return;
      }
      if (input) {
        formData[input.name] = input.value;
        input.style.borderColor = '';
      }

      currentStep++;
      showStep(currentStep);

      // If we're on the success step, submit the form
      if (currentStep === totalSteps) {
        // Split fullName into firstName/lastName for backend compatibility
        const nameParts = (formData.fullName || '').trim().split(/\s+/);
        const submitData = {
          firstName: nameParts[0] || '',
          lastName: nameParts.slice(1).join(' ') || '',
          email: formData.email || '',
          phone: formData.phone || ''
        };
        console.log('TSP Webinar registration submitted:', submitData);
        submitToWebhook(submitData);

        // GA4 + FB conversion events
        if (typeof gtag === 'function') {
          gtag('event', 'webinar_registration', {
            event_category: 'conversion',
            event_label: 'tsp_webinar',
            webinar_type: 'tsp'
          });
        }
        if (typeof fbq === 'function') {
          fbq('track', 'CompleteRegistration', { content_name: 'TSP Webinar' });
        }

        // Newsletter opt-in (fire-and-forget)
        const newsletterCheckbox = document.getElementById('newsletter-optin');
        if (newsletterCheckbox && newsletterCheckbox.checked && formData.email) {
          if (typeof gtag === 'function') {
            gtag('event', 'newsletter_signup', {
              event_category: 'conversion',
              event_label: 'tsp_webinar_newsletter'
            });
          }
          fetch('https://pleasant-vision-production.up.railway.app/api/newsletter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: formData.fullName || '',
              email: formData.email,
              source: 'tsp_webinar_registration',
              timestamp: new Date().toISOString()
            })
          }).catch(err => console.error('Newsletter signup error:', err));
        }
      }
    }
    
    function prevStep() {
      if (currentStep > 0) {
        currentStep--;
        showStep(currentStep);
      }
    }
    
    function handleEnter(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        nextStep();
      }
    }
    
    function downloadCalendar() {
      if (!webinarData.date) return;
      
      var date = new Date(webinarData.date);
      var endDate = new Date(date.getTime() + 3 * 60 * 60 * 1000);
      
      function formatICSDate(d) {
        return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
      }
      
      var lines = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//PlanWell//Webinar//EN',
        'BEGIN:VEVENT',
        'UID:' + String(webinarData.id) + '@planwellfp.com',
        'DTSTAMP:' + formatICSDate(new Date()),
        'DTSTART:' + formatICSDate(date),
        'DTEND:' + formatICSDate(endDate),
        'SUMMARY:' + String(webinarData.title) + ' - PlanWell Financial Planning',
        'DESCRIPTION:Free 3-hour FERS retirement workshop.',
        'LOCATION:Online (Zoom link will be emailed)',
        'STATUS:CONFIRMED',
        'END:VEVENT',
        'END:VCALENDAR'
      ];
      var icsContent = lines.join('\r\n');
      
      var blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
      var link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'fers-workshop-' + String(webinarData.id) + '.ics';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
    
    // Initialize
    updateProgress();
  </script>
</body>
