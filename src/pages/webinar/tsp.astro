---
import logo from '../../assets/images/planwell-logo.png';
import { getNextTSPWebinar, formatTSPWebinarDate, getDaysUntilTSP, generateTSPICS } from '../../data/tsp-webinars';

// Get the next upcoming TSP webinar
const nextWebinar = getNextTSPWebinar();
const webinarDate = nextWebinar ? formatTSPWebinarDate(nextWebinar) : 'Coming Soon';
const daysUntil = nextWebinar ? getDaysUntilTSP(nextWebinar) : 0;
const webinarTime = nextWebinar ? `${nextWebinar.startTime} – ${nextWebinar.endTime} ${nextWebinar.timezone}` : '';
const webinarId = nextWebinar?.id || '';

// Form fields: full name, email, phone (optional) — matches FERS webinar
const steps = [
  { id: 1, question: "What's your full name?", field: "fullName", type: "text", placeholder: "Full name" },
  { id: 2, question: "Where should we send the details?", field: "email", type: "email", placeholder: "your.email@example.com" },
  { id: 3, question: "Phone number?", field: "phone", type: "tel", placeholder: "(optional)", required: false },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Register for our free TSP webinar on {webinarDate}. 1-hour training on Thrift Savings Plan strategies with David Fei, CFP®." />
  <title>Free TSP Webinar - {webinarDate} | PlanWell</title>
  <link rel="canonical" href="https://planwellfp.com/webinar/" />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://planwellfp.com/webinar/" />
  <meta property="og:title" content="Free FERS Retirement Webinar - {webinarDate} | PlanWell" />
  <meta property="og:description" content="Register for our free 3-hour FERS retirement workshop. Learn about your pension, TSP, survivor benefits, and healthcare options." />
  <meta property="og:site_name" content="PlanWell Financial Planning" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Free FERS Retirement Webinar | PlanWell" />
  <meta name="twitter:description" content="Register for our free 3-hour FERS retirement workshop. Learn about your pension, TSP, survivor benefits, and healthcare options." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MRSSJQ5B');
  </script>
  <!-- Google Analytics 4 -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9GCLL7ZVM8');
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9GCLL7ZVM8"></script>
  <!-- Facebook Pixel -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1064203284941145');
    fbq('track', 'PageView');
  </script>
</head>
<body>
  <div class="funnel">
    <!-- Header -->
    <header class="funnel-header">
      <a href="/" class="funnel-logo">
        <img src={logo.src} alt="PlanWell" />
      </a>
      <a href="/" class="funnel-close" aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </a>
    </header>
    
    <!-- Progress Bar -->
    <div class="progress-bar">
      <div class="progress-fill" id="progress-fill"></div>
    </div>
    
    <!-- Content Area -->
    <main class="funnel-content">
      <!-- Intro Step -->
      <div class="step step--active" data-step="0">
        <div class="step-content">
          <!-- Urgency Badge -->
          <div class="urgency-badge">
            <svg class="urgency-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            <span>
              {daysUntil <= 1 ? 'Tomorrow!' : 'In ' + daysUntil + ' days'}
              <span class="urgency-spots">• Limited spots</span>
            </span>
          </div>
          
          <span class="step-eyebrow">Free TSP Webinar</span>
          <h1 class="step-title">
            {webinarDate}
            <span class="step-time">{webinarTime}</span>
          </h1>
          <p class="step-description">
            Join David Fei, CFP® for a focused 1-hour training on TSP investment strategies. 
            Learn about Traditional vs Roth, fund allocation, and withdrawal planning.
          </p>
          <ul class="step-benefits">
            <li>
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
              <span>Traditional vs Roth TSP strategies</span>
            </li>
            <li>
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
              <span>C, S, I, F, G fund allocation</span>
            </li>
            <li>
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
              <span>Live Q&A with David Fei, CFP®</span>
            </li>
          </ul>

          <button type="button" class="btn-next btn-next--large btn-cta-primary" onclick="nextStep()">
            Reserve My Free Seat
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <p class="step-trust">Join 10,000+ federal employees who've attended</p>

          <!-- Learning Goals -->
          <div class="learning-goals">
            <h3 class="section-subheading">By the end of this session, you'll be able to:</h3>
            <ul class="goals-list">
              <li>Decide between Traditional and Roth TSP contributions</li>
              <li>Build an investment allocation matching your goals</li>
              <li>Plan penalty-free TSP withdrawals in retirement</li>
              <li>Understand when to keep TSP vs roll to an IRA</li>
              <li>Avoid the most common costly TSP mistakes</li>
            </ul>
          </div>

          <!-- Topic Breakdown -->
          <div class="topic-breakdown">
            <h3 class="section-subheading">What You'll Learn <span class="duration">(45 minutes)</span></h3>

            <div class="module-grid">
              <div class="module-card">
                <div class="module-number">1</div>
                <h4>TSP Contribution Strategies</h4>
                <ul>
                  <li>Traditional vs Roth TSP: Which is right for you?</li>
                  <li>Maximizing matching contributions</li>
                  <li>Catch-up contributions for 50+</li>
                  <li>Tax implications now vs retirement</li>
                </ul>
              </div>

              <div class="module-card">
                <div class="module-number">2</div>
                <h4>Fund Allocation & Investment Mix</h4>
                <ul>
                  <li>Understanding C, S, I, F, G funds</li>
                  <li>Risk tolerance and time horizon</li>
                  <li>Lifecycle (L) funds explained</li>
                  <li>Rebalancing your portfolio</li>
                </ul>
              </div>

              <div class="module-card">
                <div class="module-number">3</div>
                <h4>Withdrawal Planning</h4>
                <ul>
                  <li>The 4% rule and TSP withdrawals</li>
                  <li>Penalty-free withdrawals at 55/57</li>
                  <li>Avoiding common tax mistakes</li>
                  <li>IRA rollovers vs keeping it in TSP</li>
                </ul>
              </div>

              <div class="module-card">
                <div class="module-number">4</div>
                <h4>Tax-Smart TSP Strategies</h4>
                <ul>
                  <li>Roth conversion timing and strategy</li>
                  <li>Tax bracket management in retirement</li>
                  <li>RMD planning and IRMAA avoidance</li>
                  <li>Coordinating TSP with other income</li>
                </ul>
              </div>

              <div class="module-card module-card--qa">
                <div class="module-number">5</div>
                <h4>Live Q&A <span class="duration-inline">(15 minutes)</span></h4>
                <ul>
                  <li>Your TSP questions answered live</li>
                  <li>Real-world scenarios discussed</li>
                  <li>Tips from David Fei, CFP®, ChFEBC℠</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- How This Works -->
          <div class="how-it-works">
            <h3 class="section-subheading">What to Expect</h3>

            <div class="expectation-grid">
              <div class="expectation-phase">
                <div class="phase-label">Before the Session</div>
                <ul>
                  <li>You'll receive a Zoom link via email</li>
                  <li>No preparation needed—come with questions</li>
                  <li>Works on computer, tablet, or phone</li>
                </ul>
              </div>

              <div class="expectation-phase">
                <div class="phase-label">During the Session</div>
                <ul>
                  <li>Live presentation with screen sharing</li>
                  <li>Real TSP examples and case studies</li>
                  <li>Interactive Q&A throughout</li>
                  <li>Stay on camera off, unmuted when asking questions</li>
                </ul>
              </div>

              <div class="expectation-phase">
                <div class="phase-label">After the Session</div>
                <ul>
                  <li>Downloadable TSP planning worksheet</li>
                  <li>Recording available for 7 days</li>
                  <li>Optional: Register for full FERS workshop</li>
                  <li>No pressure, no sales pitch—just education</li>
                </ul>
              </div>
            </div>
          </div>

          <button type="button" class="btn-next btn-next--large" onclick="nextStep()">
            Reserve My Free Seat
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <p class="step-trust">Join 10,000+ federal employees who've attended</p>
        </div>
      </div>
      
      <!-- Dynamic Form Steps -->
      {steps.map((step, index) => (
        <div class="step" data-step={index + 1}>
          <div class="step-content">
            <span class="step-counter">Step {index + 1} of {steps.length}</span>
            <h2 class="step-question">{step.question}</h2>

            <div class="input-wrapper">
              <input
                type={step.type}
                id={step.field}
                name={step.field}
                class="funnel-input"
                placeholder={step.placeholder}
                required={step.required !== false}
                onkeydown="handleEnter(event)"
                autocomplete={step.field === 'email' ? 'email' : step.field === 'fullName' ? 'name' : step.field === 'phone' ? 'tel' : 'off'}
              />
              {index === steps.length - 1 && (
                <label class="newsletter-optin">
                  <input type="checkbox" id="newsletter-optin" checked />
                  <span>Sign me up for the PlanWell newsletter</span>
                </label>
              )}
              <button type="button" class="btn-next" onclick="nextStep()">
                {index === steps.length - 1 ? 'Complete Registration' : 'Continue'}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </div>

            <button type="button" class="btn-back" onclick="prevStep()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Back
            </button>
          </div>
        </div>
      ))}
      
      <!-- Success Step -->
      <div class="step" data-step={steps.length + 1}>
        <div class="step-content step-content--success">
          <div class="success-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <path d="M22 4L12 14.01l-3-3"/>
            </svg>
          </div>
          <h2 class="step-title">You're Registered!</h2>
          <p class="step-description success-date">
            See you on <strong>{webinarDate}</strong> at <strong>{webinarTime}</strong>
          </p>
          <p class="step-description">
            Check your inbox for the Zoom link and details. 
            We'll send a reminder before the session.
          </p>
          
          <!-- Calendar Download -->
          <div class="calendar-actions">
            <button type="button" class="btn-calendar" onclick="downloadCalendar()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              Add to Calendar
            </button>
          </div>
          
          <!-- Cross-sell to FERS Workshop -->
          <div class="upsell-box">
            <h3 class="upsell-title">Want the Complete Retirement Picture?</h3>
            <p class="upsell-description">
              Now that your TSP is optimized, get the full FERS strategy: pension timing, 
              FEHB & Medicare coordination, survivor benefits, and tax planning.
            </p>
            <a href="/webinar" class="btn-upsell">
              Also Register for FERS Workshop
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
          
          <a href="/" class="btn-home">
            Return to Homepage
          </a>
        </div>
      </div>
    </main>
  </div>

  <!-- Hidden data for JavaScript -->
  <div 
    id="webinar-data" 
    style="display:none"
    data-id={webinarId}
    data-date={nextWebinar?.date.toISOString()}
    data-title={nextWebinar?.title}
    data-start-time={nextWebinar?.startTime}
    data-end-time={nextWebinar?.endTime}
    data-timezone={nextWebinar?.timezone}
  ></div>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #000d3e;
      min-height: 100vh;
      color: #fff;
    }
    
    .funnel {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    
    .funnel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2rem;
    }
    
    .funnel-logo img {
      height: 120px;
      width: auto;
      object-fit: contain;
    }
    
    .funnel-close {
      color: rgba(255,255,255,0.6);
      transition: color 0.2s;
    }
    
    .funnel-close:hover {
      color: #fff;
    }
    
    .progress-bar {
      height: 4px;
      background: rgba(255,255,255,0.1);
    }
    
    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #d1a437 0%, #e6c25e 100%);
      transition: width 0.4s ease;
    }
    
    .funnel-content {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 3rem 2rem 2rem;
    }
    
    .step {
      display: none;
      width: 100%;
      max-width: 600px;
      animation: fadeIn 0.4s ease;
    }
    
    .step--active {
      display: block;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .step-content {
      text-align: center;
    }
    
    /* Urgency Badge */
    .urgency-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(201, 165, 92, 0.15);
      border: 1px solid rgba(201, 165, 92, 0.4);
      color: #e6c25e;
      padding: 0.5rem 1rem;
      border-radius: 2rem;
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.8; }
    }
    
    .urgency-icon {
      width: 16px;
      height: 16px;
    }
    
    .urgency-spots {
      color: rgba(255,255,255,0.7);
      font-weight: 500;
    }
    
    .step-eyebrow {
      display: inline-block;
      font-size: 0.875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #d1a437;
      margin-bottom: 0.5rem;
    }
    
    .step-counter {
      display: block;
      font-size: 0.875rem;
      color: rgba(255,255,255,0.5);
      margin-bottom: 0.5rem;
    }
    
    .step-title {
      font-family: 'Outfit', sans-serif;
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: 0.5rem;
    }
    
    .step-time {
      display: block;
      font-size: clamp(1.25rem, 3vw, 1.5rem);
      font-weight: 500;
      color: rgba(255,255,255,0.7);
      margin-top: 0.25rem;
    }
    
    .step-question {
      font-family: 'Outfit', sans-serif;
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      font-weight: 600;
      margin-bottom: 2rem;
    }
    
    .step-description {
      font-size: 1.125rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.6;
      margin-bottom: 1.5rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }
    
    .success-date {
      font-size: 1.25rem;
      color: #e6c25e;
    }
    
    .success-date strong {
      color: #fff;
    }
    
    .step-benefits {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    
    .step-benefits li {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 1rem;
      color: rgba(255,255,255,0.9);
    }
    
    .benefit-icon {
      width: 20px;
      height: 20px;
      color: #d1a437;
      flex-shrink: 0;
    }
    
    .step-trust {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.5);
      margin-top: 1.5rem;
    }
    
    .input-wrapper {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 400px;
      margin: 0 auto;
    }
    
    .funnel-input {
      width: 100%;
      padding: 1.25rem 1.5rem;
      font-size: 1.25rem;
      font-family: inherit;
      background: rgba(255,255,255,0.1);
      border: 2px solid rgba(255,255,255,0.2);
      border-radius: 0.75rem;
      color: #fff;
      text-align: center;
      transition: all 0.2s;
    }
    
    .funnel-input::placeholder {
      color: rgba(255,255,255,0.4);
    }
    
    .funnel-input:focus {
      outline: none;
      border-color: #d1a437;
      background: rgba(255,255,255,0.15);
    }
    
    .option-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      max-width: 400px;
      margin: 0 auto;
    }
    
    .option-btn {
      padding: 1rem 1.5rem;
      font-size: 1.125rem;
      font-family: inherit;
      font-weight: 500;
      background: rgba(255,255,255,0.1);
      border: 2px solid rgba(255,255,255,0.2);
      border-radius: 0.75rem;
      color: #fff;
      cursor: pointer;
      transition: all 0.2s;
      text-align: center;
    }
    
    .option-btn:hover {
      background: rgba(255,255,255,0.2);
      border-color: rgba(255,255,255,0.3);
    }
    
    .option-btn--selected {
      background: #d1a437;
      border-color: #d1a437;
      color: #152a45;
    }
    
    .btn-next {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 1rem 2rem;
      font-size: 1.125rem;
      font-weight: 600;
      font-family: inherit;
      background: linear-gradient(135deg, #d1a437 0%, #d1a437 100%);
      color: #152a45;
      border: none;
      border-radius: 0.5rem;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
    }
    
    .btn-next--large {
      padding: 1.25rem 2.5rem;
      font-size: 1.25rem;
    }

    .btn-cta-primary {
      margin-top: 2rem;
      animation: pulse-glow 2s ease-in-out infinite;
    }

    @keyframes pulse-glow {
      0%, 100% {
        box-shadow: 0 10px 30px rgba(201, 165, 92, 0.3);
      }
      50% {
        box-shadow: 0 10px 40px rgba(201, 165, 92, 0.5);
      }
    }

    .btn-next:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(201, 165, 92, 0.3);
    }
    
    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      margin-top: 2rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-family: inherit;
      color: rgba(255,255,255,0.5);
      background: none;
      border: none;
      cursor: pointer;
      transition: color 0.2s;
    }
    
    .btn-back:hover {
      color: #fff;
    }
    
    .step-content--success .success-icon {
      width: 100px;
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      background: linear-gradient(135deg, #d1a437 0%, #d1a437 100%);
      border-radius: 50%;
      color: #152a45;
    }
    
    .calendar-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin: 2rem 0;
    }
    
    .btn-calendar {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 1.5rem;
      font-size: 1rem;
