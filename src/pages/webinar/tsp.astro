      transition: all 0.2s;
    }

    .module-card:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(201, 165, 92, 0.3);
    }

    .module-card--qa {
      grid-column: span 2;
      background: rgba(201, 165, 92, 0.08);
      border-color: rgba(201, 165, 92, 0.2);
    }

    .module-number {
      width: 32px;
      height: 32px;
      background: rgba(201, 165, 92, 0.2);
      color: #d1a437;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    .module-card h4 {
      font-family: 'Outfit', sans-serif;
