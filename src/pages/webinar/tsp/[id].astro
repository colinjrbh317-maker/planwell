---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTSPWebinarById, getAllTSPWebinars, getUpcomingTSPWebinars, formatTSPWebinarDate, getDaysUntilTSP, isPastTSPWebinar } from '../../../data/tsp-webinars';
import { getAllWebinars, isPastWebinar, formatWebinarDate } from '../../../data/webinars';

export const prerender = false;

const { id } = Astro.params;
const webinar = getTSPWebinarById(id);

if (!webinar) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isPast = isPastTSPWebinar(webinar);
const nextWebinar = getUpcomingTSPWebinars(1)[0];
const otherTSPWebinars = getAllTSPWebinars().filter(w => w.id !== id);
const fersWebinars = getAllWebinars().filter(w => !isPastWebinar(w));
const dateFormatted = formatTSPWebinarDate(webinar);
const daysUntil = getDaysUntilTSP(webinar);

// Format for schema
const year = webinar.date.getFullYear();
const month = String(webinar.date.getMonth() + 1).padStart(2, '0');
const day = String(webinar.date.getDate()).padStart(2, '0');
const tzOffset = webinar.timezone === 'EST' ? '-05:00' : '-04:00';
const isoDate = `${year}-${month}-${day}`;

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EducationEvent",
  "name": `TSP Investment Strategies Workshop — ${dateFormatted}`,
  "description": "1-hour focused TSP training covering fund allocation strategies, Roth vs Traditional TSP, L Fund optimization, and withdrawal planning for federal employees.",
  "startDate": `${isoDate}T12:00:00${tzOffset}`,
  "endDate": `${isoDate}T13:00:00${tzOffset}`,
  "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
  "eventStatus": isPast ? "https://schema.org/EventCompleted" : "https://schema.org/EventScheduled",
  "location": {
    "@type": "VirtualLocation",
    "url": `https://planwellfp.com/webinar/tsp/${id}`
  },
  "organizer": {
    "@type": "Organization",
    "name": "PlanWell Financial Planning",
    "url": "https://planwellfp.com"
  },
  "performer": [
    { "@type": "Person", "name": "David Fei", "jobTitle": "CFP\u00ae, ChFEBC\u2120, AIF\u00ae" }
  ],
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://planwellfp.com/webinar/tsp"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are the webinars really free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our FERS retirement workshops and TSP sessions are completely free with no obligation. We believe every federal employee deserves to understand their benefits before making retirement decisions."
      }
    },
    {
      "@type": "Question",
      "name": "How long are the workshops?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The focused TSP session is 1 hour. The comprehensive FERS workshop is 3 hours. Both include time for Q&A."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to be near retirement to attend?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not at all. Federal employees at every career stage benefit from understanding their TSP options. In fact, the earlier you attend, the more time you have to optimize your contributions and allocation strategy."
      }
    },
    {
      "@type": "Question",
      "name": "What do I need to prepare?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nothing. Just show up with your questions. If you have a recent TSP statement available, it can help you follow along, but it's not required."
      }
    },
    {
      "@type": "Question",
      "name": "Will I be pressured to buy something?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The workshop is educational. If you want personalized guidance afterward, we offer one-on-one consultations, but there's zero pressure during or after the workshop."
      }
    },
    {
      "@type": "Question",
      "name": "How do I attend?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Register online and you'll receive a Zoom link by email. The workshops are fully virtual — attend from anywhere. A calendar invitation is included with your registration confirmation."
      }
    }
  ]
};
---

<BaseLayout
  title={`Free TSP Workshop ${dateFormatted} | PlanWell`}
  description={`Register for our free TSP investment strategies workshop on ${dateFormatted}. 1-hour session covering C/S/I/F/G funds, L Fund allocation, Roth vs Traditional TSP, and withdrawal strategies. Led by David Fei, CFP\u00ae.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="event-hero">
    <div class="container">
      <span class="eyebrow">Free Federal Retirement Education</span>
      <h1 class="heading-xl">TSP Investment Strategies Workshop &mdash; {dateFormatted}</h1>

      {isPast ? (
        <div class="past-notice">
          <p class="past-notice__text">This workshop has passed.</p>
          {nextWebinar && (
            <p class="past-notice__next">
              Our next TSP workshop is on <a href={`/webinar/tsp/${nextWebinar.id}`}>{formatTSPWebinarDate(nextWebinar)}</a>.
            </p>
          )}
          <a href="/webinar/tsp" class="btn btn--primary btn--lg">View Upcoming TSP Workshops</a>
        </div>
      ) : (
        <div class="event-details">
          <div class="event-meta">
            <span class="event-meta__time">{webinar.startTime} &ndash; {webinar.endTime} {webinar.timezone}</span>
            <span class="event-meta__duration">1 Hour &bull; Free &bull; Online</span>
            {daysUntil > 0 && (
              <span class="event-meta__countdown">{daysUntil} {daysUntil === 1 ? 'day' : 'days'} away</span>
            )}
          </div>
          <a href="/webinar/tsp" class="btn btn--primary btn--lg">Register Now</a>
        </div>
      )}
    </div>
  </section>

  <!-- What You'll Learn -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">TSP Workshop Topics</span>
        <h2 class="heading-lg">What You'll Learn in 1 Hour</h2>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
          </div>
          <h3>TSP Fund Overview</h3>
          <p>Understand the characteristics, risk profiles, and historical performance of the C, S, I, F, and G funds so you can make informed allocation decisions.</p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>L Fund Allocation</h3>
          <p>How Lifecycle funds work, when they make sense, and how to evaluate whether an L Fund or a custom allocation better fits your retirement timeline.</p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h3>Roth vs Traditional TSP</h3>
          <p>The tax implications of each option, when to consider converting, and how your federal tax bracket in retirement affects the decision.</p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <h3>Withdrawal Strategies</h3>
          <p>TSP withdrawal options after separation, required minimum distributions, and how to sequence TSP withdrawals with your pension and Social Security.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Your Instructor -->
  <section class="section section--navy">
    <div class="container">
      <div class="section-header">
        <h2 class="heading-lg">Your Workshop Instructor</h2>
      </div>

      <div class="instructor-single">
        <div class="instructor-card">
          <span class="instructor-card__credentials">CFP&#174; &bull; ChFEBC&#8480; &bull; AIF&#174;</span>
          <h3>David Fei</h3>
          <p>David brings deep expertise in TSP optimization, tax planning, and retirement income strategies specifically designed for federal employees. He hosts PlanWell's focused TSP sessions and leads the investment strategy segments of the comprehensive FERS workshops.</p>
        </div>
      </div>

      <p class="instructors-note">David holds triple credentials held by less than 1% of financial advisors.</p>
    </div>
  </section>

  <!-- Other Upcoming Workshops -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">More Dates Available</span>
        <h2 class="heading-lg">Other Upcoming Workshops</h2>
      </div>

      <div class="workshops-list">
        {otherTSPWebinars.filter(w => !isPastTSPWebinar(w)).length > 0 && (
          <div class="workshops-group">
            <h3 class="workshops-group__title">TSP Investment Workshops (1 Hour)</h3>
            <ul class="workshops-dates">
              {otherTSPWebinars.filter(w => !isPastTSPWebinar(w)).map(w => (
                <li>
                  <a href={`/webinar/tsp/${w.id}`} class="workshop-link">
                    <span class="workshop-link__date">{formatTSPWebinarDate(w)}</span>
                    <span class="workshop-link__time">{w.startTime} &ndash; {w.endTime} {w.timezone}</span>
                    <span class="workshop-link__arrow">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {fersWebinars.length > 0 && (
          <div class="workshops-group">
            <h3 class="workshops-group__title">FERS Retirement Workshops (3 Hours)</h3>
            <ul class="workshops-dates">
              {fersWebinars.map(w => (
                <li>
                  <a href={`/webinar/${w.id}`} class="workshop-link">
                    <span class="workshop-link__date">{formatWebinarDate(w)}</span>
                    <span class="workshop-link__time">{w.startTime} &ndash; {w.endTime} {w.timezone}</span>
                    <span class="workshop-link__arrow">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Workshop Questions</span>
        <h2 class="heading-lg">Frequently Asked Questions</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">Are the webinars really free?</summary>
          <div class="faq-answer">
            <p>Yes. Our FERS retirement workshops and TSP sessions are completely free with no obligation. We believe every federal employee deserves to understand their benefits before making retirement decisions.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How long are the workshops?</summary>
          <div class="faq-answer">
            <p>The focused TSP session is 1 hour. The comprehensive FERS workshop is 3 hours. Both include time for Q&A.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Do I need to be near retirement to attend?</summary>
          <div class="faq-answer">
            <p>Not at all. Federal employees at every career stage benefit from understanding their TSP options. In fact, the earlier you attend, the more time you have to optimize your contributions and allocation strategy.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">What do I need to prepare?</summary>
          <div class="faq-answer">
            <p>Nothing. Just show up with your questions. If you have a recent TSP statement available, it can help you follow along, but it's not required.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Will I be pressured to buy something?</summary>
          <div class="faq-answer">
            <p>No. The workshop is educational. If you want personalized guidance afterward, we offer one-on-one consultations, but there's zero pressure during or after the workshop.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How do I attend?</summary>
          <div class="faq-answer">
            <p>Register online and you'll receive a Zoom link by email. The workshops are fully virtual -- attend from anywhere. A calendar invitation is included with your registration confirmation.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section--gold text-center">
    <div class="container">
      <div>
        <h2 class="heading-lg">Make Your TSP Work Harder for You</h2>
        <p class="lead" style="max-width: 36rem; margin: 0 auto var(--space-8);">
          Most federal employees have never reviewed their TSP allocation strategy.
          One hour could help you make smarter decisions with your largest retirement asset.
        </p>
        <div class="cta-buttons">
          <a href="/webinar/tsp" class="btn btn--navy btn--lg">Register for TSP Workshop</a>
          <a href="/webinar" class="btn btn--outline-navy btn--lg">Register for FERS Workshop</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .event-hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
  }
  .event-hero h1 { color: var(--color-white); margin-bottom: var(--space-6); }
  .section-header { text-align: center; margin-bottom: var(--space-12); }

  /* Past Notice */
  .past-notice { max-width: 600px; margin: 0 auto; }
  .past-notice__text {
    font-size: var(--text-xl);
    color: var(--color-gray-300);
    margin-bottom: var(--space-2);
  }
  .past-notice__next {
    color: var(--color-gray-400);
    margin-bottom: var(--space-6);
  }
  .past-notice__next a { color: var(--color-gold); text-decoration: underline; }
  .past-notice__next a:hover { color: var(--color-white); }

  /* Event Details */
  .event-details { max-width: 600px; margin: 0 auto; }
  .event-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .event-meta__time {
    font-size: var(--text-xl);
    color: var(--color-gray-300);
  }
  .event-meta__duration {
    font-size: var(--text-lg);
    color: var(--color-gray-400);
  }
  .event-meta__countdown {
    display: inline-block;
    background: var(--color-gold);
    color: var(--color-navy-dark);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  /* Features Grid - 2x2 for 4 TSP topics */
  .features-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); max-width: 800px; margin: 0 auto; }
  .feature-card {
    background: var(--color-white);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-200);
    transition: all var(--transition-base);
  }
  .feature-card:hover { border-color: var(--color-gold); box-shadow: var(--shadow-lg); transform: translateY(-4px); }
  .feature-card__icon { width: 40px; height: 40px; color: var(--color-gold); margin-bottom: var(--space-3); }
  .feature-card__icon svg { width: 100%; height: 100%; }
  .feature-card h3 { font-size: var(--text-base); margin-bottom: var(--space-2); }
  .feature-card p { color: var(--color-gray-600); font-size: var(--text-sm); line-height: 1.5; }

  /* Single Instructor */
  .instructor-single { max-width: 500px; margin: 0 auto; }
  .instructor-card {
    text-align: center;
    padding: var(--space-8);
    background: rgba(255,255,255,0.05);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .instructor-card__credentials {
    display: inline-block;
    color: var(--color-gold);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
    letter-spacing: 0.02em;
  }
  .instructor-card h3 { color: var(--color-white); font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .instructor-card p { color: var(--color-gray-400); font-size: var(--text-sm); line-height: 1.6; }
  .instructors-note {
    text-align: center;
    color: var(--color-gold);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    margin-top: var(--space-6);
  }

  /* Workshops List */
  .workshops-list { max-width: 700px; margin: 0 auto; }
  .workshops-group { margin-bottom: var(--space-8); }
  .workshops-group__title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-navy);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-gold);
  }
  .workshops-dates { list-style: none; padding: 0; margin: 0; }
  .workshop-link {
    display: flex;
    align-items: center;
    padding: var(--space-4) var(--space-4);
    border-bottom: 1px solid var(--color-gray-200);
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .workshop-link:hover { background: var(--color-white); }
  .workshop-link__date {
    font-weight: var(--font-semibold);
    color: var(--color-navy);
    flex: 1;
  }
  .workshop-link__time {
    color: var(--color-gray-500);
    font-size: var(--text-sm);
    margin-right: var(--space-4);
  }
  .workshop-link__arrow {
    color: var(--color-gold);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
  }

  /* FAQ */
  .faq-list { max-width: 800px; margin: 0 auto; }
  .faq-item { border-bottom: 1px solid var(--color-gray-200); }
  .faq-question {
    padding: var(--space-5) 0;
    font-weight: var(--font-semibold);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-navy);
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after {
    content: '+';
    font-size: var(--text-xl);
    color: var(--color-gold);
    transition: transform var(--transition-fast);
  }
  details[open] .faq-question::after { transform: rotate(45deg); }
  .faq-answer { padding-bottom: var(--space-5); color: var(--color-gray-600); }

  /* Gold CTA Section */
  .section--gold {
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
    color: var(--color-navy-dark);
  }
  .section--gold h2 { color: var(--color-navy-dark); }
  .cta-buttons { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
  .btn--navy { background: var(--color-navy); color: var(--color-white); }
  .btn--navy:hover { background: var(--color-navy-dark); }
  .btn--outline-navy { background: transparent; color: var(--color-navy); border: 2px solid var(--color-navy); }
  .btn--outline-navy:hover { background: var(--color-navy); color: var(--color-white); }

  /* Responsive */
  @media (max-width: 768px) {
    .features-grid { grid-template-columns: 1fr; }
    .workshop-link { flex-wrap: wrap; gap: var(--space-1); }
    .workshop-link__time { margin-right: 0; }
  }
</style>
