---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWebinarById, getAllWebinars, getUpcomingWebinars, formatWebinarDate, getDaysUntil, isPastWebinar } from '../../data/webinars';

export const prerender = false;

const { id } = Astro.params;
const webinar = getWebinarById(id);

if (!webinar) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isPast = isPastWebinar(webinar);
const nextWebinar = getUpcomingWebinars(1)[0];
const otherWebinars = getAllWebinars().filter(w => w.id !== id);
const dateFormatted = formatWebinarDate(webinar);
const daysUntil = getDaysUntil(webinar);

// Format for schema
const year = webinar.date.getFullYear();
const month = String(webinar.date.getMonth() + 1).padStart(2, '0');
const day = String(webinar.date.getDate()).padStart(2, '0');
const tzOffset = webinar.timezone === 'EST' ? '-05:00' : '-04:00';
const isoDate = `${year}-${month}-${day}`;

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "EducationEvent",
  "name": `Free FERS Retirement Workshop — ${dateFormatted}`,
  "description": "3-hour comprehensive federal retirement education covering FERS pension, TSP, FEHB, Medicare coordination, survivor benefits, and tax planning.",
  "startDate": `${isoDate}T11:00:00${tzOffset}`,
  "endDate": `${isoDate}T14:00:00${tzOffset}`,
  "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
  "eventStatus": isPast ? "https://schema.org/EventCompleted" : "https://schema.org/EventScheduled",
  "location": {
    "@type": "VirtualLocation",
    "url": `https://planwellfp.com/webinar/${id}`
  },
  "organizer": {
    "@type": "Organization",
    "name": "PlanWell Financial Planning",
    "url": "https://planwellfp.com"
  },
  "performer": [
    { "@type": "Person", "name": "Brennan Rhule", "jobTitle": "CFP\u00ae, ChFEBC\u2120, AIF\u00ae" },
    { "@type": "Person", "name": "David Fei", "jobTitle": "CFP\u00ae, ChFEBC\u2120, AIF\u00ae" }
  ],
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://planwellfp.com/webinar"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are the webinars really free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our FERS retirement workshops and TSP sessions are completely free with no obligation. We believe every federal employee deserves to understand their benefits before making retirement decisions."
      }
    },
    {
      "@type": "Question",
      "name": "How long are the workshops?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The comprehensive FERS workshop is 3 hours. The focused TSP session is 1 hour. Both include time for Q&A."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to be near retirement to attend?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not at all. Federal employees at every career stage benefit from understanding their benefits. In fact, the earlier you attend, the more time you have to optimize your TSP contributions, insurance decisions, and career timing."
      }
    },
    {
      "@type": "Question",
      "name": "What do I need to prepare?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nothing. Just show up with your questions. If you have a recent SF-50 or TSP statement available, those can help you follow along with the calculations, but they're not required."
      }
    },
    {
      "@type": "Question",
      "name": "Will I be pressured to buy something?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The workshop is educational. If you want personalized guidance afterward, we offer one-on-one consultations, but there's zero pressure during or after the workshop."
      }
    },
    {
      "@type": "Question",
      "name": "How do I attend?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Register online and you'll receive a Zoom link by email. The workshops are fully virtual — attend from anywhere. A calendar invitation is included with your registration confirmation."
      }
    }
  ]
};
---

<BaseLayout
  title={`Free FERS Retirement Webinar ${dateFormatted} | PlanWell`}
  description={`Register for our free FERS retirement webinar on ${dateFormatted}. 3-hour workshop covering pension, TSP, FEHB, Medicare, and survivor benefits. Led by CFP\u00ae professionals.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="event-hero">
    <div class="container">
      <span class="eyebrow">Free Federal Retirement Education</span>
      <h1 class="heading-xl">Free FERS Retirement Workshop &mdash; {dateFormatted}</h1>

      {isPast ? (
        <div class="past-notice">
          <p class="past-notice__text">This workshop has passed.</p>
          {nextWebinar && (
            <p class="past-notice__next">
              Our next FERS workshop is on <a href="/webinar">{formatWebinarDate(nextWebinar)}</a>.
            </p>
          )}
          <a href="/webinar" class="btn btn--primary btn--lg">View Upcoming Workshops</a>
        </div>
      ) : (
        <div class="event-details">
          <div class="event-meta">
            <span class="event-meta__time">{webinar.startTime} &ndash; {webinar.endTime} {webinar.timezone}</span>
            <span class="event-meta__duration">3 Hours &bull; Free &bull; Online</span>
            {daysUntil > 0 && (
              <span class="event-meta__countdown">{daysUntil} {daysUntil === 1 ? 'day' : 'days'} away</span>
            )}
          </div>
          <a href="/webinar" class="btn btn--primary btn--lg">Register Now</a>
        </div>
      )}
    </div>
  </section>

  <!-- What You'll Learn -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">FERS Workshop Topics</span>
        <h2 class="heading-lg">What You'll Learn in 3 Hours</h2>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3>FERS Pension Calculations</h3>
          <p>Your exact retirement eligibility dates, high-3 salary optimization, and how sick leave converts to additional pension credit.</p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
          </div>
          <h3>TSP Strategies</h3>
          <p>Fund allocation approaches, Roth vs traditional TSP decisions, and withdrawal options that minimize your tax burden.</p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h3>FEHB in Retirement</h3>
          <p>How to keep your federal health insurance, what changes after retirement, and how Medicare coordination works at 65.</p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3>Survivor Benefits</h3>
          <p>SBP costs and coverage, FEGLI analysis, and strategies to protect your spouse without overpaying for insurance.</p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <h3>Social Security Timing</h3>
          <p>When to claim based on your FERS pension, what the 2025 repeal of the Windfall Elimination Provision and Government Pension Offset changed for CSRS and CSRS Offset retirees, and spousal strategies.</p>
        </div>

        <div class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h3>Tax Planning</h3>
          <p>Roth conversion opportunities, bracket management in retirement, and how to sequence withdrawals from pension, TSP, and Social Security.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Your Instructors -->
  <section class="section section--navy">
    <div class="container">
      <div class="section-header">
        <h2 class="heading-lg">Your Workshop Instructors</h2>
      </div>

      <div class="instructors-grid">
        <div class="instructor-card">
          <span class="instructor-card__credentials">CFP&#174; &bull; ChFEBC&#8480; &bull; AIF&#174;</span>
          <h3>Brennan Rhule</h3>
          <p>Brennan specializes in helping federal employees within 5-15 years of retirement create comprehensive financial strategies that maximize their FERS benefits.</p>
        </div>

        <div class="instructor-card">
          <span class="instructor-card__credentials">CFP&#174; &bull; ChFEBC&#8480; &bull; AIF&#174;</span>
          <h3>David Fei</h3>
          <p>David brings deep expertise in TSP optimization, tax planning, and retirement income strategies specifically designed for federal employees.</p>
        </div>
      </div>

      <p class="instructors-note">Both hold triple credentials held by less than 1% of financial advisors.</p>
    </div>
  </section>

  <!-- Other Upcoming Workshops -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">More Dates Available</span>
        <h2 class="heading-lg">Other Upcoming Workshops</h2>
      </div>

      <div class="workshops-list">
        {otherWebinars.filter(w => !isPastWebinar(w)).length > 0 && (
          <div class="workshops-group">
            <h3 class="workshops-group__title">FERS Retirement Workshops (3 Hours)</h3>
            <ul class="workshops-dates">
              {otherWebinars.filter(w => !isPastWebinar(w)).map(w => (
                <li>
                  <a href="/webinar" class="workshop-link">
                    <span class="workshop-link__date">{formatWebinarDate(w)}</span>
                    <span class="workshop-link__time">{w.startTime} &ndash; {w.endTime} {w.timezone}</span>
                    <span class="workshop-link__arrow">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Workshop Questions</span>
        <h2 class="heading-lg">Frequently Asked Questions</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">Are the webinars really free?</summary>
          <div class="faq-answer">
            <p>Yes. Our FERS retirement workshops and TSP sessions are completely free with no obligation. We believe every federal employee deserves to understand their benefits before making retirement decisions.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How long are the workshops?</summary>
          <div class="faq-answer">
            <p>The comprehensive FERS workshop is 3 hours. The focused TSP session is 1 hour. Both include time for Q&A.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Do I need to be near retirement to attend?</summary>
          <div class="faq-answer">
            <p>Not at all. Federal employees at every career stage benefit from understanding their benefits. In fact, the earlier you attend, the more time you have to optimize your TSP contributions, insurance decisions, and career timing.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">What do I need to prepare?</summary>
          <div class="faq-answer">
            <p>Nothing. Just show up with your questions. If you have a recent SF-50 or TSP statement available, those can help you follow along with the calculations, but they're not required.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Will I be pressured to buy something?</summary>
          <div class="faq-answer">
            <p>No. The workshop is educational. If you want personalized guidance afterward, we offer one-on-one consultations, but there's zero pressure during or after the workshop.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">How do I attend?</summary>
          <div class="faq-answer">
            <p>Register online and you'll receive a Zoom link by email. The workshops are fully virtual -- attend from anywhere. A calendar invitation is included with your registration confirmation.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section--gold text-center">
    <div class="container">
      <div>
        <h2 class="heading-lg">Your Retirement Benefits Are Too Important to Guess About</h2>
        <p class="lead" style="max-width: 36rem; margin: 0 auto var(--space-8);">
          Federal employees leave thousands on the table every year because they don't fully
          understand their benefits. Three hours of your time could change your entire retirement outlook.
        </p>
        <div class="cta-buttons">
          <a href="/webinar" class="btn btn--navy btn--lg">Register for FERS Workshop</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .event-hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
  }
  .event-hero h1 { color: var(--color-white); margin-bottom: var(--space-6); }
  .section-header { text-align: center; margin-bottom: var(--space-12); }

  /* Past Notice */
  .past-notice { max-width: 600px; margin: 0 auto; }
  .past-notice__text {
    font-size: var(--text-xl);
    color: var(--color-gray-300);
    margin-bottom: var(--space-2);
  }
  .past-notice__next {
    color: var(--color-gray-400);
    margin-bottom: var(--space-6);
  }
  .past-notice__next a { color: var(--color-gold); text-decoration: underline; }
  .past-notice__next a:hover { color: var(--color-white); }

  /* Event Details */
  .event-details { max-width: 600px; margin: 0 auto; }
  .event-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .event-meta__time {
    font-size: var(--text-xl);
    color: var(--color-gray-300);
  }
  .event-meta__duration {
    font-size: var(--text-lg);
    color: var(--color-gray-400);
  }
  .event-meta__countdown {
    display: inline-block;
    background: var(--color-gold);
    color: var(--color-navy-dark);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  /* Features Grid */
  .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .feature-card {
    background: var(--color-white);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-200);
    transition: all var(--transition-base);
  }
  .feature-card:hover { border-color: var(--color-gold); box-shadow: var(--shadow-lg); transform: translateY(-4px); }
  .feature-card__icon { width: 40px; height: 40px; color: var(--color-gold); margin-bottom: var(--space-3); }
  .feature-card__icon svg { width: 100%; height: 100%; }
  .feature-card h3 { font-size: var(--text-base); margin-bottom: var(--space-2); }
  .feature-card p { color: var(--color-gray-600); font-size: var(--text-sm); line-height: 1.5; }

  /* Instructors */
  .instructors-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); max-width: 900px; margin: 0 auto; }
  .instructor-card {
    text-align: center;
    padding: var(--space-8);
    background: rgba(255,255,255,0.05);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .instructor-card__credentials {
    display: inline-block;
    color: var(--color-gold);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
    letter-spacing: 0.02em;
  }
  .instructor-card h3 { color: var(--color-white); font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .instructor-card p { color: var(--color-gray-400); font-size: var(--text-sm); line-height: 1.6; }
  .instructors-note {
    text-align: center;
    color: var(--color-gold);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    margin-top: var(--space-6);
  }

  /* Workshops List */
  .workshops-list { max-width: 700px; margin: 0 auto; }
  .workshops-group { margin-bottom: var(--space-8); }
  .workshops-group__title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-navy);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-gold);
  }
  .workshops-dates { list-style: none; padding: 0; margin: 0; }
  .workshop-link {
    display: flex;
    align-items: center;
    padding: var(--space-4) var(--space-4);
    border-bottom: 1px solid var(--color-gray-200);
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .workshop-link:hover { background: var(--color-white); }
  .workshop-link__date {
    font-weight: var(--font-semibold);
    color: var(--color-navy);
    flex: 1;
  }
  .workshop-link__time {
    color: var(--color-gray-500);
    font-size: var(--text-sm);
    margin-right: var(--space-4);
  }
  .workshop-link__arrow {
    color: var(--color-gold);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
  }

  /* FAQ */
  .faq-list { max-width: 800px; margin: 0 auto; }
  .faq-item { border-bottom: 1px solid var(--color-gray-200); }
  .faq-question {
    padding: var(--space-5) 0;
    font-weight: var(--font-semibold);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-navy);
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after {
    content: '+';
    font-size: var(--text-xl);
    color: var(--color-gold);
    transition: transform var(--transition-fast);
  }
  details[open] .faq-question::after { transform: rotate(45deg); }
  .faq-answer { padding-bottom: var(--space-5); color: var(--color-gray-600); }

  /* Gold CTA Section */
  .section--gold {
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%);
    color: var(--color-navy-dark);
  }
  .section--gold h2 { color: var(--color-navy-dark); }
  .cta-buttons { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
  .btn--navy { background: var(--color-navy); color: var(--color-white); }
  .btn--navy:hover { background: var(--color-navy-dark); }
  .btn--outline-navy { background: transparent; color: var(--color-navy); border: 2px solid var(--color-navy); }
  .btn--outline-navy:hover { background: var(--color-navy); color: var(--color-white); }

  /* Responsive */
  @media (max-width: 1024px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .features-grid, .instructors-grid { grid-template-columns: 1fr; }
    .workshop-link { flex-wrap: wrap; gap: var(--space-1); }
    .workshop-link__time { margin-right: 0; }
  }
</style>
