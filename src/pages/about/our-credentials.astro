---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Our Credentials - The PlanWell Difference | CFP, AIF, ChFEBC"
  description="Less than 1% of financial planners hold all three designations: CFP, AIF, and ChFEBC. Meet the credentials that set PlanWell apart for federal retirement planning."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">The PlanWell Difference</span>
      <h1 class="heading-xl">Expert Credentials That Matter</h1>
      <p class="lead max-w-3xl">
        Less than 1% of financial planners hold all three of these designations.
        Our credentials ensure you receive the highest standard of federal retirement expertise.
      </p>
    </div>
  </section>

  <!-- Credentials Grid -->
  <section class="section">
    <div class="container">
      <div class="credentials-grid">
        <!-- CFP Card -->
        <article class="credential-card" data-animate="fade-in-up">
          <div class="credential-card__badge">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M24 4L6 12v12c0 11 8 21 18 24 10-3 18-13 18-24V12L24 4z"/>
              <path d="M16 24l6 6 12-12" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2 class="credential-card__title">CFP<sup>&reg;</sup></h2>
          <h3 class="credential-card__subtitle">Certified Financial Planner</h3>
          <div class="credential-card__details">
            <ul>
              <li>Bachelor's degree required</li>
              <li>12-18 months of rigorous coursework</li>
              <li>6,000+ hours of professional experience</li>
              <li>Fiduciary standard of care</li>
              <li>Comprehensive 6-hour board exam</li>
            </ul>
          </div>
        </article>

        <!-- AIF Card -->
        <article class="credential-card" data-animate="fade-in-up">
          <div class="credential-card__badge">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="24" y1="6" x2="24" y2="42"/>
              <line x1="6" y1="14" x2="42" y2="14"/>
              <path d="M6 14l6 14H0l6-14z"/>
              <path d="M42 14l6 14h-12l6-14z"/>
              <rect x="20" y="38" width="8" height="4"/>
            </svg>
          </div>
          <h2 class="credential-card__title">AIF<sup>&reg;</sup></h2>
          <h3 class="credential-card__subtitle">Accredited Investment Fiduciary</h3>
          <div class="credential-card__details">
            <ul>
              <li>Expertise in fiduciary duty principles</li>
              <li>Rigorous conduct standards</li>
              <li>Investor asset management responsibility</li>
              <li>Ongoing education requirements</li>
              <li>Legally bound to act in your interest</li>
            </ul>
          </div>
        </article>

        <!-- ChFEBC Card -->
        <article class="credential-card" data-animate="fade-in-up">
          <div class="credential-card__badge">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M24 4L8 12v4h32v-4L24 4z"/>
              <rect x="12" y="16" width="4" height="18"/>
              <rect x="22" y="16" width="4" height="18"/>
              <rect x="32" y="16" width="4" height="18"/>
              <rect x="6" y="34" width="36" height="6"/>
              <circle cx="24" cy="8" r="2" fill="currentColor"/>
            </svg>
          </div>
          <h2 class="credential-card__title">ChFEBC<sup>&#8480;</sup></h2>
          <h3 class="credential-card__subtitle">Chartered Federal Employee Benefits Consultant</h3>
          <div class="credential-card__details">
            <ul>
              <li>175 hours of specialized training</li>
              <li>FERS & CSRS pension expertise</li>
              <li>TSP, FEGLI, FEHB mastery</li>
              <li>Medicare & Social Security coordination</li>
              <li>Survivor benefit optimization</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Why It Matters -->
  <section class="section section--gray">
    <div class="container">
      <div class="why-matters" data-animate="fade-in-up">
        <div class="why-matters__content">
          <span class="eyebrow">Why It Matters</span>
          <h2 class="heading-lg">The Fiduciary Difference</h2>
          <p>
            A fiduciary is legally obligated to put your interests first—always. Unlike
            commission-based advisors who may recommend products that benefit them, we
            provide objective guidance aligned solely with your goals.
          </p>
          <p>
            Combined with our deep federal benefits expertise, this means you get advice
            that's both trustworthy and specialized for your unique situation as a
            federal employee.
          </p>
          <p>
            <strong>The bottom line:</strong> When you work with PlanWell, you're working
            with advisors who have invested thousands of hours mastering both comprehensive
            financial planning and the complex rules governing federal retirement.
          </p>
        </div>
        <div class="why-matters__stats">
          <div class="stat-card">
            <div class="stat-number">&lt;1%</div>
            <div class="stat-label">Of Advisors Hold All 3 Designations</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">175+</div>
            <div class="stat-label">Hours Federal Benefits Training</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">100%</div>
            <div class="stat-label">Fiduciary Commitment</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--navy text-center">
    <div class="container">
      <div data-animate="fade-in-up">
        <h2 class="heading-lg">Work With Credentialed Experts</h2>
        <p class="lead" style="color: var(--color-gray-300); max-width: 36rem; margin: 0 auto var(--space-8);">
          Experience the difference that specialized credentials make in your federal retirement planning.
        </p>
        <div class="flex justify-center gap-4" style="flex-wrap: wrap;">
          <a href="https://planwell.vercel.app/webinars" class="btn btn--primary btn--lg">Free FERS Workshop</a>
          <a href="/book-call" class="btn btn--white btn--lg">Schedule a Call</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .page-hero .lead {
    color: var(--color-gray-300);
    margin: 0 auto;
  }

  /* Credentials Grid */
  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Credential Card */
  .credential-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
    text-align: center;
    box-shadow: var(--shadow-md);
    border: 2px solid var(--color-gray-200);
    transition: all var(--transition-base);
  }

  .credential-card:hover {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-xl);
    transform: translateY(-8px);
  }

  .credential-card__badge {
    width: 80px;
    height: 80px;
    margin: 0 auto var(--space-6);
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-light) 100%);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold);
  }

  .credential-card__badge svg {
    width: 40px;
    height: 40px;
  }

  .credential-card__title {
    font-size: var(--text-3xl);
    color: var(--color-navy);
    margin-bottom: var(--space-1);
    font-family: var(--font-heading);
  }

  .credential-card__title sup {
    font-size: var(--text-sm);
  }

  .credential-card__subtitle {
    font-size: var(--text-base);
    color: var(--color-gold);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-6);
  }

  .credential-card__details ul {
    list-style: none;
    text-align: left;
  }

  .credential-card__details li {
    padding: var(--space-2) 0;
    padding-left: var(--space-6);
    position: relative;
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .credential-card__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    background: var(--color-gold);
    border-radius: var(--radius-full);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 8l3 3 5-5' stroke='%23000d3e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Why It Matters */
  .why-matters {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-12);
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }

  .why-matters__content p {
    margin-bottom: var(--space-4);
    color: var(--color-gray-700);
    line-height: 1.7;
  }

  .why-matters__stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stat-card {
    background: var(--color-white);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    text-align: center;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-gray-200);
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    margin-top: var(--space-1);
  }

  @media (max-width: 1024px) {
    .credentials-grid {
      grid-template-columns: 1fr;
      max-width: 500px;
    }

    .why-matters {
      grid-template-columns: 1fr;
    }

    .why-matters__stats {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .stat-card {
      flex: 1;
      min-width: 150px;
    }
  }

  @media (max-width: 640px) {
    .why-matters__stats {
      flex-direction: column;
    }

    .stat-card {
      min-width: auto;
    }
  }
</style>
