---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Fed-Expert Financial Blueprint | Our Process for Federal Employees"
  description="Our proprietary 3-step process for federal employees: Discovery, Benefits Report, and Partnership. See how PlanWell helps you retire with confidence."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Our Proprietary Process</span>
      <h1 class="heading-xl">The Fed-Expert Financial Blueprint</h1>
      <p class="lead max-w-3xl">
        A clear, proven path from uncertainty to confidence in your federal retirement.
        Every federal employee deserves personalized guidance tailored to their unique benefits.
      </p>
    </div>
  </section>

  <!-- 3-Step Process -->
  <section class="section">
    <div class="container">
      <div class="blueprint-steps">
        <!-- Step 1: Discovery -->
        <div class="blueprint-step" data-animate="fade-in-up">
          <div class="blueprint-step__icon">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="20" cy="20" r="12"/>
              <line x1="28" y1="28" x2="40" y2="40" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="blueprint-step__number">1</div>
          <div class="blueprint-step__content">
            <h2 class="blueprint-step__title">Discovery</h2>
            <p class="blueprint-step__description">
              We start with an introductory meeting to understand your goals, timeline, and concerns.
              Our Chartered Federal Employee Benefits Consultants review your complete financial picture.
            </p>
            <div class="blueprint-step__details">
              <h4>What to Bring:</h4>
              <ul>
                <li>Leave & Earnings Statement (LES)</li>
                <li>TSP Account Summary</li>
                <li>Social Security Statement</li>
                <li>Completed financial questionnaire (we'll provide)</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Step 2: Benefits Report -->
        <div class="blueprint-step" data-animate="fade-in-up">
          <div class="blueprint-step__icon">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 6h18l8 8v28a2 2 0 01-2 2H12a2 2 0 01-2-2V8a2 2 0 012-2z"/>
              <polyline points="30 6 30 14 38 14"/>
              <line x1="16" y1="22" x2="32" y2="22"/>
              <line x1="16" y1="28" x2="32" y2="28"/>
              <line x1="16" y1="34" x2="26" y2="34"/>
            </svg>
          </div>
          <div class="blueprint-step__number">2</div>
          <div class="blueprint-step__content">
            <h2 class="blueprint-step__title">Benefits Report & Action Items</h2>
            <p class="blueprint-step__description">
              You receive a personalized 22-page federal benefits report with actionable steps
              based on your specific financial situation—not generic advice.
            </p>
            <div class="blueprint-step__areas">
              <h4>10 Critical Areas Covered:</h4>
              <div class="area-badges">
                <span class="area-badge">FERS/CSRS Pension</span>
                <span class="area-badge">Survivor Benefits</span>
                <span class="area-badge">TSP Strategy</span>
                <span class="area-badge">FEGLI Options</span>
                <span class="area-badge">FEHB Planning</span>
                <span class="area-badge">Medicare Coordination</span>
                <span class="area-badge">Social Security</span>
                <span class="area-badge">Sick Leave Credit</span>
                <span class="area-badge">Annual Leave Payout</span>
                <span class="area-badge">FLTCIP</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3: Partnership -->
        <div class="blueprint-step" data-animate="fade-in-up">
          <div class="blueprint-step__icon">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M16 18c-4 0-8 3-8 8v10h10v-6h12v6h10V26c0-5-4-8-8-8"/>
              <circle cx="16" cy="12" r="5"/>
              <circle cx="32" cy="12" r="5"/>
              <path d="M20 28h8" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="blueprint-step__number">3</div>
          <div class="blueprint-step__content">
            <h2 class="blueprint-step__title">Partnership</h2>
            <p class="blueprint-step__description">
              We're not a one-time transaction. You have ongoing access to your advisor for questions,
              annual reviews, and strategy adjustments throughout your career and retirement.
            </p>
            <div class="blueprint-step__details">
              <h4>Ongoing Support Includes:</h4>
              <ul>
                <li>Help completing action items from your report</li>
                <li>Annual benefit reviews and updates</li>
                <li>Strategy adjustments as laws change</li>
                <li>Direct access to David or Brennan</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Webinars Section -->
  <section class="section section--gray">
    <div class="container">
      <div class="webinar-promo" data-animate="fade-in-up">
        <div class="webinar-promo__content">
          <span class="eyebrow">Start Here</span>
          <h2 class="heading-lg">Federal Retirement Workshops</h2>
          <p>
            Our comprehensive 3-hour FERS webinars cover everything you need to understand
            your federal retirement benefits—pension calculations, TSP strategies, FEHB options,
            Medicare coordination, Social Security, and survivor benefits.
          </p>
          <p>
            <strong>Perfect for federal employees who want to:</strong>
          </p>
          <ul class="webinar-benefits">
            <li>Understand exactly how their pension is calculated</li>
            <li>Learn TSP investment strategies for different career stages</li>
            <li>Avoid costly FEHB-Medicare enrollment mistakes</li>
            <li>Optimize survivor benefit decisions</li>
          </ul>
          <a href="https://planwell.vercel.app/webinars" class="btn btn--primary btn--lg">
            Join a Free Webinar
          </a>
        </div>
        <div class="webinar-promo__visual">
          <div class="workshop-card">
            <div class="workshop-card__header">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
              <span>Virtual Workshop</span>
            </div>
            <h3>FERS Retirement Planning</h3>
            <p>3-Hour Comprehensive Webinar</p>
            <ul>
              <li>FERS Pension Deep Dive</li>
              <li>TSP Investment Strategies</li>
              <li>FEHB & Medicare</li>
              <li>Survivor Benefits</li>
              <li>Social Security Optimization</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--navy text-center">
    <div class="container">
      <div data-animate="fade-in-up">
        <h2 class="heading-lg">Ready to Get Your Blueprint?</h2>
        <p class="lead" style="color: var(--color-gray-300); max-width: 36rem; margin: 0 auto var(--space-8);">
          Start with our free workshop or schedule a personal consultation with our team.
        </p>
        <div class="flex justify-center gap-4" style="flex-wrap: wrap;">
          <a href="/book-call" class="btn btn--primary btn--lg">Contact Us</a>
          <a href="https://planwell.vercel.app/webinars" class="btn btn--white btn--lg">Join a Webinar</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .page-hero .lead {
    color: var(--color-gray-300);
    margin: 0 auto;
  }

  /* Blueprint Steps - Vertical Timeline */
  .blueprint-steps {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }

  /* Connecting line */
  .blueprint-steps::before {
    content: '';
    position: absolute;
    left: 60px;
    top: 80px;
    bottom: 80px;
    width: 3px;
    background: linear-gradient(to bottom, var(--color-gold), var(--color-navy));
    border-radius: 2px;
  }

  .blueprint-step {
    position: relative;
    padding-left: 160px;
    padding-bottom: var(--space-16);
  }

  .blueprint-step:last-child {
    padding-bottom: 0;
  }

  .blueprint-step__icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 120px;
    height: 120px;
    background: var(--color-white);
    border: 3px solid var(--color-gold);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-navy);
    z-index: 2;
    box-shadow: var(--shadow-lg);
  }

  .blueprint-step__icon svg {
    width: 48px;
    height: 48px;
  }

  .blueprint-step__number {
    position: absolute;
    left: 88px;
    top: 88px;
    width: 36px;
    height: 36px;
    background: var(--color-gold);
    color: var(--color-navy-dark);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    font-size: var(--text-lg);
    z-index: 3;
    box-shadow: var(--shadow-md);
  }

  .blueprint-step__content {
    padding-top: var(--space-4);
  }

  .blueprint-step__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
    color: var(--color-navy);
  }

  .blueprint-step__description {
    font-size: var(--text-lg);
    color: var(--color-gray-600);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  .blueprint-step__details {
    background: var(--color-gray-100);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-gold);
  }

  .blueprint-step__details h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
    color: var(--color-navy);
  }

  .blueprint-step__details ul {
    list-style: none;
  }

  .blueprint-step__details li {
    padding: var(--space-2) 0;
    padding-left: var(--space-6);
    position: relative;
    color: var(--color-gray-700);
  }

  .blueprint-step__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    background: var(--color-gold);
    border-radius: var(--radius-full);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 8l3 3 5-5' stroke='%23000d3e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Area Badges for Step 2 */
  .blueprint-step__areas h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-4);
    color: var(--color-navy);
  }

  .area-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .area-badge {
    background: var(--color-navy);
    color: var(--color-white);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Webinar Promo */
  .webinar-promo {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }

  .webinar-promo__content p {
    margin-bottom: var(--space-4);
    color: var(--color-gray-700);
    line-height: 1.7;
  }

  .webinar-benefits {
    list-style: none;
    margin-bottom: var(--space-6);
  }

  .webinar-benefits li {
    padding: var(--space-2) 0;
    padding-left: var(--space-6);
    position: relative;
    color: var(--color-gray-700);
  }

  .webinar-benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    background: var(--color-gold);
    border-radius: var(--radius-full);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 8l3 3 5-5' stroke='%23000d3e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-position: center;
    background-repeat: no-repeat;
  }

  .workshop-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-xl);
    border: 2px solid var(--color-gold);
  }

  .workshop-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-gold);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .workshop-card__header svg {
    width: 20px;
    height: 20px;
  }

  .workshop-card h3 {
    font-size: var(--text-xl);
    color: var(--color-navy);
    margin-bottom: var(--space-1);
  }

  .workshop-card > p {
    color: var(--color-gray-600);
    margin-bottom: var(--space-4);
  }

  .workshop-card ul {
    list-style: none;
  }

  .workshop-card li {
    padding: var(--space-2) 0;
    padding-left: var(--space-5);
    position: relative;
    color: var(--color-gray-700);
    font-size: var(--text-sm);
  }

  .workshop-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    background: var(--color-gold);
    border-radius: var(--radius-full);
  }

  @media (max-width: 900px) {
    .blueprint-steps::before {
      display: none;
    }

    .blueprint-step {
      padding-left: 0;
      padding-top: 140px;
    }

    .blueprint-step__icon {
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 100px;
    }

    .blueprint-step__icon svg {
      width: 40px;
      height: 40px;
    }

    .blueprint-step__number {
      left: calc(50% + 32px);
      top: 70px;
      width: 32px;
      height: 32px;
      font-size: var(--text-base);
    }

    .blueprint-step__content {
      text-align: center;
    }

    .blueprint-step__details {
      text-align: left;
    }

    .area-badges {
      justify-content: center;
    }

    .webinar-promo {
      grid-template-columns: 1fr;
    }

    .webinar-promo__visual {
      order: -1;
      max-width: 400px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .blueprint-step__icon {
      width: 80px;
      height: 80px;
    }

    .blueprint-step__icon svg {
      width: 32px;
      height: 32px;
    }

    .blueprint-step__number {
      left: calc(50% + 25px);
      top: 55px;
      width: 28px;
      height: 28px;
      font-size: var(--text-sm);
    }

    .area-badge {
      font-size: 10px;
      padding: var(--space-1) var(--space-3);
    }
  }
</style>
