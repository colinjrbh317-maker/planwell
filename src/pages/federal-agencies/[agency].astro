---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WebinarCTA from '../../components/WebinarCTA.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { agencies, getAgency } from '../../data/agencies';

export function getStaticPaths() {
  return agencies.map((a) => ({ params: { agency: a.slug } }));
}

const { agency: slug } = Astro.params;
const agency = getAgency(slug!);
if (!agency) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const relatedLinks = (agency.relatedAgencySlugs ?? [])
  .map((s) => getAgency(s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .map((a) => ({
    href: `/federal-agencies/${a.slug}`,
    title: `${a.name} Employees`,
    description: a.heroLead.slice(0, 140) + (a.heroLead.length > 140 ? '...' : ''),
  }));

relatedLinks.push({
  href: '/services/fers-retirement-planning',
  title: 'Our FERS Retirement Planning Service',
  description: 'One-on-one fee-based retirement planning for federal employees. Includes pension analysis, TSP allocation review, and tax projections.',
});
---

<BaseLayout
  title={agency.metaTitle}
  description={agency.metaDescription}
  canonical={`/federal-agencies/${agency.slug}`}
>
  <!-- Hero -->
  <section class="agency-hero">
    <div class="container">
      <span class="eyebrow">{agency.heroEyebrow}</span>
      <h1 class="heading-xl">{agency.heroHeading}</h1>
      <p class="lead">{agency.heroLead}</p>
      <div class="agency-hero__cta">
        <WebinarCTA variant="hero" />
      </div>
      <p class="agency-hero__meta">{agency.employeeCount}</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="container container--narrow">
      <div class="prose" set:html={agency.introHtml} />
    </div>
  </section>

  <!-- Why it matters -->
  <section class="section section--gray">
    <div class="container container--narrow">
      <h2 class="heading-lg mb-6">Why FERS planning matters more for {agency.shortName} civilians</h2>
      <div class="prose" set:html={agency.whyMattersHtml} />
    </div>
  </section>

  <!-- Unique considerations -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">What makes {agency.shortName} retirement planning different</h2>
      <div class="considerations-grid">
        {agency.uniqueConsiderations.map((item) => (
          <div class="consideration-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      {agency.specialProvisionsNote && (
        <div class="special-note">
          <strong>Special provisions:</strong> {agency.specialProvisionsNote}
          <p class="mt-4"><a href="/leo-atc-fers-special-provision-retirement-calculator" class="underline-link">Run a special-provision estimate</a></p>
        </div>
      )}
    </div>
  </section>

  <!-- Common jobs + locations -->
  <section class="section section--gray">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Who we work with at {agency.shortName}</h2>
      <div class="employers-grid">
        <div class="employer-card">
          <h3>Common positions</h3>
          <ul>
            {agency.commonJobs.map((job) => <li>{job}</li>)}
          </ul>
        </div>
        <div class="employer-card">
          <h3>Primary duty locations</h3>
          <ul>
            {agency.primaryLocations.map((loc) => <li>{loc}</li>)}
          </ul>
        </div>
        <div class="employer-card">
          <h3>Common questions we hear</h3>
          <div class="prose prose--sm" set:html={agency.commonQuestionsHtml} />
        </div>
      </div>
    </div>
  </section>

  <!-- Webinar CTA -->
  <WebinarCTA variant="section" audienceLabel={`${agency.shortName} Employees`} />

  <!-- FAQ -->
  <FAQSchema questions={agency.faq} heading={`${agency.shortName} Retirement FAQs`} />

  <!-- Related links -->
  {relatedLinks.length > 0 && <RelatedLinks heading="Related resources" links={relatedLinks} />}

  <!-- Bottom CTA banner -->
  <WebinarCTA
    variant="banner"
    heading="Ready to plan your federal retirement?"
    subheading={`Join ${agency.shortName} civilians who have taken control of their retirement with expert, fee-based guidance.`}
  />
</BaseLayout>

<style>
  .agency-hero { padding: var(--space-16) 0; background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%); color: var(--color-white); }
  .agency-hero h1 { color: var(--color-white); margin-bottom: var(--space-4); max-width: 900px; }
  .agency-hero .lead { color: var(--color-gray-300); margin-bottom: var(--space-8); max-width: 800px; }
  .agency-hero__cta { margin-bottom: var(--space-6); }
  .agency-hero__meta { color: var(--color-gold); font-weight: var(--font-semibold); font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.08em; }
  .agency-hero .eyebrow { color: var(--color-gold); }

  .container--narrow { max-width: 820px; }
  .prose p { margin-bottom: var(--space-4); color: var(--color-gray-700); line-height: 1.7; font-size: var(--text-base); }
  .prose--sm p { font-size: var(--text-sm); }

  .considerations-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); max-width: 1000px; margin: 0 auto; }
  .consideration-card { background: var(--color-gray-100); padding: var(--space-6); border-radius: var(--radius-lg); border-left: 4px solid var(--color-gold); }
  .consideration-card h3 { color: var(--color-navy); font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .consideration-card p { color: var(--color-gray-700); line-height: 1.6; }

  .special-note { margin-top: var(--space-10); max-width: 820px; margin-left: auto; margin-right: auto; background: var(--color-navy); color: var(--color-white); padding: var(--space-6); border-radius: var(--radius-lg); }
  .special-note strong { color: var(--color-gold); }
  .special-note .underline-link { color: var(--color-gold); text-decoration: underline; font-weight: var(--font-semibold); }

  .employers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .employer-card { background: var(--color-white); padding: var(--space-8); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .employer-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-navy); }
  .employer-card ul { list-style: none; padding: 0; }
  .employer-card li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-gray-200); color: var(--color-gray-700); font-size: var(--text-sm); }
  .employer-card li:last-child { border-bottom: none; }

  @media (max-width: 1024px) { .considerations-grid, .employers-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .considerations-grid, .employers-grid { grid-template-columns: 1fr; } }
</style>
