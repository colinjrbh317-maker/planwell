---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WebinarCTA from '../../components/WebinarCTA.astro';
import { agencies } from '../../data/agencies';
---

<BaseLayout
  title="FERS Retirement Planning by Federal Agency"
  description="PlanWell helps civilian employees at every major federal agency plan their FERS retirement. Find guidance tailored to your agency: DoD, VA, DHS, USPS, IRS, and more."
  canonical="/federal-agencies"
>
  <section class="hub-hero">
    <div class="container">
      <span class="eyebrow">Agency-Specific Planning</span>
      <h1 class="heading-xl">FERS Retirement Planning by Federal Agency</h1>
      <p class="lead">Every agency has its quirks: how it handles military service credit, which buyout authorities apply, whether special provisions cover your job series. Pick your agency to see how PlanWell helps.</p>
      <WebinarCTA variant="hero" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Agencies we work with</h2>
      <div class="agency-grid">
        {agencies.map((a) => (
          <a href={`/federal-agencies/${a.slug}`} class="agency-tile">
            <h3 class="agency-tile__name">{a.name}</h3>
            <p class="agency-tile__meta">{a.employeeCount}</p>
            <p class="agency-tile__desc">{a.heroLead.slice(0, 160)}...</p>
            <span class="agency-tile__cta">See agency page</span>
          </a>
        ))}
      </div>
      <p class="text-center mt-8" style="color: var(--color-gray-600);">
        Do not see your agency? FERS rules are the same across the civilian federal government. <a href="/federal-retirement-webinars" style="color: var(--color-gold); text-decoration: underline;">Attend a free workshop</a> and bring your questions.
      </p>
    </div>
  </section>

  <WebinarCTA variant="banner" heading="Free 3-hour FERS workshop" subheading="Whatever your agency, the retirement math is the same. Come learn it." />
</BaseLayout>

<style>
  .hub-hero { padding: var(--space-16) 0; background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%); color: var(--color-white); }
  .hub-hero h1 { color: var(--color-white); margin-bottom: var(--space-4); }
  .hub-hero .lead { color: var(--color-gray-300); margin-bottom: var(--space-8); max-width: 820px; }
  .hub-hero .eyebrow { color: var(--color-gold); }
  .agency-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .agency-tile { display: block; background: var(--color-gray-100); padding: var(--space-6); border-radius: var(--radius-lg); text-decoration: none; transition: all var(--transition-base); border: 1px solid transparent; }
  .agency-tile:hover { border-color: var(--color-gold); background: var(--color-white); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .agency-tile__name { color: var(--color-navy); font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .agency-tile__meta { color: var(--color-gold); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-3); font-weight: var(--font-semibold); }
  .agency-tile__desc { color: var(--color-gray-700); font-size: var(--text-sm); line-height: 1.6; margin-bottom: var(--space-4); }
  .agency-tile__cta { color: var(--color-gold); font-weight: var(--font-semibold); font-size: var(--text-sm); }
  .agency-tile__cta::after { content: ' \2192'; }
  @media (max-width: 1024px) { .agency-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .agency-grid { grid-template-columns: 1fr; } }
</style>
