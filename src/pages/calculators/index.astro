---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="FERS Retirement Calculators | PlanWell Financial Planning"
  description="Free federal retirement calculators for FERS pension estimates, TSP projections, Special Provisions (LEO/ATC), and more."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Financial Tools</span>
      <h1 class="heading-xl">Federal Retirement Calculators</h1>
      <p class="lead max-w-3xl">
        Get quick estimates for your FERS pension, TSP growth, and Special Provision benefits. 
        Start planning your exit strategy today.
      </p>
    </div>
  </section>
  
  <!-- Calculator Directory -->
  <section class="section">
    <div class="container">
      <div class="calculator-grid">
        
        <!-- FERS Pension -->
        <a href="/fers-retirement-calculator" class="calc-card" data-animate="fade-in-up">
          <div class="calc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h3 class="heading-sm">FERS Pension Calculator</h3>
          <p>Estimate your standard FERS Basic Annuity based on your High-3 salary and years of service.</p>
          <span class="btn-link">Calculate Pension &rarr;</span>
        </a>
        
        <!-- Special Provision -->
        <a href="/leo-atc-fers-special-provision-retirement-calculator" class="calc-card" data-animate="fade-in-up" style="animation-delay: 0.1s;">
          <div class="calc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <h3 class="heading-sm">Special Provision (LEO/ATC)</h3>
          <p>For Law Enforcement, Air Traffic Controllers, and Firefighters. Calculates 1.7% enhanced benefit.</p>
          <span class="btn-link">Calculate LEO/ATC &rarr;</span>
        </a>
        
        <!-- TSP Growth -->
        <a href="/thrift-savings-plan-calculator-tsp-calculator" class="calc-card" data-animate="fade-in-up" style="animation-delay: 0.2s;">
          <div class="calc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
            </svg>
          </div>
          <h3 class="heading-sm">TSP Growth Calculator</h3>
          <p>Project your ending TSP balance and see the power of compound interest over time.</p>
          <span class="btn-link">Project TSP &rarr;</span>
        </a>

        <!-- High-3 Salary -->
        <a href="/high-3-calculator" class="calc-card" data-animate="fade-in-up" style="animation-delay: 0.3s;">
          <div class="calc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 6h7.5v2.25h-7.5V6ZM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.65 4.5 4.757V19.5a2.25 2.25 0 0 0 2.25 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25V4.757c0-1.108-.806-2.057-1.907-2.185A48.507 48.507 0 0 0 12 2.25Z" />
            </svg>
          </div>
          <h3 class="heading-sm">High-3 Salary Calculator</h3>
          <p>Calculate your highest 36 consecutive months of salary using a weighted average approach.</p>
          <span class="btn-link">Calculate High-3 &rarr;</span>
        </a>

        <!-- Sick Leave Conversion -->
        <a href="/fers-sick-leave-conversion-chart" class="calc-card" data-animate="fade-in-up" style="animation-delay: 0.4s;">
          <div class="calc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h3 class="heading-sm">Sick Leave Conversion</h3>
          <p>Convert unused sick leave hours to service credit for your FERS pension using the official USGS chart.</p>
          <span class="btn-link">Convert Sick Leave &rarr;</span>
        </a>

        <!-- Special Retirement Supplement -->
        <a href="/fers-supplement-calculator" class="calc-card" data-animate="fade-in-up" style="animation-delay: 0.5s;">
          <div class="calc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
            </svg>
          </div>
          <h3 class="heading-sm">Special Retirement Supplement</h3>
          <p>Estimate your monthly supplement for retiring before age 62 under FERS (replaces Social Security until 62).</p>
          <span class="btn-link">Calculate Supplement &rarr;</span>
        </a>

      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="section section--navy text-center">
    <div class="container">
      <div data-animate="fade-in-up">
        <h2 class="heading-lg">Need More Than a Calculator?</h2>
        <p class="lead" style="color: var(--color-gray-300); max-width: 36rem; margin: 0 auto var(--space-8);">
          Retirement isn't just about the math. It's about taxes, timing, and peace of mind. 
          Get a comprehensive Benefits Report showing your exact numbers.
        </p>
        <div class="flex justify-center gap-4" style="flex-wrap: wrap;">
          <a href="/webinar" class="btn btn--primary btn--lg">Free FERS Workshop</a>
          <a href="/book-call" class="btn btn--white btn--lg">Book a Strategy Call</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
  }
  
  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }
  
  .page-hero .lead {
    color: var(--color-gray-300);
    margin: 0 auto;
  }
  
  .calculator-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .calc-card {
    background: var(--color-white);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-200);
    text-decoration: none;
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .calc-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-xl);
    border-color: var(--color-navy);
  }
  
  .calc-card__icon {
    width: 64px;
    height: 64px;
    background: var(--color-gray-100);
    color: var(--color-navy);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
    transition: all var(--transition-normal);
  }
  
  .calc-card__icon svg {
    width: 32px;
    height: 32px;
  }
  
  .calc-card:hover .calc-card__icon {
    background: var(--color-navy);
    color: var(--color-white);
  }
  
  .calc-card h3 {
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }
  
  .calc-card p {
    color: var(--color-gray-600);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }
  
  .btn-link {
    margin-top: auto;
    font-weight: var(--font-semibold);
    color: var(--color-navy);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  
  .calc-card:hover .btn-link {
    color: var(--color-gold);
  }
</style>
