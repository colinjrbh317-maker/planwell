---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WebinarCTA from '../../components/WebinarCTA.astro';
import FAQSchema from '../../components/FAQSchema.astro';

const faqs = [
  {
    q: 'Do Philadelphia federal employees have access to FERS retirement workshops?',
    a: 'Yes. PlanWell runs free virtual FERS retirement workshops that IRS Philadelphia campus employees, SSA Northeast program staff, and VA Medical Center workers attend regularly. Sessions are 3 hours and cover your pension calculation, TSP, FEHB, and Social Security coordination.',
  },
  {
    q: 'How does the FERS high-3 calculation work for IRS Philadelphia employees?',
    a: 'Your high-3 is the average of your three consecutive highest-earning years. For most IRS Philadelphia campus employees those years come right before retirement. A $5,000 salary difference in your final years can shift your annuity by over $1,500 annually. Our workshops walk through the exact math.',
  },
  {
    q: 'I work at the Philadelphia Mint. When can I retire under FERS?',
    a: 'Under standard FERS you can retire at your Minimum Retirement Age (MRA) with 30 years of creditable service, or at 60 with 20 years, or at 62 with 5 years. If you have law enforcement or special provisions designation, different rules apply. Our CFP professionals clarify your specific MRA based on your Service Computation Date.',
  },
  {
    q: 'What happens to my FEHB coverage when I retire from the Navy Yard or another Philadelphia federal agency?',
    a: 'You keep FEHB in retirement if you were enrolled for the 5 years immediately before retirement. Your agency share of the premium continues in retirement. This is one of the most valuable parts of a federal retirement package and our workshops cover how to compare plan options at your retirement date.',
  },
  {
    q: 'Is PlanWell fee-based or do advisors earn commissions?',
    a: 'PlanWell is a fee-based fiduciary firm. Our CFP professionals are paid directly by clients, not through product commissions. That means our recommendations on TSP allocation, FEGLI coverage, and annuity timing are based solely on what fits your situation.',
  },
];
---

<BaseLayout
  title="Federal Retirement Planning in Philadelphia, Pennsylvania"
  description="Expert FERS retirement planning for federal employees in Philadelphia. Serving IRS Philadelphia campus, SSA Northeast, VA Medical Center, and Navy Yard workers. Free workshop available."
  canonical="/locations/philadelphia"
>
  <!-- Hero Section -->
  <section class="location-hero">
    <div class="container">
      <div class="location-hero__content-centered">
        <span class="eyebrow">Philadelphia, Pennsylvania</span>
        <h1 class="heading-xl">Federal Retirement Planning in Philadelphia</h1>
        <p class="lead">
          One of the largest federal employment hubs on the East Coast. From the IRS campus in Northeast Philly to the historic Navy Yard, we help Philadelphia federal employees build a retirement plan that reflects years of creditable service.
        </p>
        <div class="location-hero__cta">
          <a href="/federal-retirement-webinars" class="btn btn--primary btn--lg">Free FERS Workshop</a>
          <a href="/book-call" class="btn btn--white btn--lg">Schedule Consultation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Section -->
  <section class="section section--gray">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Service Areas in the Philadelphia Region</h2>
      <div class="service-areas">
        <div class="service-area">
          <h3>Northeast Philadelphia</h3>
          <p>Bustleton, Somerton, Fox Chase, Rhawnhurst</p>
        </div>
        <div class="service-area">
          <h3>South Philadelphia &amp; Navy Yard</h3>
          <p>South Philly, Point Breeze, Pennsport, League Island</p>
        </div>
        <div class="service-area">
          <h3>Delaware County</h3>
          <p>Upper Darby, Springfield, Media, Chester</p>
        </div>
        <div class="service-area">
          <h3>Montgomery &amp; Bucks Counties</h3>
          <p>Lansdale, Horsham, Doylestown, Willow Grove</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Major Employers Section -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Major Federal Employers We Serve</h2>
      <div class="employers-grid">
        <div class="employer-card">
          <h3>Revenue &amp; Benefits</h3>
          <ul>
            <li>IRS Philadelphia Submission Processing Campus</li>
            <li>SSA Northeastern Program Service Center</li>
            <li>Social Security Administration field offices</li>
            <li>Federal Reserve Bank of Philadelphia</li>
            <li>U.S. Mint Philadelphia</li>
          </ul>
        </div>
        <div class="employer-card">
          <h3>Defense &amp; Veterans</h3>
          <ul>
            <li>Philadelphia Navy Yard (NAVSUP, NSWCDD)</li>
            <li>Defense Logistics Agency Philadelphia</li>
            <li>VA Medical Center Philadelphia</li>
            <li>VA Medical Center Wilmington (nearby)</li>
            <li>Army Corps of Engineers Philadelphia District</li>
          </ul>
        </div>
        <div class="employer-card">
          <h3>Regional Agencies</h3>
          <ul>
            <li>EPA Region 3 (Mid-Atlantic)</li>
            <li>HHS Region 3</li>
            <li>GSA Mid-Atlantic Region</li>
            <li>FEMA Region 3</li>
            <li>FBI Philadelphia Field Office</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <WebinarCTA variant="section" audienceLabel="Philadelphia Federal Employees" />

  <!-- Directions Section -->
  <section class="section section--navy">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Serving Philadelphia Federal Workers Virtually</h2>
      <p class="text-center lead mb-8" style="color: var(--color-gray-300);">
        Whether you commute via SEPTA, drive I-95 to the Navy Yard, or take Route 1 to the IRS campus, our virtual workshops mean you attend from your desk or home.
      </p>
      <div class="directions-grid">
        <div class="direction-card">
          <h3>From IRS Northeast Campus</h3>
          <p>Located at 2970 Market Street and the Northeast campus on Roosevelt Blvd. SEPTA Regional Rail or I-95 are the main commute options. No travel needed for our virtual sessions.</p>
        </div>
        <div class="direction-card">
          <h3>From the Navy Yard</h3>
          <p>Accessible via I-95 South or the SEPTA Broad Street Line to AT&amp;T Station. Defense workers across the Yard attend our free workshops without leaving the base.</p>
        </div>
        <div class="direction-card">
          <h3>From Suburban Counties</h3>
          <p>Montgomery, Bucks, Delaware, and Chester County federal workers join via Zoom from home. All sessions are recorded for convenience if you need to attend another session.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Why Philadelphia Federal Employees Choose PlanWell</h2>
      <div class="comparison-grid">
        <div class="comparison-card comparison-card--highlight">
          <h3>PlanWell Financial Planning</h3>
          <ul class="comparison-list">
            <li class="comparison-list__item comparison-list__item--pro">Certified Financial Planners (CFP®)</li>
            <li class="comparison-list__item comparison-list__item--pro">ChFEBC℠ Federal Benefits Specialists</li>
            <li class="comparison-list__item comparison-list__item--pro">Fee-Based Fiduciary</li>
            <li class="comparison-list__item comparison-list__item--pro">Free 3-Hour FERS Workshop</li>
            <li class="comparison-list__item comparison-list__item--pro">IRS &amp; SSA Employee Experience</li>
            <li class="comparison-list__item comparison-list__item--pro">Eastern Time Zone Availability</li>
          </ul>
        </div>
        <div class="comparison-card">
          <h3>Many Philadelphia Advisors</h3>
          <ul class="comparison-list">
            <li class="comparison-list__item comparison-list__item--con">General financial credentials typical</li>
            <li class="comparison-list__item comparison-list__item--con">Limited FERS pension knowledge</li>
            <li class="comparison-list__item comparison-list__item--con">Commission-based product sales</li>
            <li class="comparison-list__item comparison-list__item--con">No federal-specific workshops</li>
            <li class="comparison-list__item comparison-list__item--con">Often non-federal-specific advice</li>
            <li class="comparison-list__item comparison-list__item--con">Unfamiliar with TSP and FEHB rules</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQSchema questions={faqs} heading="Philadelphia Federal Retirement FAQs" />

  <WebinarCTA
    variant="banner"
    heading="Ready to Plan Your Federal Retirement in Philadelphia?"
    subheading="Join Philadelphia federal employees who have taken control of their FERS pension, TSP, and FEHB decisions with guidance from a CFP who knows federal benefits."
  />
</BaseLayout>

<style>
  .location-hero { padding: var(--space-16) 0; background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%); color: var(--color-white); }
  .location-hero__content-centered { max-width: 780px; margin: 0 auto; text-align: center; }
  .location-hero h1 { color: var(--color-white); margin-bottom: var(--space-4); }
  .location-hero .lead { color: var(--color-gray-300); margin-bottom: var(--space-8); }
  .location-hero__cta { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; }

  .service-areas { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .service-area { background: var(--color-white); padding: var(--space-6); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .service-area h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .service-area p { color: var(--color-gray-600); font-size: var(--text-sm); }

  .employers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .employer-card { background: var(--color-gray-100); padding: var(--space-8); border-radius: var(--radius-lg); }
  .employer-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-navy); }
  .employer-card ul { list-style: none; padding: 0; }
  .employer-card li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-gray-200); color: var(--color-gray-700); }
  .employer-card li:last-child { border-bottom: none; }

  .directions-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .direction-card { background: rgba(255, 255, 255, 0.1); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid rgba(255, 255, 255, 0.2); }
  .direction-card h3 { color: var(--color-gold); font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .direction-card p { color: var(--color-gray-300); font-size: var(--text-sm); }

  .comparison-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); max-width: 900px; margin: 0 auto; }
  .comparison-card { background: var(--color-gray-100); padding: var(--space-8); border-radius: var(--radius-lg); }
  .comparison-card--highlight { background: var(--color-navy); color: var(--color-white); }
  .comparison-card--highlight h3 { color: var(--color-gold); }
  .comparison-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-6); text-align: center; }
  .comparison-list { list-style: none; padding: 0; }
  .comparison-list__item { padding: var(--space-3) 0; padding-left: var(--space-8); position: relative; font-size: var(--text-sm); }
  .comparison-list__item::before { position: absolute; left: 0; font-size: var(--text-lg); }
  .comparison-list__item--pro::before { content: "✓"; color: var(--color-gold); }
  .comparison-list__item--con::before { content: "✗"; color: var(--color-error); }

  @media (max-width: 1024px) { .service-areas { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .service-areas, .employers-grid, .directions-grid, .comparison-grid { grid-template-columns: 1fr; } }
</style>
