---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import locationImage from '../../assets/locations/denver.png';
import WebinarCTA from '../../components/WebinarCTA.astro';
import FAQSchema from '../../components/FAQSchema.astro';

const faqs = [
  {
    q: 'Are there federal retirement workshops in Denver?',
    a: 'Yes. PlanWell offers free virtual FERS retirement workshops that Denver and Colorado federal employees can attend from anywhere. Our 3-hour sessions cover the FERS pension, TSP, FEHB, FEGLI, and Social Security coordination. Denver Federal Center, NOAA, and BLM employees attend regularly.',
  },
  {
    q: 'How do I register for a federal retirement webinar?',
    a: 'Visit planwellfp.com/federal-retirement-webinars to see all upcoming dates and register for a free session. Workshops are held via Zoom and run approximately 3 hours. No travel required from your Denver office or home.',
  },
  {
    q: "Is PlanWell's workshop specific to Denver federal employees?",
    a: "Our workshops cover FERS benefits that apply to all federal employees nationwide. Whether you work at the Denver Federal Center in Lakewood, NOAA in Boulder, or Peterson Space Force Base in Colorado Springs, the FERS retirement system works the same way. Our CFP\u00ae professionals answer questions specific to your situation during the live Q&A.",
  },
];
---

<BaseLayout
  title="Federal Retirement Planning in Denver, Colorado"
  description="Expert FERS retirement planning for federal employees in Denver and Colorado. Serving Denver Federal Center, NOAA, and Colorado federal agencies. Free workshop available."
>
  <!-- Hero Section -->
  <section class="location-hero">
    <div class="container">
      <div class="location-hero__grid">
        <div class="location-hero__content">
          <span class="eyebrow">Denver, Colorado</span>
          <h1 class="heading-xl">Federal Retirement Planning in Denver</h1>
          <p class="lead">
            Colorado's federal hub. From the Denver Federal Center to NOAA,
            we help Rocky Mountain federal employees plan for the retirement they deserve.
          </p>
          <div class="location-hero__cta">
            <WebinarCTA variant="hero" />
          </div>
        </div>
        <div class="location-hero__image">
          <Image
            src={locationImage}
            alt="Denver skyline with Rocky Mountains"
            width={600}
            height={400}
            format="webp"
            quality={85}
            class="location-hero__img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Section -->
  <section class="section section--gray">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Service Areas in Colorado</h2>
      <div class="service-areas">
        <div class="service-area">
          <h3>Metro Denver</h3>
          <p>Downtown Denver, Lakewood, Aurora, Englewood</p>
        </div>
        <div class="service-area">
          <h3>Boulder Area</h3>
          <p>Boulder, Broomfield, Louisville, Lafayette</p>
        </div>
        <div class="service-area">
          <h3>Colorado Springs</h3>
          <p>Peterson AFB, Schriever SFB, Fort Carson</p>
        </div>
        <div class="service-area">
          <h3>Surrounding Areas</h3>
          <p>Fort Collins, Golden, Arvada, Westminster</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Major Employers Section -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Major Federal Employers We Serve</h2>
      <div class="employers-grid">
        <div class="employer-card">
          <h3>Denver Federal Center</h3>
          <ul>
            <li>Bureau of Land Management</li>
            <li>U.S. Geological Survey</li>
            <li>Bureau of Reclamation</li>
            <li>General Services Administration</li>
            <li>Fish and Wildlife Service</li>
          </ul>
        </div>
        <div class="employer-card">
          <h3>Science & Research</h3>
          <ul>
            <li>NOAA Earth System Research Lab</li>
            <li>National Renewable Energy Lab</li>
            <li>NIST Boulder Labs</li>
            <li>USDA Research Facilities</li>
            <li>EPA Region 8</li>
          </ul>
        </div>
        <div class="employer-card">
          <h3>Military & Defense</h3>
          <ul>
            <li>Buckley Space Force Base</li>
            <li>Peterson Space Force Base</li>
            <li>NORAD (Cheyenne Mountain)</li>
            <li>U.S. Space Command</li>
            <li>Fort Carson</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <WebinarCTA variant="section" audienceLabel="Denver Federal Employees" />

  <!-- Directions Section -->
  <section class="section section--navy">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Getting to Our Workshops</h2>
      <p class="text-center lead mb-8" style="color: var(--color-gray-300);">
        Virtual workshops make distance no barrier for federal employees across Colorado.
      </p>
      <div class="directions-grid">
        <div class="direction-card">
          <h3>From Denver Federal Center</h3>
          <p>Located in Lakewood off 6th Avenue. Easy access via I-70 or US-6. All workshops available virtually.</p>
        </div>
        <div class="direction-card">
          <h3>From Boulder</h3>
          <p>Take US-36 or Flatiron Flyer bus. Our virtual workshops are perfect for NOAA and NIST employees.</p>
        </div>
        <div class="direction-card">
          <h3>From Colorado Springs</h3>
          <p>I-25 North to Denver or join us virtually from Peterson, Schriever, or Fort Carson.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Why Colorado Federal Employees Choose PlanWell</h2>
      <div class="comparison-grid">
        <div class="comparison-card comparison-card--highlight">
          <h3>PlanWell Financial Planning</h3>
          <ul class="comparison-list">
            <li class="comparison-list__item comparison-list__item--pro">Certified Financial Planners (CFP®)</li>
            <li class="comparison-list__item comparison-list__item--pro">ChFEBC℠ Federal Benefits Specialists</li>
            <li class="comparison-list__item comparison-list__item--pro">Fee-Based Fiduciary</li>
            <li class="comparison-list__item comparison-list__item--pro">Free 3-Hour FERS Workshop</li>
            <li class="comparison-list__item comparison-list__item--pro">Experience with Land Management Agencies</li>
            <li class="comparison-list__item comparison-list__item--pro">Mountain Time Zone Availability</li>
          </ul>
        </div>
        <div class="comparison-card">
          <h3>Many Denver Advisors</h3>
          <ul class="comparison-list">
            <li class="comparison-list__item comparison-list__item--con">General financial credentials typical</li>
            <li class="comparison-list__item comparison-list__item--con">Limited FERS understanding</li>
            <li class="comparison-list__item comparison-list__item--con">Often commission-compensated</li>
            <li class="comparison-list__item comparison-list__item--con">No federal-specific workshops</li>
            <li class="comparison-list__item comparison-list__item--con">Often non-federal-specific advice</li>
            <li class="comparison-list__item comparison-list__item--con">Limited federal client base</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQSchema questions={faqs} heading="Denver Federal Retirement FAQs" />

  <WebinarCTA
    variant="banner"
    heading="Ready to plan your federal retirement?"
    subheading="Join Denver federal employees who have taken control of their retirement with expert guidance."
  />
</BaseLayout>

<style>
  .location-hero { padding: var(--space-16) 0; background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%); color: var(--color-white); }
  .location-hero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
  .location-hero h1 { color: var(--color-white); margin-bottom: var(--space-4); }
  .location-hero .lead { color: var(--color-gray-300); margin-bottom: var(--space-8); }
  .location-hero__cta { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .location-hero__img { border-radius: var(--radius-xl); box-shadow: var(--shadow-xl); }

  .service-areas { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .service-area { background: var(--color-white); padding: var(--space-6); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .service-area h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .service-area p { color: var(--color-gray-600); font-size: var(--text-sm); }

  .employers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .employer-card { background: var(--color-gray-100); padding: var(--space-8); border-radius: var(--radius-lg); }
  .employer-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-navy); }
  .employer-card ul { list-style: none; padding: 0; }
  .employer-card li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-gray-200); color: var(--color-gray-700); }
  .employer-card li:last-child { border-bottom: none; }

  .directions-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .direction-card { background: rgba(255, 255, 255, 0.1); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid rgba(255, 255, 255, 0.2); }
  .direction-card h3 { color: var(--color-gold); font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .direction-card p { color: var(--color-gray-300); font-size: var(--text-sm); }

  .comparison-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); max-width: 900px; margin: 0 auto; }
  .comparison-card { background: var(--color-gray-100); padding: var(--space-8); border-radius: var(--radius-lg); }
  .comparison-card--highlight { background: var(--color-navy); color: var(--color-white); }
  .comparison-card--highlight h3 { color: var(--color-gold); }
  .comparison-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-6); text-align: center; }
  .comparison-list { list-style: none; padding: 0; }
  .comparison-list__item { padding: var(--space-3) 0; padding-left: var(--space-8); position: relative; font-size: var(--text-sm); }
  .comparison-list__item::before { position: absolute; left: 0; font-size: var(--text-lg); }
  .comparison-list__item--pro::before { content: "✓"; color: var(--color-gold); }
  .comparison-list__item--con::before { content: "✗"; color: var(--color-error); }

  @media (max-width: 1024px) { .service-areas { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .location-hero__grid, .service-areas, .employers-grid, .directions-grid, .comparison-grid { grid-template-columns: 1fr; } }
</style>
