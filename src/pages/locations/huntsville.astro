---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WebinarCTA from '../../components/WebinarCTA.astro';
import FAQSchema from '../../components/FAQSchema.astro';

const faqs = [
  {
    q: 'Are there FERS retirement workshops for Huntsville federal employees?',
    a: 'Yes. PlanWell offers free 3-hour virtual FERS retirement workshops that NASA Marshall, Army Materiel Command, Missile Defense Agency, and Redstone Arsenal employees can attend from anywhere in the Tennessee Valley. Sessions cover your FERS pension, TSP, FEHB, and survivor benefits.',
  },
  {
    q: 'Do you work with NASA and Army civilian employees at Redstone Arsenal?',
    a: 'Absolutely. Our Certified Financial Planners hold the ChFEBC designation and have extensive experience with NASA engineers, Army civilians, and defense contractor-turned-federal employees at Redstone Arsenal and Cummings Research Park. We understand the unique FERS benefits for technical and scientific positions.',
  },
  {
    q: 'How is PlanWell different from Huntsville financial advisors?',
    a: "PlanWell advisors are fee-based fiduciaries who specialize exclusively in federal employee retirement. We provide a free 22-page personalized benefits report and understand the unique retirement considerations for Huntsville's large GS-13+ engineering and scientific workforce.",
  },
];
---

<BaseLayout
  title="Federal Retirement Planning in Huntsville, Alabama"
  description="Expert FERS retirement planning for NASA Marshall, Army Materiel Command, Missile Defense Agency, and Redstone Arsenal employees in Huntsville. Free virtual workshop available."
>
  <!-- Hero Section -->
  <section class="location-hero">
    <div class="container">
      <div class="location-hero__content" style="text-align: center; max-width: 700px; margin: 0 auto;">
        <span class="eyebrow">Huntsville, Alabama</span>
        <h1 class="heading-xl">Federal Retirement Planning in Huntsville</h1>
        <p class="lead">
          Rocket City USA. Expert FERS retirement guidance for NASA Marshall,
          Army Materiel Command, and Redstone Arsenal's federal workforce.
        </p>
        <div class="location-hero__cta" style="justify-content: center;">
          <WebinarCTA variant="hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Section -->
  <section class="section section--gray">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Service Areas in Huntsville</h2>
      <div class="service-areas">
        <div class="service-area">
          <h3>Redstone Arsenal</h3>
          <p>NASA Marshall, AMC HQ, MDA, AMCOM, PEO Aviation & Missiles</p>
        </div>
        <div class="service-area">
          <h3>Cummings Research Park</h3>
          <p>FBI Huntsville, SAIC, Dynetics, defense contractors, SMDC</p>
        </div>
        <div class="service-area">
          <h3>Madison</h3>
          <p>Madison City, Limestone County, Research Park Boulevard corridor</p>
        </div>
        <div class="service-area">
          <h3>Decatur</h3>
          <p>Decatur, Athens, Morgan County, Wheeler National Wildlife Refuge</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Major Employers Section -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Major Federal Employers We Serve</h2>
      <div class="employers-grid">
        <div class="employer-card">
          <h3>Space & Missile Programs</h3>
          <ul>
            <li>NASA Marshall Space Flight Center</li>
            <li>Missile Defense Agency (MDA)</li>
            <li>Aviation and Missile Command (AMCOM)</li>
            <li>Space and Missile Defense Command</li>
            <li>PEO Missiles and Space</li>
          </ul>
        </div>
        <div class="employer-card">
          <h3>Army & Defense</h3>
          <ul>
            <li>Army Materiel Command (AMC) HQ</li>
            <li>Army Contracting Command</li>
            <li>Security Assistance Command</li>
            <li>Test and Evaluation Command</li>
            <li>Chemical Materials Activity</li>
          </ul>
        </div>
        <div class="employer-card">
          <h3>Other Federal Agencies</h3>
          <ul>
            <li>FBI Huntsville Operations</li>
            <li>Defense Intelligence Agency</li>
            <li>Army Corps of Engineers</li>
            <li>VA Tennessee Valley Healthcare</li>
            <li>U.S. Patent and Trademark Office (Satellite)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <WebinarCTA variant="section" audienceLabel="Huntsville Federal Employees" />

  <!-- Directions Section -->
  <section class="section section--navy">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Getting to Our Workshops</h2>
      <p class="text-center lead mb-8" style="color: var(--color-gray-300);">
        All workshops are virtual via Zoom. No Gate 9 traffic required.
      </p>
      <div class="directions-grid">
        <div class="direction-card">
          <h3>From Redstone Arsenal</h3>
          <p>Join our virtual workshops during lunch or after your shift. No need to leave the Arsenal or wait in gate traffic.</p>
        </div>
        <div class="direction-card">
          <h3>From Cummings Research Park</h3>
          <p>Attend from your office or home in Madison, Hampton Cove, or Jones Valley. Our virtual format fits engineering schedules.</p>
        </div>
        <div class="direction-card">
          <h3>Virtual Option</h3>
          <p>All workshops delivered via Zoom on Central Time. From Decatur to Athens to Fayetteville, attend from anywhere in the Tennessee Valley.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Why Huntsville Federal Employees Choose PlanWell</h2>
      <div class="comparison-grid">
        <div class="comparison-card comparison-card--highlight">
          <h3>PlanWell Financial Planning</h3>
          <ul class="comparison-list">
            <li class="comparison-list__item comparison-list__item--pro">Certified Financial Planners (CFP®)</li>
            <li class="comparison-list__item comparison-list__item--pro">ChFEBC℠ Federal Benefits Specialists</li>
            <li class="comparison-list__item comparison-list__item--pro">Fee-Based Fiduciary</li>
            <li class="comparison-list__item comparison-list__item--pro">Free 3-Hour FERS Workshop</li>
            <li class="comparison-list__item comparison-list__item--pro">22-Page Personalized Benefits Report</li>
            <li class="comparison-list__item comparison-list__item--pro">NASA & Army Civilian Experience</li>
          </ul>
        </div>
        <div class="comparison-card">
          <h3>Many Huntsville Advisors</h3>
          <ul class="comparison-list">
            <li class="comparison-list__item comparison-list__item--con">General financial credentials typical</li>
            <li class="comparison-list__item comparison-list__item--con">Limited FERS understanding</li>
            <li class="comparison-list__item comparison-list__item--con">Often commission-compensated</li>
            <li class="comparison-list__item comparison-list__item--con">No federal-specific workshops</li>
            <li class="comparison-list__item comparison-list__item--con">Generic retirement projections</li>
            <li class="comparison-list__item comparison-list__item--con">Limited GS engineer experience</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQSchema questions={faqs} heading="Huntsville Federal Retirement FAQs" />

  <WebinarCTA
    variant="banner"
    heading="Ready to plan your federal retirement?"
    subheading="Join Huntsville federal employees who have taken control of their retirement with expert guidance."
  />
</BaseLayout>

<style>
  .location-hero { padding: var(--space-16) 0; background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%); color: var(--color-white); }
  .location-hero h1 { color: var(--color-white); margin-bottom: var(--space-4); }
  .location-hero .lead { color: var(--color-gray-300); margin-bottom: var(--space-8); }
  .location-hero__cta { display: flex; gap: var(--space-4); flex-wrap: wrap; }

  .service-areas { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .service-area { background: var(--color-white); padding: var(--space-6); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .service-area h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .service-area p { color: var(--color-gray-600); font-size: var(--text-sm); }

  .employers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .employer-card { background: var(--color-gray-100); padding: var(--space-8); border-radius: var(--radius-lg); }
  .employer-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-navy); }
  .employer-card ul { list-style: none; padding: 0; }
  .employer-card li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-gray-200); color: var(--color-gray-700); }
  .employer-card li:last-child { border-bottom: none; }

  .directions-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .direction-card { background: rgba(255, 255, 255, 0.1); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid rgba(255, 255, 255, 0.2); }
  .direction-card h3 { color: var(--color-gold); font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .direction-card p { color: var(--color-gray-300); font-size: var(--text-sm); }

  .comparison-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); max-width: 900px; margin: 0 auto; }
  .comparison-card { background: var(--color-gray-100); padding: var(--space-8); border-radius: var(--radius-lg); }
  .comparison-card--highlight { background: var(--color-navy); color: var(--color-white); }
  .comparison-card--highlight h3 { color: var(--color-gold); }
  .comparison-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-6); text-align: center; }
  .comparison-list { list-style: none; padding: 0; }
  .comparison-list__item { padding: var(--space-3) 0; padding-left: var(--space-8); position: relative; font-size: var(--text-sm); }
  .comparison-list__item::before { position: absolute; left: 0; font-size: var(--text-lg); }
  .comparison-list__item--pro::before { content: "\2713"; color: var(--color-gold); }
  .comparison-list__item--con::before { content: "\2717"; color: var(--color-error); }

  @media (max-width: 1024px) { .service-areas { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) {
    .service-areas, .employers-grid, .directions-grid, .comparison-grid { grid-template-columns: 1fr; }
  }
</style>
