---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WebinarCTA from '../../components/WebinarCTA.astro';
import FAQSchema from '../../components/FAQSchema.astro';

const faqs = [
  {
    q: 'Do Joint Base Charleston civilian employees qualify for FERS retirement?',
    a: 'Yes. Civilian employees at Joint Base Charleston are covered by FERS. JB Charleston combines the former Charleston AFB and Naval Weapons Station Charleston, employing thousands of civilians in aircraft maintenance, logistics, contracting, weapons storage support, and base administration. Military-to-civilian transition is common here, and prior active-duty service can count toward your FERS creditable service after a military service deposit to OPM.',
  },
  {
    q: 'How does South Carolina income tax affect FERS retirement for Charleston federal employees?',
    a: 'South Carolina taxes retirement income but offers meaningful deductions. SC allows retirees aged 65 and older to deduct $10,000 in retirement income from state taxes, which reduces the burden on your FERS annuity significantly. For federal employees who retire before 65, the standard SC income tax applies to your annuity at rates up to 6.5%. Our advisors walk through the net-after-tax retirement budget for your specific situation and timeline.',
  },
  {
    q: 'What is SPAWAR and how does its civilian workforce retirement work?',
    a: 'SPAWAR, now called Naval Information Warfare Systems Command (NAVWAR) and its Charleston component Naval Information Warfare Center Atlantic (NIWC Atlantic), employs a large civilian technical workforce on Joint Base Charleston. These civilian employees are covered by FERS. NIWC Atlantic technical roles often carry higher pay grades (GS-12 to GS-14) that produce a strong high-3 and a meaningful FERS annuity after 20 or 25 years of service.',
  },
  {
    q: 'Can I keep FEHB after retiring from a Charleston federal agency?',
    a: 'Yes, with the standard FEHB continuity requirement: you must have been enrolled in FEHB for the 5 consecutive years immediately before your retirement date. Charleston-area health insurance costs have risen sharply in recent years, and maintaining FEHB in retirement typically saves $8,000 to $12,000 annually compared to the Affordable Care Act marketplace for a 60-year-old retiree.',
  },
  {
    q: 'Are there virtual FERS retirement workshops for Charleston area federal employees?',
    a: 'Yes. PlanWell runs free 3-hour virtual FERS workshops that JB Charleston civilians, NIWC Atlantic staff, VA employees, and Charleston-area federal workers attend via Zoom. Whether you are in Goose Creek, Hanahan, Mount Pleasant, or Summerville, there is no commute. Evening and weekend sessions accommodate shift schedules and family obligations.',
  },
];
---

<BaseLayout
  title="Federal Retirement Planning in Charleston, South Carolina"
  description="Expert FERS retirement planning for federal employees in Charleston SC. Serving Joint Base Charleston, NIWC Atlantic, VA, and Charleston area federal agencies. Free workshop available."
  canonical="/locations/charleston"
>
  <!-- Hero Section -->
  <section class="location-hero">
    <div class="container">
      <div class="location-hero__content-centered">
        <span class="eyebrow">Charleston, South Carolina</span>
        <h1 class="heading-xl">Federal Retirement Planning in Charleston</h1>
        <p class="lead">
          Charleston's federal workforce is anchored by Joint Base Charleston, one of the Southeast's largest joint military installations, and NIWC Atlantic, a premier naval information warfare research center. The Lowcountry's growing federal civilian workforce deserves retirement planning that accounts for the specific agencies, pay grades, and service histories that define a career here.
        </p>
        <div class="location-hero__cta">
          <a href="/federal-retirement-webinars" class="btn btn--primary btn--lg">Free FERS Workshop</a>
          <a href="/book-call" class="btn btn--white btn--lg">Schedule Consultation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Section -->
  <section class="section section--gray">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Service Areas in the Charleston Region</h2>
      <div class="service-areas">
        <div class="service-area">
          <h3>Charleston Proper</h3>
          <p>Downtown Charleston, West Ashley, James Island, Johns Island</p>
        </div>
        <div class="service-area">
          <h3>North Charleston &amp; Joint Base</h3>
          <p>North Charleston, Goose Creek, Hanahan, Ladson</p>
        </div>
        <div class="service-area">
          <h3>Mount Pleasant &amp; East Cooper</h3>
          <p>Mount Pleasant, Sullivan's Island, Isle of Palms, Awendaw</p>
        </div>
        <div class="service-area">
          <h3>Summerville &amp; Dorchester County</h3>
          <p>Summerville, Ladson, Ridgeville, Harleyville</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Major Employers Section -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Major Federal Employers We Serve</h2>
      <div class="employers-grid">
        <div class="employer-card">
          <h3>Defense &amp; Naval</h3>
          <ul>
            <li>Joint Base Charleston civilian workforce (Air Base and Weapons Station)</li>
            <li>NIWC Atlantic (Naval Information Warfare Center)</li>
            <li>Naval Consolidated Brig Charleston</li>
            <li>Defense Finance and Accounting Service Charleston</li>
            <li>Army Corps of Engineers Charleston District</li>
          </ul>
        </div>
        <div class="employer-card">
          <h3>Veterans &amp; Health</h3>
          <ul>
            <li>Ralph H. Johnson VA Medical Center</li>
            <li>VA Outpatient Clinics Charleston area</li>
            <li>MUSC federal research and contract employees</li>
            <li>HHS Region 4 Charleston offices</li>
            <li>Social Security Administration Charleston</li>
          </ul>
        </div>
        <div class="employer-card">
          <h3>Coast Guard &amp; Enforcement</h3>
          <ul>
            <li>USCG Sector Charleston</li>
            <li>USCG Station Charleston</li>
            <li>FBI Columbia Field Office (Charleston area)</li>
            <li>U.S. District Court District of South Carolina</li>
            <li>CBP Charleston Field Operations</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <WebinarCTA variant="section" audienceLabel="Charleston Federal Employees" />

  <!-- Directions Section -->
  <section class="section section--navy">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Serving Charleston Federal Workers Virtually</h2>
      <p class="text-center lead mb-8" style="color: var(--color-gray-300);">
        Whether you commute I-26 to the Air Base side of JB Charleston, drive Ashley Phosphate Road to the Weapons Station, or cross the Ravenel Bridge to downtown agencies, our virtual workshops skip every mile of that drive.
      </p>
      <div class="directions-grid">
        <div class="direction-card">
          <h3>From JB Charleston Air Base</h3>
          <p>The Air Base side of JB Charleston is in North Charleston off I-526 and Aviation Avenue. Civilian employees supporting airlift operations, logistics, and base administration join our free virtual workshops from on-base or from their Hanahan and Goose Creek homes.</p>
        </div>
        <div class="direction-card">
          <h3>From NIWC Atlantic at the Weapons Station</h3>
          <p>NIWC Atlantic sits on the Weapons Station side of JB Charleston near Red Bank Road in Goose Creek. Engineers, scientists, and program managers join our Zoom workshops from the campus or from their Summerville and Mount Pleasant homes.</p>
        </div>
        <div class="direction-card">
          <h3>From the VA and Downtown Agencies</h3>
          <p>The Ralph H. Johnson VA is on Bee Street in downtown Charleston. Coast Guard Sector Charleston is on the waterfront. Federal employees throughout the peninsula join our evening sessions without navigating Charleston's narrow downtown streets after hours.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="section">
    <div class="container">
      <h2 class="heading-lg text-center mb-8">Why Charleston Federal Employees Choose PlanWell</h2>
      <div class="comparison-grid">
        <div class="comparison-card comparison-card--highlight">
          <h3>PlanWell Financial Planning</h3>
          <ul class="comparison-list">
            <li class="comparison-list__item comparison-list__item--pro">Certified Financial Planners (CFP®)</li>
            <li class="comparison-list__item comparison-list__item--pro">ChFEBC℠ Federal Benefits Specialists</li>
            <li class="comparison-list__item comparison-list__item--pro">Fee-Based Fiduciary</li>
            <li class="comparison-list__item comparison-list__item--pro">Free 3-Hour FERS Workshop</li>
            <li class="comparison-list__item comparison-list__item--pro">Joint Base Civilian and Naval IT Experience</li>
            <li class="comparison-list__item comparison-list__item--pro">Eastern Time Zone Availability</li>
          </ul>
        </div>
        <div class="comparison-card">
          <h3>Many Charleston Advisors</h3>
          <ul class="comparison-list">
            <li class="comparison-list__item comparison-list__item--con">General financial credentials typical</li>
            <li class="comparison-list__item comparison-list__item--con">Limited FERS pension knowledge</li>
            <li class="comparison-list__item comparison-list__item--con">Commission-based product sales</li>
            <li class="comparison-list__item comparison-list__item--con">No federal-specific workshops</li>
            <li class="comparison-list__item comparison-list__item--con">Unfamiliar with military deposit rules</li>
            <li class="comparison-list__item comparison-list__item--con">No experience with FERS supplement timing</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQSchema questions={faqs} heading="Charleston Federal Retirement FAQs" />

  <WebinarCTA
    variant="banner"
    heading="Ready to Plan Your Federal Retirement in Charleston?"
    subheading="Join JB Charleston civilians, NIWC Atlantic engineers, VA employees, and Coast Guard staff across the Lowcountry who have built their retirement plan with a CFP who knows FERS from the inside out."
  />
</BaseLayout>

<style>
  .location-hero { padding: var(--space-16) 0; background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%); color: var(--color-white); }
  .location-hero__content-centered { max-width: 780px; margin: 0 auto; text-align: center; }
  .location-hero h1 { color: var(--color-white); margin-bottom: var(--space-4); }
  .location-hero .lead { color: var(--color-gray-300); margin-bottom: var(--space-8); }
  .location-hero__cta { display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; }

  .service-areas { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .service-area { background: var(--color-white); padding: var(--space-6); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .service-area h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .service-area p { color: var(--color-gray-600); font-size: var(--text-sm); }

  .employers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .employer-card { background: var(--color-gray-100); padding: var(--space-8); border-radius: var(--radius-lg); }
  .employer-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-navy); }
  .employer-card ul { list-style: none; padding: 0; }
  .employer-card li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-gray-200); color: var(--color-gray-700); }
  .employer-card li:last-child { border-bottom: none; }

  .directions-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .direction-card { background: rgba(255, 255, 255, 0.1); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid rgba(255, 255, 255, 0.2); }
  .direction-card h3 { color: var(--color-gold); font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .direction-card p { color: var(--color-gray-300); font-size: var(--text-sm); }

  .comparison-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); max-width: 900px; margin: 0 auto; }
  .comparison-card { background: var(--color-gray-100); padding: var(--space-8); border-radius: var(--radius-lg); }
  .comparison-card--highlight { background: var(--color-navy); color: var(--color-white); }
  .comparison-card--highlight h3 { color: var(--color-gold); }
  .comparison-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-6); text-align: center; }
  .comparison-list { list-style: none; padding: 0; }
  .comparison-list__item { padding: var(--space-3) 0; padding-left: var(--space-8); position: relative; font-size: var(--text-sm); }
  .comparison-list__item::before { position: absolute; left: 0; font-size: var(--text-lg); }
  .comparison-list__item--pro::before { content: "✓"; color: var(--color-gold); }
  .comparison-list__item--con::before { content: "✗"; color: var(--color-error); }

  @media (max-width: 1024px) { .service-areas { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .service-areas, .employers-grid, .directions-grid, .comparison-grid { grid-template-columns: 1fr; } }
</style>
