---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import brennanPhoto from '../assets/images/brennan-rhule.png';
import davidPhoto from '../assets/images/david-fei.jpg';
---

<BaseLayout 
  title="About PlanWell - CFP® & ChFEBC℠ Federal Benefits Specialists"
  description="Meet David Fei and Brennan Rhule, CFP® and ChFEBC℠ advisors specializing exclusively in federal employee retirement planning. 35+ years combined experience."
>
  <!-- Person Schema for Founders -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["Person", "FinancialPlanner"],
        "@id": "https://planwellfp.com/about#david-fei",
        "name": "David Fei",
        "jobTitle": "Co-Founder & Financial Planner",
        "worksFor": { "@id": "https://planwellfp.com/#organization" },
        "url": "https://planwellfp.com/about",
        "telephone": "301-388-5489",
        "email": "david.fei@planwellfp.com",
        "hasCredential": [
          { "@type": "EducationalOccupationalCredential", "credentialCategory": "Professional Certification", "name": "Certified Financial Planner (CFP\u00AE)" },
          { "@type": "EducationalOccupationalCredential", "credentialCategory": "Professional Certification", "name": "Chartered Federal Employee Benefits Consultant (ChFEBC\u2120)" },
          { "@type": "EducationalOccupationalCredential", "credentialCategory": "Professional Certification", "name": "Accredited Investment Fiduciary (AIF\u00AE)" }
        ],
        "knowsAbout": ["FERS Retirement", "TSP Investing", "Federal Employee Benefits", "Financial Planning"],
        "sameAs": [
          "https://www.linkedin.com/in/david-fei-cfp"
        ]
      },
      {
        "@type": ["Person", "FinancialPlanner"],
        "@id": "https://planwellfp.com/about#brennan-rhule",
        "name": "Brennan Rhule",
        "jobTitle": "Co-Founder & Financial Planner",
        "worksFor": { "@id": "https://planwellfp.com/#organization" },
        "url": "https://planwellfp.com/about",
        "telephone": "571-543-2783",
        "email": "brennan.rhule@planwellfp.com",
        "hasCredential": [
          { "@type": "EducationalOccupationalCredential", "credentialCategory": "Professional Certification", "name": "Certified Financial Planner (CFP\u00AE)" },
          { "@type": "EducationalOccupationalCredential", "credentialCategory": "Professional Certification", "name": "Chartered Federal Employee Benefits Consultant (ChFEBC\u2120)" },
          { "@type": "EducationalOccupationalCredential", "credentialCategory": "Professional Certification", "name": "Accredited Investment Fiduciary (AIF\u00AE)" }
        ],
        "knowsAbout": ["FERS Retirement", "TSP Investing", "Federal Employee Benefits", "Financial Planning"],
        "sameAs": [
          "https://www.linkedin.com/in/brennan-rhule"
        ]
      }
    ]
  })} />

  <!-- AI-Optimized Entity Section -->
  <section class="entity-section" aria-label="About PlanWell Financial Planning">
    <div class="container">
      <div class="entity-content">
        <p>
          <strong>PlanWell Financial Planning</strong> is a fee-based financial advisory firm that specializes exclusively
          in retirement planning for federal employees. Founded by David Fei, CFP&#174;, ChFEBC&#8480;, AIF&#174; and
          Brennan Rhule, CFP&#174;, ChFEBC&#8480;, AIF&#174;, PlanWell serves federal employees nationwide with expert
          guidance on FERS pension optimization, TSP investment strategies, FEHB and Medicare coordination, survivor
          benefits analysis, and comprehensive tax planning. Both founders hold three of the industry's most rigorous
          certifications&mdash;a combination held by fewer than 1% of financial advisors in the United States. PlanWell
          has educated over 10,000 federal employees through free retirement workshops and provides personalized
          22-page Federal Benefits Reports with precise pension calculations and optimization recommendations.
        </p>
      </div>
    </div>
  </section>

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About PlanWell</span>
      <h1 class="heading-xl">Retirement Planning Built for Federal Employees</h1>
      <p class="lead max-w-3xl">
        Federal employees deserve a financial planner who actually understands FERS, TSP,
        and the complex rules that are involved with your retirement.
      </p>
    </div>
  </section>

  <!-- Video Section -->
  <section class="section video-section">
    <div class="container">
      <div class="video-wrapper" data-animate="fade-in-up">
        <video controls preload="metadata">
          <source src="/videos/planwell-intro.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
      <p class="video-caption">See how we help federal employees retire with confidence</p>
    </div>
  </section>

  <!-- Meet the Team -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header" data-animate="fade-in-up">
        <span class="eyebrow">Leadership Team</span>
        <h2 class="heading-lg">Meet the Leadership Team</h2>
        <p class="lead max-w-3xl mx-auto">
          When you work with PlanWell, you work directly with the financial planner you started a relationship with.
        </p>
      </div>
      
      <div class="team-detail-grid">
        <!-- David -->
        <div class="team-detail" data-animate="fade-in-up">
          <div class="team-detail__image">
            <Image 
              src={davidPhoto} 
              alt="David Fei"
              width={400}
              height={400}
              loading="lazy"
              format="webp"
              quality={90}
            />
          </div>
          <div class="team-detail__content">
            <h3>David Fei</h3>
            <p class="team-detail__title">Co-Founder & Financial Planner</p>
            
            <div class="team-detail__credentials">
              <span class="badge badge--gold">CFP®</span>
              <span class="badge badge--gold">ChFEBC℠</span>
              <span class="badge badge--gold">AIF®</span>
            </div>
            
            <p>
              David has been in the financial services industry for over 20 years, 
              bringing a wide range of experience in personal finance to every client relationship. 
              He specializes in helping federal families tackle life's biggest financial 
              challenges—retirement income planning, educational funding, and investment strategy.
            </p>
            <p>
              David's approach is grounded in education. He believes that when clients 
              truly understand their options, they make better decisions. That's why he 
              takes the time to explain the "why" behind every recommendation.
            </p>
            <p class="team-detail__personal">
              <strong>Outside the office:</strong> David stays busy with his daughters' activities, 
              plays basketball on weekends, and hits the mountain bike trails whenever he can.
            </p>
            
            <div class="team-detail__contact">
              <a href="tel:301-388-5489" class="btn btn--secondary">
                301-388-5489
              </a>
              <a href="mailto:david.fei@planwellfp.com" class="btn btn--secondary">
                david.fei@planwellfp.com
              </a>
            </div>
          </div>
        </div>
        
        <!-- Brennan -->
        <div class="team-detail" data-animate="fade-in-up">
          <div class="team-detail__image">
            <Image 
              src={brennanPhoto} 
              alt="Brennan Rhule"
              width={400}
              height={400}
              loading="lazy"
              format="webp"
              quality={90}
            />
          </div>
          <div class="team-detail__content">
            <h3>Brennan Rhule</h3>
            <p class="team-detail__title">Co-Founder & Financial Planner</p>
            
            <div class="team-detail__credentials">
              <span class="badge badge--gold">CFP®</span>
              <span class="badge badge--gold">ChFEBC℠</span>
              <span class="badge badge--gold">AIF®</span>
            </div>
            
            <p>
              Brennan graduated from Virginia Tech's CFP Board-Registered program and
              specializes in helping federal employees navigate their benefits, retirement
              planning, and investment decisions with personalized, fiduciary guidance.
            </p>
            
            <div class="team-detail__contact">
              <a href="tel:571-543-2783" class="btn btn--secondary">
                571-543-2783
              </a>
              <a href="mailto:brennan.rhule@planwellfp.com" class="btn btn--secondary">
                brennan.rhule@planwellfp.com
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="section">
    <div class="container">
      <div class="story-grid">
        <div class="story-content" data-animate="fade-in-up">
          <span class="eyebrow">Our Story</span>
          <h2 class="heading-lg">Why We Focus Exclusively on Feds</h2>
          <p>
            After years of working with federal employees, we noticed something frustrating: 
            most financial advisors treat FERS like any other retirement plan. They'll invest 
            your money, but when you ask about survivor benefit calculations, the Special 
            Retirement Supplement, or FEHB-Medicare coordination—you get blank stares.
          </p>
          <p>
            That's why we earned our Chartered Federal Employee Benefits Consultant (ChFEBC℠)
            designation. It's continuous specialized training on the exact rules that govern
            your retirement. To maintain the ChFEBC we must take a test and pass so that we
            are always up-to-date on your retirement. Combined with our CFP® credentials, we
            bring both broad financial planning expertise and deep federal benefits knowledge.
          </p>
          <p>
            <strong>The result?</strong> We've helped thousands of federal employees confidently 
            navigate their retirement—from calculating exact pension amounts to optimizing 
            TSP withdrawals to avoiding costly Medicare enrollment mistakes.
          </p>
        </div>
        <div class="story-stats" data-animate="fade-in-up">
          <div class="stat-card">
            <div class="stat-number">35+</div>
            <div class="stat-label">Years Combined Experience</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">1,000s</div>
            <div class="stat-label">Federal Employees Served</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">&lt;1%</div>
            <div class="stat-label">Of Advisors Hold All 3 Designations</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">Fiduciary</div>
            <div class="stat-label">Commitment</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The PlanWell Difference -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-animate="fade-in-up">
        <span class="eyebrow">The PlanWell Difference</span>
        <h2 class="heading-lg">Why Federal Employees Choose Us</h2>
        <div class="difference-intro">
          <p class="lead max-w-3xl mx-auto">
            Your federal benefits are complicated. HR handles paperwork—not personalized advice.
            Most financial advisors lack federal expertise, leading to costly mistakes.
          </p>
          <p class="lead max-w-3xl mx-auto difference-solution">
            <strong>That's why we specialize exclusively in federal employees.</strong>
          </p>
        </div>
      </div>

      <div class="difference-grid">
        <div class="difference-card" data-animate="fade-in-up">
          <div class="difference-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>Federal-Only Focus</h3>
          <p>
            We don't try to be everything to everyone. Our entire practice is built 
            around federal employees and their unique benefits. That specialization means 
            deeper expertise and better outcomes.
          </p>
        </div>
        
        <div class="difference-card" data-animate="fade-in-up">
          <div class="difference-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Fiduciary Standard</h3>
          <p>
            We put your goals and interests at the forefront. Prioritizing your needs first,
            avoiding conflicts of interest, and fully disclosing any unavoidable conflicts.
          </p>
        </div>
        
        <div class="difference-card" data-animate="fade-in-up">
          <div class="difference-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
          </div>
          <h3>Comprehensive Analysis</h3>
          <p>
            Our 22-page Benefits Report goes far beyond HR's estimate. We calculate 
            precise pension amounts, analyze survivor benefit options, project TSP growth, 
            and identify optimization opportunities.
          </p>
        </div>
        
        <div class="difference-card" data-animate="fade-in-up">
          <div class="difference-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Long-Term Partnership</h3>
          <p>
            We're not here for a one-time transaction. You'll have ongoing access
            to your advisor for questions, annual reviews, and strategy adjustments
            throughout your retirement.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Our Process -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header" data-animate="fade-in-up">
        <span class="eyebrow">How It Works</span>
        <h2 class="heading-lg">Our Process</h2>
        <p class="lead max-w-3xl mx-auto">
          A clear path from uncertainty to confidence in your federal retirement.
        </p>
      </div>

      <div class="process-grid">
        <div class="process-step" data-animate="fade-in-up">
          <div class="process-step__number">1</div>
          <h3>Attend Our Free Workshop</h3>
          <p>
            Our 3-hour virtual workshop covers everything you need to understand your
            federal retirement: FERS pension, TSP strategies, FEHB, Medicare coordination,
            Social Security, and survivor benefits.
          </p>
        </div>

        <div class="process-step" data-animate="fade-in-up">
          <div class="process-step__number">2</div>
          <h3>Get Your Personalized Report</h3>
          <p>
            We create a comprehensive 22-page analysis tailored to your specific situation—
            with precise pension calculations, TSP projections, and a prioritized action plan.
          </p>
        </div>

        <div class="process-step" data-animate="fade-in-up">
          <div class="process-step__number">3</div>
          <h3>Retire With Confidence</h3>
          <p>
            We're your ongoing partner through retirement and beyond—adjusting your plan
            as life changes, laws evolve, and new opportunities arise.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--navy text-center">
    <div class="container">
      <div data-animate="fade-in-up">
        <h2 class="heading-lg">Ready to Work with Real Fed-Experts?</h2>
        <p class="lead" style="color: var(--color-gray-300); max-width: 36rem; margin: 0 auto var(--space-8);">
          Start with our free FERS workshop or schedule a personal consultation.
        </p>
        <div class="flex justify-center gap-4" style="flex-wrap: wrap;">
          <a href="/webinars" class="btn btn--primary btn--lg">Free FERS Workshop</a>
          <a href="/book-call" class="btn btn--white btn--lg">Schedule a Call</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Video Section */
  .video-section {
    background: var(--color-white);
    padding: var(--space-12) 0;
  }

  .video-wrapper {
    max-width: 800px;
    margin: 0 auto;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    background: var(--color-navy-dark);
  }

  .video-wrapper video {
    width: 100%;
    height: auto;
    display: block;
  }

  .video-caption {
    text-align: center;
    margin-top: var(--space-4);
    color: var(--color-gray-600);
    font-size: var(--text-base);
  }

  /* Difference Intro */
  .difference-intro {
    margin-bottom: var(--space-8);
  }

  .difference-intro .lead {
    color: var(--color-gray-600);
  }

  .difference-solution {
    color: var(--color-navy);
    margin-top: var(--space-4);
  }

  /* Process Section */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    max-width: 1000px;
    margin: 0 auto;
  }

  .process-step {
    text-align: center;
    padding: var(--space-6);
  }

  .process-step__number {
    width: 56px;
    height: 56px;
    background: var(--color-gold);
    color: var(--color-navy-dark);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin: 0 auto var(--space-4);
    font-family: var(--font-heading);
  }

  .process-step h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
    color: var(--color-navy);
  }

  .process-step p {
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  .page-hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
  }
  
  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }
  
  .page-hero .lead {
    color: var(--color-gray-300);
    margin: 0 auto;
  }
  
  .story-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }
  
  .story-content p {
    margin-bottom: var(--space-4);
    color: var(--color-gray-700);
  }
  
  .story-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  
  .stat-card {
    background: var(--color-white);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    text-align: center;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-gray-200);
  }
  
  .stat-number {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
  }
  
  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    margin-top: var(--space-1);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  
  .team-detail-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .team-detail {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: var(--space-10);
    background: var(--color-white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  
  .team-detail:nth-child(even) {
    direction: rtl;
  }
  
  .team-detail:nth-child(even) > * {
    direction: ltr;
  }
  
  .team-detail__image {
    padding: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-gray-100) 0%, var(--color-gray-50, #f9fafb) 100%);
  }
  
  .team-detail__image img {
    width: 260px;
    height: 260px;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radius-xl);
    border: 4px solid var(--color-gold);
    box-shadow: var(--shadow-xl);
  }
  
  .team-detail__content {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .team-detail__content h3 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-1);
  }
  
  .team-detail__title {
    color: var(--color-gold);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-3);
  }
  
  .team-detail__credentials {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  
  .team-detail__content p {
    margin-bottom: var(--space-3);
    color: var(--color-gray-700);
  }
  
  .team-detail__personal {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    font-style: italic;
  }
  
  .team-detail__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  
  .difference-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }
  
  .difference-card {
    padding: var(--space-8);
    background: var(--color-gray-100);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-200);
    transition: all var(--transition-base);
  }
  
  .difference-card:hover {
    background: var(--color-white);
    box-shadow: var(--shadow-lg);
  }
  
  .difference-icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-4);
    color: var(--color-gold);
  }
  
  .difference-icon svg {
    width: 100%;
    height: 100%;
  }
  
  .difference-card h3 {
    margin-bottom: var(--space-2);
  }
  
  .difference-card p {
    color: var(--color-gray-600);
  }
  
  @media (max-width: 1024px) {
    .story-grid {
      grid-template-columns: 1fr;
    }

    .team-detail {
      grid-template-columns: 1fr;
    }

    .team-detail:nth-child(even) {
      direction: ltr;
    }

    .team-detail__image {
      aspect-ratio: 16/9;
    }

    .process-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  /* Entity Section - AI-optimized, visually subtle */
  .entity-section {
    background: var(--color-gray-50, #f9fafb);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .entity-content {
    max-width: 800px;
    margin: 0 auto;
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.7;
    text-align: center;
  }

  @media (max-width: 640px) {
    .story-stats {
      grid-template-columns: 1fr;
    }

    .difference-grid {
      grid-template-columns: 1fr;
    }

    .video-wrapper {
      border-radius: var(--radius-lg);
    }
  }
</style>
