---
import {
  getNextFEHBWebinar,
  formatFEHBWebinarDate,
  formatFEHBWebinarDateTime,
  getDaysUntilFEHB,
} from '../data/fehb-webinars';

// Render per-request, exactly as webinar.astro and webinar/li.astro do. If this
// were prerendered, Astro would compute "the next webinar" once at deploy time
// and the page would silently go stale the moment that date passed.
export const prerender = false;

const next = getNextFEHBWebinar();
const hasSession = next !== null;
const dateShort = next ? formatFEHBWebinarDate(next) : '';
const dateFull = next ? formatFEHBWebinarDateTime(next) : '';
const daysUntil = next ? getDaysUntilFEHB(next) : 0;

const pageTitle = hasSession
  ? `FEHB Open Season Webinar — ${dateShort} | Free for Federal Employees | PlanWell`
  : 'FEHB Open Season Webinar for Federal Employees | PlanWell';
const pageDesc = hasSession
  ? `Free FEHB Open Season webinar on ${dateShort}. Compare FEHB plans for the new plan year, understand Medicare coordination, and see what is changing. Hosted by Brennan Rhule, CFP®, ChFEBC℠.`
  : 'FEHB Open Season guidance for federal employees and retirees — plan comparison, Medicare coordination, and what changes each plan year.';
const canonical = 'https://planwellfp.com/fehb-open-season-webinar';

// Schema.org Event markup. This is the part that earns the search placement
// Brennan is relying on, so it is emitted ONLY when a real dated session exists —
// a schema Event with no date is worse than none.
const eventSchema = next
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: next.title,
      description: pageDesc,
      startDate: next.date.toISOString(),
      eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      location: {
        '@type': 'VirtualLocation',
        url: next.zoomLink,
      },
      image: 'https://planwellfp.com/favicon.svg',
      organizer: {
        '@type': 'Organization',
        name: 'PlanWell Financial Planning',
        url: 'https://planwellfp.com',
      },
      performer: { '@type': 'Person', name: next.host },
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        url: next.zoomLink,
        validFrom: new Date().toISOString(),
      },
    }
  : null;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'When is FEHB Open Season?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'FEHB Open Season runs from the second Monday in November through the second Monday in December each year. Changes you make take effect the following January.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I have to do anything during Open Season?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'If you take no action your current FEHB enrollment normally continues automatically. That is convenient but not always cheapest — premiums and plan designs change every year, so a plan that was right last year may not be this year.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does FEHB work with Medicare when I retire?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can keep FEHB in retirement and coordinate it with Medicare. Whether to enroll in Medicare Part B alongside FEHB is one of the most consequential and least reversible decisions federal retirees make, and it depends on your specific plan.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this webinar free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The session is free to attend and educational — there is no cost and no obligation.',
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:site_name" content="PlanWell Financial Planning" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <style>
    :root { --navy:#0f2942; --blue:#1a5f9e; --accent:#c9a227; --ink:#1c2b3a; --muted:#5a6b7c; --line:#e4e9ef; --bg:#f7f9fb; }
    *{box-sizing:border-box}
    body{margin:0;font-family:Inter,system-ui,sans-serif;color:var(--ink);background:#fff;line-height:1.65}
    .wrap{max-width:820px;margin:0 auto;padding:0 22px}
    header.hero{background:linear-gradient(160deg,var(--navy),#163b5c);color:#fff;padding:56px 0 48px}
    header.hero h1{font-family:Outfit,sans-serif;font-size:clamp(1.9rem,4.4vw,2.9rem);line-height:1.18;margin:0 0 14px;font-weight:800}
    .eyebrow{display:inline-block;background:rgba(201,162,39,.16);color:var(--accent);font-weight:700;font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;padding:6px 13px;border-radius:999px;margin-bottom:18px}
    .when{font-size:1.14rem;font-weight:600;margin:0 0 6px}
    .sub{color:#c3d3e2;margin:0 0 26px;max-width:60ch}
    .cta{display:inline-block;background:var(--accent);color:#20180a;font-weight:800;font-size:1.03rem;padding:15px 34px;border-radius:9px;text-decoration:none}
    .cta:hover{filter:brightness(1.07)}
    .note{font-size:.87rem;color:#9fb4c6;margin-top:13px}
    section{padding:44px 0;border-bottom:1px solid var(--line)}
    h2{font-family:Outfit,sans-serif;font-size:1.5rem;margin:0 0 16px;color:var(--navy)}
    h3{font-size:1.06rem;margin:24px 0 7px;color:var(--navy)}
    ul{padding-left:20px} li{margin:9px 0}
    .card{background:var(--bg);border:1px solid var(--line);border-radius:11px;padding:22px 24px;margin:20px 0}
    .foot{padding:34px 0 54px;font-size:.84rem;color:var(--muted)}
    .pending{background:#fff8e6;border:1px solid #e8d9a8;border-radius:11px;padding:22px 24px}
    a{color:var(--blue)}
  </style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <span class="eyebrow">Free Webinar · Federal Employees &amp; Retirees</span>
    <h1>FEHB Open Season: choosing your health plan for the new plan year</h1>

    {hasSession ? (
      <>
        <p class="when">{dateFull}</p>
        <p class="sub">
          A working session on how to actually compare FEHB plans — what changed for this plan year,
          how FEHB coordinates with Medicare, and how to tell whether staying put is costing you money.
          Hosted by {next!.host}.
        </p>
        <a class="cta" href={next!.zoomLink} rel="noopener">Register free on Zoom</a>
        <p class="note">
          No cost, no sales pitch. {daysUntil > 0 ? `${daysUntil} days away — ` : ''}
          registration confirms instantly and Zoom emails you the join link.
        </p>
      </>
    ) : (
      <>
        <p class="sub">
          Our next FEHB Open Season session is not scheduled yet. The guidance below applies every
          Open Season — check back, or reach out and we will let you know when the next date is set.
        </p>
        <a class="cta" href="/contact">Ask us about the next session</a>
      </>
    )}
  </div>
</header>

<div class="wrap">

  {!hasSession && (
    <section>
      <div class="pending">
        <strong>No session is currently on the calendar.</strong> We deliberately do not show a
        registration button without a confirmed date and time — if you landed here expecting one,
        <a href="/contact">contact us</a> and we will tell you when the next Open Season session is set.
      </div>
    </section>
  )}

  <section>
    <h2>What this session covers</h2>
    <ul>
      <li><strong>What changed this year.</strong> FEHB premiums and plan designs change annually. We walk through what moved and who it affects.</li>
      <li><strong>How to compare plans properly.</strong> Premium is the number everyone looks at and rarely the number that decides it — deductibles, catastrophic limits, and how your specific care is covered usually matter more.</li>
      <li><strong>FEHB and Medicare together.</strong> Whether to take Part B alongside FEHB, what it costs, and why the decision is difficult to unwind later.</li>
      <li><strong>Self, Self+1, and Self &amp; Family.</strong> When the middle tier is the cheaper answer and when it quietly is not.</li>
      <li><strong>Live Q&amp;A.</strong> Bring your own situation — most of the value tends to land here.</li>
    </ul>
  </section>

  <section>
    <h2>When is FEHB Open Season?</h2>
    <p>
      FEHB Open Season runs from the <strong>second Monday in November through the second Monday in
      December</strong> each year. Elections you make during Open Season take effect the following January.
    </p>
    <div class="card">
      <h3>If you do nothing</h3>
      <p style="margin:0">
        Your current enrollment normally rolls over automatically. That is the convenient option, and it
        is the reason a lot of federal families quietly overpay: the plan that fit you two years ago may
        have changed its premium, its network, or its catastrophic limit since.
      </p>
    </div>
  </section>

  <section>
    <h2>Who this is for</h2>
    <ul>
      <li>Federal employees choosing coverage for the coming plan year</li>
      <li>Federal retirees carrying FEHB into retirement</li>
      <li>Anyone approaching 65 and weighing FEHB alongside Medicare</li>
      <li>Anyone who has kept the same plan for years without re-checking it</li>
    </ul>
  </section>

  {hasSession && (
    <section style="text-align:center">
      <h2>Save your seat</h2>
      <p style="color:var(--muted);margin-bottom:22px">{dateFull} · free to attend</p>
      <a class="cta" href={next!.zoomLink} rel="noopener">Register free on Zoom</a>
    </section>
  )}

  <div class="foot">
    <p>
      PlanWell Financial Planning · Educational content for federal employees and retirees.
      This webinar is educational and is not individualized investment, tax, or legal advice.
    </p>
    <p>
      Securities and investment advisory services offered through Osaic Wealth, Inc. member
      <a href="https://www.finra.org/" rel="noopener">FINRA</a>/<a href="https://www.sipc.org/" rel="noopener">SIPC</a>.
      Osaic Wealth is separately owned and other entities and/or marketing names, products or services
      referenced here are independent of Osaic Wealth.
    </p>
  </div>
</div>

</body>
</html>
