---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Federal Employee Success Stories - PlanWell Case Studies"
  description="See how PlanWell has helped federal employees optimize their FERS retirement, TSP, and benefits. Real results from real federal employees."
>
  <!-- Hero -->
  <section class="service-hero">
    <div class="container">
      <span class="eyebrow">Client Success Stories</span>
      <h1 class="heading-xl">How We've Helped Federal Employees Retire with Confidence</h1>
      <p class="lead max-w-3xl">
        Every federal employee's situation is unique. See how PlanWell's personalized
        approach has helped real federal employees optimize their benefits, reduce taxes,
        and retire on their terms.
      </p>
    </div>
  </section>

  <!-- Case Study Cards -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-animate="fade-in-up">
        <span class="eyebrow">Real Results</span>
        <h2 class="heading-lg">Featured Case Studies</h2>
        <p class="lead max-w-3xl mx-auto">
          These stories represent the kinds of outcomes our clients achieve
          when they take control of their federal retirement planning.
        </p>
      </div>

      <div class="case-studies-grid">
        <a href="/case-studies/early-retirement-optimization" class="case-study-card" data-animate="fade-in-up">
          <div class="case-study-card__tag">Early Retirement</div>
          <h3 class="case-study-card__title">GS-14 Retires 3 Years Early with Full Benefits</h3>
          <p class="case-study-card__profile">GS-14, 28 years of service, DoD</p>
          <p class="case-study-card__outcome">
            Discovered unused sick leave credits and optimized TSP withdrawal
            sequencing to retire at 57 instead of 60 without sacrificing income.
          </p>
          <div class="case-study-card__metrics">
            <div class="metric">
              <span class="metric__value">3 Years</span>
              <span class="metric__label">Earlier Retirement</span>
            </div>
            <div class="metric">
              <span class="metric__value">$47K</span>
              <span class="metric__label">Tax Savings</span>
            </div>
          </div>
          <span class="case-study-card__link">Read Full Story &rarr;</span>
        </a>

        <div class="case-study-card case-study-card--placeholder" data-animate="fade-in-up">
          <div class="case-study-card__tag">Tax Optimization</div>
          <h3 class="case-study-card__title">[PLACEHOLDER] Couple Saves $85K in Lifetime Taxes</h3>
          <p class="case-study-card__profile">[PLACEHOLDER] GS-13 &amp; GS-12, dual federal household</p>
          <p class="case-study-card__outcome">
            [PLACEHOLDER] Strategic Roth conversions and coordinated withdrawal
            planning reduced their combined tax burden by over $85,000 across
            the first decade of retirement.
          </p>
          <div class="case-study-card__metrics">
            <div class="metric">
              <span class="metric__value">[PLACEHOLDER]</span>
              <span class="metric__label">Tax Savings</span>
            </div>
            <div class="metric">
              <span class="metric__value">[PLACEHOLDER]</span>
              <span class="metric__label">Key Metric</span>
            </div>
          </div>
          <span class="case-study-card__link">Coming Soon</span>
        </div>

        <div class="case-study-card case-study-card--placeholder" data-animate="fade-in-up">
          <div class="case-study-card__tag">Benefits Maximization</div>
          <h3 class="case-study-card__title">[PLACEHOLDER] FEHB + Medicare Coordination Saves Thousands</h3>
          <p class="case-study-card__profile">[PLACEHOLDER] GS-15, 32 years of service</p>
          <p class="case-study-card__outcome">
            [PLACEHOLDER] Proper coordination of FEHB and Medicare parts
            eliminated duplicate coverage and reduced annual healthcare costs
            while improving coverage quality.
          </p>
          <div class="case-study-card__metrics">
            <div class="metric">
              <span class="metric__value">[PLACEHOLDER]</span>
              <span class="metric__label">Annual Savings</span>
            </div>
            <div class="metric">
              <span class="metric__value">[PLACEHOLDER]</span>
              <span class="metric__label">Key Metric</span>
            </div>
          </div>
          <span class="case-study-card__link">Coming Soon</span>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header" data-animate="fade-in-up">
        <span class="eyebrow">Our Approach</span>
        <h2 class="heading-lg">Every Success Story Starts the Same Way</h2>
      </div>

      <div class="process-timeline">
        <div class="process-step" data-animate="fade-in-up">
          <div class="process-step__number">1</div>
          <div class="process-step__content">
            <h3>Free Workshop</h3>
            <p>Attend our FERS retirement workshop to understand how your benefits work together. No cost, no obligation.</p>
          </div>
        </div>

        <div class="process-step" data-animate="fade-in-up">
          <div class="process-step__number">2</div>
          <div class="process-step__content">
            <h3>Personalized Benefits Report</h3>
            <p>Get a 22-page analysis of your specific situation, including pension calculations and optimization opportunities.</p>
          </div>
        </div>

        <div class="process-step" data-animate="fade-in-up">
          <div class="process-step__number">3</div>
          <div class="process-step__content">
            <h3>Comprehensive Planning</h3>
            <p>For those who want the full picture, we build a holistic strategy covering benefits, investments, taxes, and insurance.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--gold text-center">
    <div class="container">
      <div data-animate="fade-in-up">
        <h2 class="heading-lg">Ready to Write Your Own Success Story?</h2>
        <p class="lead" style="max-width: 36rem; margin: 0 auto var(--space-8);">
          Join hundreds of federal employees who have taken control of their
          retirement planning with PlanWell.
        </p>
        <div class="cta-buttons">
          <a href="/book-call" class="btn btn--navy btn--lg">Schedule a Discovery Call</a>
          <a href="/webinars" class="btn btn--outline-navy btn--lg">Start with Free Workshop</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero { background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%); color: var(--color-white); padding: var(--space-24) 0 var(--space-16); text-align: center; }
  .service-hero h1 { color: var(--color-white); margin-bottom: var(--space-4); }
  .service-hero .lead { color: var(--color-gray-300); margin: 0 auto var(--space-8); }
  .section-header { text-align: center; margin-bottom: var(--space-12); }

  .case-studies-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }

  .case-study-card { display: flex; flex-direction: column; background: var(--color-white); padding: var(--space-8); border-radius: var(--radius-lg); border: 1px solid var(--color-gray-200); transition: all var(--transition-base); text-decoration: none; color: inherit; }
  .case-study-card:hover { border-color: var(--color-gold); box-shadow: var(--shadow-lg); transform: translateY(-4px); }
  .case-study-card--placeholder { opacity: 0.75; cursor: default; }
  .case-study-card--placeholder:hover { border-color: var(--color-gray-200); box-shadow: none; transform: none; }

  .case-study-card__tag { display: inline-block; align-self: flex-start; background: var(--color-navy); color: var(--color-gold); font-size: var(--text-xs); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: 0.05em; padding: var(--space-1) var(--space-3); border-radius: var(--radius-md); margin-bottom: var(--space-4); }
  .case-study-card__title { font-size: var(--text-lg); margin-bottom: var(--space-2); color: var(--color-navy); }
  .case-study-card__profile { font-size: var(--text-sm); color: var(--color-gold-dark); font-weight: var(--font-medium); margin-bottom: var(--space-3); }
  .case-study-card__outcome { font-size: var(--text-sm); color: var(--color-gray-600); line-height: 1.6; margin-bottom: var(--space-6); flex-grow: 1; }

  .case-study-card__metrics { display: flex; gap: var(--space-6); margin-bottom: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-gray-200); }
  .metric { display: flex; flex-direction: column; }
  .metric__value { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: var(--font-bold); color: var(--color-navy); }
  .metric__label { font-size: var(--text-xs); color: var(--color-gray-500); }

  .case-study-card__link { font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-gold-dark); }
  .case-study-card:hover .case-study-card__link { color: var(--color-navy); }

  .process-timeline { max-width: 700px; margin: 0 auto; }
  .process-step { display: flex; gap: var(--space-6); margin-bottom: var(--space-6); position: relative; }
  .process-step:not(:last-child)::after { content: ''; position: absolute; left: 24px; top: 55px; bottom: -24px; width: 2px; background: var(--color-gray-200); }
  .process-step__number { width: 48px; height: 48px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--color-gold); color: var(--color-navy-dark); font-family: var(--font-heading); font-size: var(--text-xl); font-weight: var(--font-bold); border-radius: var(--radius-full); position: relative; z-index: 1; }
  .process-step__content h3 { margin-bottom: var(--space-1); font-size: var(--text-lg); }
  .process-step__content p { color: var(--color-gray-600); font-size: var(--text-sm); margin-bottom: var(--space-1); }

  .section--gold { background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-dark) 100%); color: var(--color-navy-dark); }
  .section--gold h2 { color: var(--color-navy-dark); }
  .cta-buttons { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
  .btn--navy { background: var(--color-navy); color: var(--color-white); }
  .btn--navy:hover { background: var(--color-navy-dark); }
  .btn--outline-navy { background: transparent; color: var(--color-navy); border: 2px solid var(--color-navy); }
  .btn--outline-navy:hover { background: var(--color-navy); color: var(--color-white); }

  @media (max-width: 1024px) { .case-studies-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .case-studies-grid { grid-template-columns: 1fr; } }
</style>
