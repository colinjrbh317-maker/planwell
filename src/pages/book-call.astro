---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Book a Federal Retirement Planning Call | PlanWell"
  description="Schedule a free discovery call with our CFP® and ChFEBC℠ advisors. Get personalized guidance on your FERS pension, TSP, and federal benefits."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">1-on-1 Consultation</span>
      <h1 class="heading-xl">Schedule Your Free Discovery Call</h1>
      <p class="lead max-w-3xl">
        Pick a time that works for you. You'll speak directly with David or Brennan&mdash;CFP&reg; and ChFEBC&#8480; advisors who specialize exclusively in federal retirement planning.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="calendar-wrapper">
        <div class="calendar-features">
          <div class="feature">
            <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 13l4 4L19 7"/>
            </svg>
            <span>30-minute private consultation</span>
          </div>
          <div class="feature">
            <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 13l4 4L19 7"/>
            </svg>
            <span>Phone or video&mdash;your choice</span>
          </div>
          <div class="feature">
            <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 13l4 4L19 7"/>
            </svg>
            <span>No obligation, no sales pitch</span>
          </div>
        </div>

        <div class="calendar-embed">
          <iframe
            src="https://app.greminders.com/t/a8048453/initialdiscover"
            title="Schedule a discovery call with PlanWell"
            width="100%"
            height="700"
            frameborder="0"
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container text-center">
      <h2 class="heading-md">What to Expect on Your Call</h2>
      <div class="expect-grid">
        <div class="expect-item">
          <div class="expect-number">1</div>
          <h3>We Listen</h3>
          <p>Tell us about your situation, timeline, and biggest retirement questions.</p>
        </div>
        <div class="expect-item">
          <div class="expect-number">2</div>
          <h3>We Assess</h3>
          <p>We'll identify opportunities in your FERS benefits, TSP, and tax situation.</p>
        </div>
        <div class="expect-item">
          <div class="expect-number">3</div>
          <h3>You Decide</h3>
          <p>We'll recommend next steps&mdash;whether that's working with us or resources to explore on your own.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%);
    color: var(--color-white);
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .page-hero .lead {
    color: var(--color-gray-300);
    margin: 0 auto;
  }

  .calendar-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .calendar-features {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-medium);
    color: var(--color-gray-700);
  }

  .feature-icon {
    width: 20px;
    height: 20px;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .calendar-embed {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    padding: var(--space-4);
  }

  .calendar-embed iframe {
    width: 100%;
    min-height: 700px;
    border: none;
    border-radius: var(--radius-lg);
  }

  .expect-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    max-width: 900px;
    margin: var(--space-10) auto 0;
  }

  .expect-item {
    padding: var(--space-6);
  }

  .expect-number {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-light) 100%);
    color: var(--color-navy-dark);
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: var(--text-xl);
    border-radius: 50%;
    margin: 0 auto var(--space-4);
  }

  .expect-item h3 {
    margin-bottom: var(--space-2);
    color: var(--color-navy);
  }

  .expect-item p {
    color: var(--color-gray-600);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .calendar-features {
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
    }

    .calendar-embed iframe {
      min-height: 600px;
    }

    .expect-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
